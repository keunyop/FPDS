{
  "surface": "public_app",
  "access": "anonymous",
  "default_locale": "en",
  "routes": [
    {
      "route": "/",
      "route_id": "public.home",
      "implementation_path": "src/app/page.tsx",
      "resource_key": "public_navigation.home"
    },
    {
      "route": "/products",
      "route_id": "public.products",
      "implementation_path": "src/app/products/page.tsx",
      "resource_key": "public_navigation.products"
    },
    {
      "route": "/products/[productId]",
      "route_id": "public.product_detail",
      "implementation_path": "src/app/products/[productId]/page.tsx",
      "resource_key": "public_navigation.products"
    },
    {
      "route": "/cards",
      "route_id": "public.cards",
      "implementation_path": "src/app/cards/page.tsx",
      "resource_key": "public_navigation.cards"
    },
    {
      "route": "/loans",
      "route_id": "public.loans",
      "implementation_path": "src/app/loans/page.tsx",
      "resource_key": "public_navigation.loans"
    },
    {
      "route": "/dashboard",
      "route_id": "public.dashboard_legacy",
      "implementation_path": "next.config.ts",
      "resource_key": "public_navigation.dashboard",
      "redirect_to": "/",
      "redirect_status": 308
    },
    {
      "route": "/methodology",
      "route_id": "public.methodology",
      "implementation_path": "src/app/methodology/page.tsx",
      "resource_key": "public_navigation.methodology"
    },
    {
      "route": "/robots.txt",
      "route_id": "public.seo.robots",
      "implementation_path": "src/app/robots.ts",
      "resource_key": "public_seo.robots"
    },
    {
      "route": "/sitemap.xml",
      "route_id": "public.seo.sitemap",
      "implementation_path": "src/app/sitemap.ts",
      "resource_key": "public_seo.sitemap"
    },
    {
      "route": "/api/public/countries",
      "route_id": "public.proxy.countries",
      "implementation_path": "src/app/api/public/countries/route.ts",
      "resource_key": "public_country.options"
    }
  ]
}
