# Server-only upstream for Admin reads, mutations and same-origin auth proxy.
# Local development defaults to this origin. Vercel requires an explicit HTTPS origin.
# Production example: https://switchabank-api.vercel.app
# Preview must point to an isolated Preview API; never expose this as NEXT_PUBLIC_*.
# No DB URL, provider key or API session/CSRF secret belongs in the Admin project.
FPDS_ADMIN_API_ORIGIN=http://localhost:4000
