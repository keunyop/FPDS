{
  "surface": "admin_app",
  "auth_mode": "server-session",
  "default_locale": "en",
  "routes": [
    {
      "route": "/",
      "route_id": "admin.package_root_redirect",
      "implementation_path": "src/app/page.tsx",
      "access": "anonymous",
      "behavior": "compatibility_redirect"
    },
    {
      "route": "/admin/login",
      "route_id": "admin.login",
      "implementation_path": "src/app/admin/login/page.tsx",
      "access": "anonymous"
    },
    {
      "route": "/admin/signup",
      "route_id": "admin.signup",
      "implementation_path": "src/app/admin/signup/page.tsx",
      "access": "anonymous"
    },
    {
      "route": "/admin",
      "route_id": "admin.overview",
      "implementation_path": "src/app/admin/page.tsx",
      "access": "authenticated"
    },
    {
      "route": "/admin/reviews",
      "route_id": "admin.reviews",
      "implementation_path": "src/app/admin/reviews/page.tsx",
      "access": "authenticated"
    },
    {
      "route": "/admin/reviews/[reviewTaskId]",
      "route_id": "admin.review_detail",
      "implementation_path": "src/app/admin/reviews/[reviewTaskId]/page.tsx",
      "access": "authenticated"
    },
    {
      "route": "/admin/runs",
      "route_id": "admin.runs",
      "implementation_path": "src/app/admin/runs/page.tsx",
      "access": "authenticated"
    },
    {
      "route": "/admin/runs/[runId]",
      "route_id": "admin.run_detail",
      "implementation_path": "src/app/admin/runs/[runId]/page.tsx",
      "access": "authenticated"
    },
    {
      "route": "/admin/banks",
      "route_id": "admin.banks",
      "implementation_path": "src/app/admin/banks/page.tsx",
      "access": "authenticated"
    },
    {
      "route": "/admin/banks/[bankCode]",
      "route_id": "admin.bank_detail_redirect",
      "implementation_path": "src/app/admin/banks/[bankCode]/page.tsx",
      "access": "authenticated",
      "behavior": "compatibility_redirect"
    },
    {
      "route": "/admin/product-types",
      "route_id": "admin.product_types",
      "implementation_path": "src/app/admin/product-types/page.tsx",
      "access": "authenticated"
    },
    {
      "route": "/admin/countries",
      "route_id": "admin.countries",
      "implementation_path": "src/app/admin/countries/page.tsx",
      "access": "admin"
    },
    {
      "route": "/admin/source-catalog",
      "route_id": "admin.source_catalog_redirect",
      "implementation_path": "src/app/admin/source-catalog/page.tsx",
      "access": "authenticated",
      "behavior": "compatibility_redirect"
    },
    {
      "route": "/admin/source-catalog/[catalogItemId]",
      "route_id": "admin.source_catalog_detail_redirect",
      "implementation_path": "src/app/admin/source-catalog/[catalogItemId]/page.tsx",
      "access": "authenticated",
      "behavior": "compatibility_redirect"
    },
    {
      "route": "/admin/sources",
      "route_id": "admin.sources",
      "implementation_path": "src/app/admin/sources/page.tsx",
      "access": "authenticated"
    },
    {
      "route": "/admin/sources/[sourceId]",
      "route_id": "admin.source_detail",
      "implementation_path": "src/app/admin/sources/[sourceId]/page.tsx",
      "access": "authenticated"
    },
    {
      "route": "/admin/changes",
      "route_id": "admin.changes",
      "implementation_path": "src/app/admin/changes/page.tsx",
      "access": "authenticated"
    },
    {
      "route": "/admin/audit",
      "route_id": "admin.audit",
      "implementation_path": "src/app/admin/audit/page.tsx",
      "access": "authenticated"
    },
    {
      "route": "/admin/usage",
      "route_id": "admin.usage",
      "implementation_path": "src/app/admin/usage/page.tsx",
      "access": "authenticated"
    },
    {
      "route": "/admin/health/dashboard",
      "route_id": "admin.health_dashboard",
      "implementation_path": "src/app/admin/health/dashboard/page.tsx",
      "access": "authenticated"
    }
  ]
}
