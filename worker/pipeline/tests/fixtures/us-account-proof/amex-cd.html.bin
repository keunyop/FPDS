        window.__INITIAL_STATE__ = "[\"~#iM\",[\"config\",[\"~#iM\",[\"consumerCdaasDomain\",\"https://www.aexp-static.com/cdaas/\",\"proxyUrl\",\"\",\"reportingUrl\",\"https://shopuplifthydra.americanexpress.com/_/report/errors\",\"preloadableFonts\",[\"~#iL\",[\"https://www.aexp-static.com/nav/ngn/fonts/342cdec0-7d5d-43a9-84bf-8a77730526ee-3.woff\",\"https://www.aexp-static.com/nav/ngn/fonts/325e6ad0-38fb-4bad-861c-d965eab101d5-3.woff\",\"https://www.aexp-static.com/nav/ngn/fonts/3be50273-0b2e-4aef-ae68-882eacd611f9-3.woff\",\"https://www.aexp-static.com/nav/ngn/fonts/0fababca-4914-46dd-9b0f-efbd51f67ae8-3.woff\",\"https://www.aexp-static.com/cdaas/one/statics/axp-dls/5.10.0/package/dist/css/../iconfont/dls-icons.woff?v=5.10.0\"]],\"consumerICMDomain\",\"https://icm.aexp-static.com\",\"cspReportingUrl\",\"https://shopuplifthydra.americanexpress.com/_/report/security/csp-violation\",\"consumerICMPath\",\"/Internet/Acquisition/US_en/AppContent/OneSite/Data/\",\"faasApiUrl\",\"https://functions.americanexpress.com\",\"cdnUrl\",\"https://www.aexp-static.com/cdaas/one/\",\"consumerGraphApiPath\",\"us/cardshop-api/v2/cardshopql\",\"consumerApiPath\",\"us/cardshop-api/api/v1/cps/content\",\"oneXpQaToolUrl\",\"https://www.aexp-static.com/cdaas/one-xp-qa-tool/one-xp-qa-tool-E3.js\",\"cardshopApiLoggerPath\",\"us/cardshop-api/api/v1/logger\",\"consumerApiUrl\",\"https://daconsumershop.americanexpress.com\",\"experimentsApiUrl\",\"https://one-xp.americanexpress.com\",\"consumerUrlHostname\",\"https://www.americanexpress.com/\",\"consumerPublicPathHost\",\"https://www.aexp-static.com/cdaas/axp-app/modules/axp-shop-us-consumer/\",\"oneSeoApiUrl\",\"https://functions.americanexpress.com/ReadWebpageMetaTags.v2\",\"ENV\",\"E3\",\"commercialApi\",\"https://cardshop.americanexpress.com\",\"gtagEnableLocale\",[\"~#iL\",[\"en-CA\",\"fr-CA\",\"ja-JP\",\"en-AU\",\"en-GB\",\"es-MX\"]],\"consumerImagesDomain\",\"https://icm.aexp-static.com\",\"consumerLoginPath\",\"en-US/account/acquisition-shop/login\",\"rootModuleName\",\"axp-shop-root\",\"statsig\",\"client-MdMfJToYG5b6by897fM2sH9EjjKO06iWPhGJZJavBOg\"]],\"errorReporting\",[\"~#iM\",[\"queue\",[\"~#iL\",[]],\"pending\",[\"~#iL\",[]],\"pendingPromise\",null,\"retryWait\",500,\"sessionData\",[\"~#iM\",[]]]],\"modules\",[\"~#iM\",[\"axp-shop-root\",[\"~#iM\",[\"experimentConfig\",[\"~#iM\",[\"agentId\",null,\"segmentation\",[\"~#iM\",[]],\"error\",null,\"buckets\",null,\"qaList\",null,\"bbp\",null,\"experiments\",null,\"visualEditorChanges\",null,\"loading\",[\"~#iM\",[\"axp-shop-root\",true]]]],\"requestMetadataReducer\",[\"^ \",\"isExperimentationDisabled\",false,\"isCardMember\",false],\"fetchye\",[\"~#iM\",[\"errors\",[\"~#iM\",[]],\"loading\",[\"~#iS\",[]],\"data\",[\"~#iM\",[\"7e31f9a5fa64915d9b928644b6a88c87563c2b26\",[\"^ \",\"body\",[\"^ \",\"urlPath\",\"en-us/banking/online-savings/cd-account\",\"calculator\",[\"^ \",\"maxInputtedAmount\",5000000,\"header\",\"Calculate your money’s future value\",\"body\",\"Know how much you can earn from a Certificate of Deposit (CD)\",\"contentSectionHeader\",\"Tell us how much you want to deposit and for how long\",\"initialDepositInput\",\"Enter Initial Deposit Amount\",\"selectTermInput\",\"Select CD Term\",\"initialDepositInputDisclaimer\",\"No minimum balance required\",\"termInputDisclaimer\",\"Early withdrawal penalties may apply\",\"futureBalanceText\",\"Future Balance\",\"interestEarnedText\",\"Interest Earned\",\"expandableSectionHeader\",\"\",\"preFilledInputText\",\"\",\"expandableSectionBody\",\"\",\"combinedInterestEarnedText\",\"Combined Interest Earned\",\"combinedInterestEarnedTextDisclaimer\",\"If both CDs of equal size\",\"dropDownText\",\"{{term}}-Month Term (earns {{apy}}% APY)\",\"dtm\",[\"^ \",\"impression\",\"calculator\",\"event\",[\"^ \",\"location\",\"calculator\",\"ctaType\",\"initialDeposit\"]],\"disclaimerText\",\"Interest compounds daily. Savings calculator is for illustration only.³\"],\"compareSavingsProducts\",[\"^ \",\"dtm\",[\"^ \",\"impression\",\"YSAvsCD\"],\"header\",\"Compare Savings Products\",\"products\",[[\"^ \",\"header\",\"High-Yield Savings Account\",\"body\",[[\"^ \",\"type\",\"list\",\"items\",[\"High-yield growth with added flexibility\",\"Interest rates can go up or down based on the market\",\"Funds can be withdrawn with no penalty — great for unexpected challenges\"]]],\"ctas\",[[\"^ \",\"text\",\"Explore HYSA\",\"url\",\"/en-us/banking/online-savings/high-yield-savings-account/?intlink=us-acq-shop-consumer-saving-CD-exploresavings-HYSAvsCD \",\"dtm\",[\"^ \",\"event\",[\"^ \",\"location\",\"exploresavings\"]]]]],[\"^ \",\"header\",\"Certificate of Deposit Account\",\"body\",[[\"^ \",\"type\",\"list\",\"items\",[\"Know exactly how much your investment will earn\",\"A fixed APY protects you from falling interest rates\",\"Early withdrawal fee helps reinforce a committed savings strategy\"]]],\"ctas\",[[\"^ \",\"text\",\"Open CD Account\",\"url\",\"/en-us/banking/personal/savings/apply/psa-begin?product=certOfDeposit\u0026intlink=us-acq-shop-consumer-saving-CD-openanaccount-HYSAvsCD\",\"dtm\",[\"^ \",\"event\",[\"^ \",\"location\",\"openanaccount\"]]]]]]],\"disclosures\",[\"^ \",\"header\",\"\u003cb\u003eTerms and Conditions\u003c/b\u003e\",\"items\",[[\"^ \",\"content\",\"\u003csup\u003e1\u003c/sup\u003e The Annual Percentage Yield (APY) as advertised is accurate as of {{todaysDate}}. The interest rate and Annual Percentage Yield (APY) will be disclosed in your account-opening documents, which you will receive after funding your Account. The interest rate and APY for your CD will be fixed and will either be (i) the rate reflected at application submission or (ii) the rate being offered when your CD is funded, whichever is higher. All CDs must be funded within 60 calendar days from the time we approve your application or will be subject to closure. After the CD is opened, additional deposits are not permitted. Early CD withdrawals may be subject to significant penalties which could cause you to lose some of your principal. Please see the Consumer Deposit Account Agreement and Savings Schedules for additional information.\"],[\"^ \",\"content\",\"\u003csup\u003e2\u003c/sup\u003e There is no minimum balance required to open your Account, to avoid being charged a fee, or obtain the Annual Percentage Yield (APY) disclosed to you.\"],[\"^ \",\"content\",\"\u003csup\u003e3\u003c/sup\u003e Calculations are estimates of expected interest earned. Actual results may vary, based on various factors such as leap years, timing of deposits, rounding, and variation in interest rates. The first recurring deposit is assumed to begin in the second period after any initial deposit.\"]],\"dtm\",[\"^ \",\"impression\",\"footer\"]],\"eeps\",[\"^ \",\"cardmember_default\",\"80785\",\"prospect_default\",\"80785\",\"targeted\",[],\"checking_cta_eep\",\"83054\"],\"errorBanner\",[\"^ \",\"header\",\"\u003cb\u003eSorry, an error occured\u003c/b\u003e\",\"body\",\"The service you requested is currently not available. Please try again later.\"],\"exploreAllAvailableCDTerms\",[\"^ \",\"dtm\",[\"^ \",\"impression\",\"exploreallterms\"],\"header\",\"Explore all available terms\",\"footer\",[\"^ \",\"body\",\"To choose your terms, {{cta}}.\",\"arrow\",[\"^ \",\"dtm\",[\"^ \",\"event\",[\"^ \",\"location\",\"exploreallterms\",\"ctaType\",\"arrow\"]]],\"ctas\",[[\"^ \",\"text\",\"open an account\",\"url\",\"/en-us/banking/personal/savings/apply/psa-begin?product=certOfDeposit\u0026intlink=us-acq-shop-consumer-saving-CD-openanaccount-exploreallterms\",\"dtm\",[\"^ \",\"event\",[\"^ \",\"location\",\"openanaccount\"]]]]]],\"FAQs\",[\"^ \",\"dtm\",[\"^ \",\"event\",[\"^ \",\"location\",\"FAQ\"],\"impression\",\"FAQ\"],\"header\",\"Frequently Asked Questions\",\"content\",[[\"^ \",\"question\",\"What is a Certificate of Deposit (\\\"CD\\\") account?\",\"answer\",[\"American Express offers CD accounts. These are accounts with fixed interest rates and different maturity terms to choose from. Funds cannot be withdrawn from the account prior to the maturity date without a penalty.\"]],[\"^ \",\"question\",\"What is the difference between a High Yield Savings Account and a CD?\",\"answer\",[\"High Yield Savings Accounts are considered a liquid asset and offer a variable rate which can increase and decrease over time. CDs have a specific term and a maturity date that locks in the interest rate for the term. Also, there is an \u003ca title=\\\"early withdrawal penalty\\\" href=\\\"http://www.americanexpress.com/en-us/banking/online-savings/faq/early-withdrawal-from-cd\\\" class=\\\"link-underlined  linkout\\\" target=\\\"_blank\\\"\u003eearly withdrawal penalty\u003c/a\u003e to take funds out of the CD before the maturity date.\"]],[\"^ \",\"question\",\"Can I add additional funds to a CD once it’s been opened?\",\"answer\",[\"The initial funding of a CD during opening is the primary way to add funds. However, you may add funds during the 10 calendar-day period (grace period) following the Maturity Date. At maturity, if your CD is set to automatically renew, there is a 10 calendar-day grace period during which you can add or withdraw funds from your CD account without penalty.\"]],[\"^ \",\"question\",\"What is a Maturity Date and what happens after that date?\",\"answer\",[\"The Maturity Date is the date your CD is scheduled to be renewed or closed. A penalty may be imposed for a withdrawal of principal before the Maturity Date. Your CD will automatically renew on the Maturity Date, unless we are no longer offering a CD with the same term as your maturing CD or you have asked us to not automatically renew your maturing CD during the term of your CD. At maturity, if your maturing CD automatically renews, you will have a 10 calendar-day period (grace period) during which you can make a deposit or withdraw funds from your CD account without penalty. If you give us instructions prior to the Maturity Date to add or withdraw funds from your CD at maturity, your CD will be renewed on the Maturity Date and there will not be a grace period. You may prevent automatic renewal if you follow the steps online to change your maturity option, call us prior to the maturity date to change your maturity option, or if we receive written notice from you before the Maturity Date.\",\"\u003cbr\u003eFor more information on the terms and conditions of your CD, please see the \u003ca title=\\\"Consumer Deposit Account Agreement and Savings Schedules\\\" href=\\\"https://go.amex/savingsdaa\\\" class=\\\"link-underlined  linkout\\\"\u003eConsumer Deposit Account Agreement and Savings Schedules\u003c/a\u003e. For additional terms and conditions, see \\\"Truth-In-Savings disclosures\\\", and \\\"Automatic Renewal.\\\"\"]],[\"^ \",\"question\",\"Am I allowed a  partial withdrawal of funds from my CD?\",\"answer\",[\"American Express does not allow partial withdrawals from our CD accounts. If you wish to make a withdrawal, you will be required to withdraw the full amount in your account and the account will be closed.\"]],[\"^ \",\"question\",\"What if I want to withdraw my funds from my CD before the Maturity Date?\",\"answer\",[\"A penalty will be imposed if you withdraw principal from your CD before maturity, or if your CD is closed for any other reason before maturity. (In certain circumstances, such as the death or incompetence of an account holder, we may agree to waive the early withdrawal penalty.) You understand that, if the amount of the penalty is greater than the available interest earned or credited on your CD, we will deduct the difference from your principal.\",\"\u003cul\u003e\u003cli\u003eFor a CD with a Term of Less than 12 Months: If you withdraw all of your principal balance or if the account is closed for any other reason before maturity, the penalty is 90 days’ interest on the withdrawn amount applying the interest rate disclosed in your account-opening documents.\u003c/li\u003e\u003cli\u003eFor a CD with a Term of at least 12 Months but Less than 48 Months: If you withdraw all of your principal balance or if the account is closed for any other reason before maturity, the penalty is 270 days’ interest on the withdrawn amount applying the interest rate disclosed in your account-opening documents.\u003c/li\u003e\u003cli\u003eFor a CD with a Term of at least 48 Months but Less than 60 Months: If you withdraw all of your principal balance or if the account is closed for any other reason before maturity, the penalty is 365 days’ interest on the withdrawn amount applying the interest rate disclosed in your account-opening documents.\u003c/li\u003e\u003cli\u003eFor a CD with a Term of 60 Months or more: If you withdraw all of your principal balance or if the account is closed for any other reason before maturity, the penalty is 540 days’ interest on the withdrawn amount applying the interest rate disclosed in your account-opening documents.\u003c/li\u003e\u003c/ul\u003e\"]],[\"^ \",\"question\",\"How does the interest on a CD compound, and can I choose to withdraw the interest on a CD?\",\"answer\",[\"Interest on CDs compound daily and post to the account monthly. You can choose to receive payments of interest from your CD. You can have the interest paid out to you via monthly transfer to your Savings account or linked external account. You can also choose to have the interest paid via check on a monthly, quarterly, or annual basis. If you choose to have interest paid out, instead of remaining in the account, it will affect the Annual Percentage Rate Earned (APYE) because the Annual Percentage Rate (APY) is calculated assuming the interest will remain on deposit.\"]]],\"footer\",\"Have other questions? Get more answers by reviewing our full list of \",\"footerCTA\",[\"^ \",\"href\",\"https://www.americanexpress.com/en-us/banking/online-savings/support/cd/?intlink=savingscd-support-help\",\"text\",\"FAQs\",\"title\",\"FAQs link\",\"ariaLabel\",\"Link to FAQs page\",\"target\",\"_blank\",\"dtm\",[\"^ \",\"event\",[\"^ \",\"location\",\"FAQlist\"]]],\"disclaimerLinks\",[[\"^ \",\"href\",\"https://www.americanexpress.com/en-us/banking/legal-library/index.html?extlink=US-Web-null-depositslegal\",\"text\",\"Consumer Banking Legal Agreements\",\"ariaLabel\",\"Consumer Banking Legal Agreements\",\"target\",\"_blank\",\"iconName\",\"IconDocument\",\"dtm\",[\"^ \",\"event\",[\"^ \",\"location\",\"disclaimerLinks\"]]],[\"^ \",\"href\",\"https://www.americanexpress.com/en-us/banking/online-savings/support/printable-forms/?intlink=savingshysa-support-forms\",\"text\",\"Printable Forms\",\"ariaLabel\",\"Printable Forms\",\"target\",\"_blank\",\"iconName\",\"IconPrint\",\"dtm\",[\"^ \",\"event\",[\"^ \",\"location\",\"disclaimerLinks\"]]],[\"^ \",\"href\",\"https://www.americanexpress.com/en-us/banking/online-savings/contact-us/?intlink=savingshysa-support-contact\",\"text\",\"Contact Us\",\"ariaLabel\",\"Contact Us\",\"target\",\"_blank\",\"iconName\",\"IconTelephone\",\"dtm\",[\"^ \",\"event\",[\"^ \",\"location\",\"disclaimerLinks\"]]],[\"^ \",\"href\",\"https://www.americanexpress.com/en-us/banking/personal/savings/register/account-verification/identify?cancelUrl=https%3A%2F%2Fwww.americanexpress.com%2Fen-us%2Fbanking%2Fonline-savings%2Fhigh-yield-savings%2F\u0026submitUrl=%2Fen-us%2Fbanking%2Fpersonal%2Fsavings%2Fdashboard\",\"text\",\"Create Online Access\",\"ariaLabel\",\"Create Online Access\",\"target\",\"_blank\",\"iconName\",\"IconDesktop\",\"dtm\",[\"^ \",\"event\",[\"^ \",\"location\",\"disclaimerLinks\"]]]]],\"fdicBanner\",[\"^ \",\"disclaimerText\",\"Accounts offered by American Express National Bank. Member FDIC.\",\"ctas\",[[\"^ \",\"Component\",\"a\",\"$type\",\"Type.Primary\",\"urlPath\",\"https://www.fdic.gov\",\"shouldSkipEEP\",true,\"text\",\"FDIC.gov\",\"target\",\"_blank\",\"dtm\",[\"^ \",\"event\",[\"^ \",\"location\",\"FDIC\"]]]],\"insuredText\",\"FDIC-Insured - Backed by the full faith and credit of the U.S.\u0026nbsp;Government.\"],\"featureFlag\",[\"^ \",\"enableTargetedCampaign\",true,\"enableBroadScaleCampaign\",false,\"enableViewAllCards\",true],\"heroBanner\",[\"^ \",\"header\",\"Watch your money grow with a Certificate of Deposit (CD)\",\"body\",\"Choose your term — from months to years — to lock in your rate.\u003csup\u003e1\u003c/sup\u003e\",\"FDICDisclaimer\",[\"^ \",\"logo\",[\"^ \",\"src\",\"/Internet/Acquisition/US_en/AppContent/OneSite/Data/SVG/banking/fdic-logo.svg\",\"altText\",\"FDIC Logo. \"],\"text\",\"FDIC-Insured - Backed by the full faith and credit of the U.S. Government.\"],\"backgroundImage\",[\"^ \",\"aria-role\",\"decorative\",\"altText\",\"I am a decorative Image. with no purpose for the screen reader.\",\"breakpoints\",[\"^ \",\"sm\",[\"^ \",\"1x\",\"/Internet/Acquisition/US_en/AppContent/OneSite/CD/uplift/cd-account-hero-banner-mobile.png\",\"2x\",\"/Internet/Acquisition/US_en/AppContent/OneSite/CD/uplift/cd-account-hero-banner-mobile.png\"],\"md\",[\"^ \",\"1x\",\"/Internet/Acquisition/US_en/AppContent/OneSite/CD/uplift/cd-account-hero-banner-tablet.png\",\"2x\",\"/Internet/Acquisition/US_en/AppContent/OneSite/CD/uplift/cd-account-hero-banner-tablet.png\"],\"lg\",[\"^ \",\"1x\",\"/Internet/Acquisition/US_en/AppContent/OneSite/CD/uplift/cd-account-hero-banner-desktop.png\",\"2x\",\"/Internet/Acquisition/US_en/AppContent/OneSite/CD/uplift/cd-account-hero-banner-desktop.png\"],\"xl\",[\"^ \",\"1x\",\"/Internet/Acquisition/US_en/AppContent/OneSite/CD/uplift/cd-account-hero-banner-desktop.png\",\"2x\",\"/Internet/Acquisition/US_en/AppContent/OneSite/CD/uplift/cd-account-hero-banner-desktop.png\"]]],\"callToActionWithLinkProps\",[\"^ \",\"ctas\",[[\"^ \",\"Component\",\"a\",\"$type\",\"Type.Primary\",\"urlPath\",\"/en-us/banking/personal/savings/apply/psa-begin?product=certOfDeposit\",\"shouldSkipEEP\",true,\"text\",\"Open CD Account\",\"dtm\",[\"^ \",\"event\",[\"^ \",\"location\",\"HeroBanner\",\"ctaType\",\"openanaccount\"],\"intLink\",[\"^ \",\"ctaType\",\"openanaccount\",\"location\",\"hero\"]]]],\"contentAfterCTAText\",\"\"]],\"hostingURIs\",[\"^ \",\"LOCAL_DEVELOPMENT\",\"https://qwww.americanexpress.com/\",\"E1\",\"https://qwww.americanexpress.com/\",\"E2\",\"https://qwww.americanexpress.com/\",\"E3_IPC1\",\"https://www.americanexpress.com/\",\"E3_IPC2\",\"https://www.americanexpress.com/\"],\"keyBenefits\",[\"^ \",\"dtm\",[\"^ \",\"impression\",\"featuredBenefits\"],\"headerText\",[\"^ \",\"apyText\",\"{{apy}}% APY\u003csup\u003e1\u003c/sup\u003e\",\"accurateAsOfText\",\"\",\"basedOnText\",\"Based on the \u003ca href='#cdCarousel' class=\\\"text-underline dls-white\\\"\u003eterm\u003c/a\u003e you select\",\"upToText\",\"UP TO\"],\"benefits\",[[\"^ \",\"iconName\",\"IconCd\",\"header\",\"Fixed Interest Rate \u0026 APY\",\"content\",\"Know exactly how much you’ll earn by locking in your rate\"],[\"^ \",\"iconName\",\"IconNoFee\",\"header\",\"No Monthly Fees\u003csup\u003e2\u003c/sup\u003e\",\"content\",\"Enjoy no minimum balance and no monthly fees\"],[\"^ \",\"iconName\",\"IconRecurringInterest\",\"header\",\"Earns Daily Interest\",\"content\",\"Interest is compounded daily and credited to your account monthly\"],[\"^ \",\"iconName\",\"IconMedal\",\"header\",\"24/7 Customer Support\",\"content\",\"Bank confidently with world-class customer service from American Express\"]]],\"legalDisclaimers\",[\"^ \",\"disclaimerLinks\",[[\"^ \",\"href\",\"https://www.americanexpress.com/content/dam/amex/en-us/banking/personal-savings/deposit_account_agreement.pdf?extlink=US-Servicing-null-savingsdaa\",\"text\",\"Deposit Account Agreement\",\"ariaLabel\",\"Deposit Account Agreement\",\"target\",\"_blank\",\"dtm\",[\"^ \",\"event\",[\"^ \",\"location\",\"disclaimerLinks\"]]],[\"^ \",\"href\",\"https://www.americanexpress.com/us/company/privacy-center/online-privacy-disclosures/\",\"text\",\"Privacy Statement\",\"ariaLabel\",\"Privacy Statement\",\"target\",\"_blank\",\"dtm\",[\"^ \",\"event\",[\"^ \",\"location\",\"disclaimerLinks\"]]],[\"^ \",\"href\",\"https://www.americanexpress.com/en-us/banking/online-savings/support/\",\"text\",\"Need Help?\",\"ariaLabel\",\"Need Help?\",\"target\",\"_blank\",\"dtm\",[\"^ \",\"event\",[\"^ \",\"location\",\"disclaimerLinks\"]]]]],\"moreFromAmexModule\",[\"^ \",\"dtm\",[\"^ \",\"impression\",\"morefromamex\"],\"backgroundImage\",\"/Internet/Acquisition/US_en/AppContent/OneSite/personal-loans/More_From_Amex_Background.webp\",\"amexLogo\",[\"^ \",\"altText\",\"\",\"breakpoints\",[\"^ \",\"lg\",\"/Internet/Acquisition/US_en/AppContent/OneSite/consumer-checking/amex-logo-desktop.png\",\"md\",\"/Internet/Acquisition/US_en/AppContent/OneSite/consumer-checking/amex-logo-tablet.png\",\"sm\",\"/Internet/Acquisition/US_en/AppContent/OneSite/consumer-checking/amex-logo-mobile.png\"]],\"header\",\"More From American Express\",\"moduleData\",[[\"^ \",\"tagCheckingEep\",true,\"ctaText\",\"Explore Rewards Checking\",\"ctaType\",\"amexsavings\",\"ctaUrlPath\",\"https://www.americanexpress.com/en-us/banking/checking-account/\",\"shouldSkipIntLinkWithLinkNav\",false,\"occupyFullRow\",true,\"headerText\",\"Earn $300 with a new Amex® Rewards Checking Account\",\"headerText_var_a\",\"Amex® Rewards Checking - Reliable Customer Support\",\"headerText_var_b\",\"Amex® Rewards Checking - Manage Your Accounts in One Place\",\"bodyText\",\"After qualifying actions. Terms and eligibility apply. American Express National Bank. Member FDIC. \",\"dtm\",[\"^ \",\"event\",[\"^ \",\"ctaType\",\"explorecheckings\",\"location\",\"morefromamex\"],\"intLink\",[\"^ \",\"ctaType\",\"amexsavings\",\"location\",\"morefromamex\"]],\"image\",[\"^ \",\"altText\",\"\",\"breakpoints\",[\"^ \",\"lg\",\"/Internet/Acquisition/US_en/AppContent/OneSite/hysa/uplift/mfa-checking-desktop.png\",\"md\",\"/Internet/Acquisition/US_en/AppContent/OneSite/hysa/uplift/mfa-checking-tablet.png\",\"sm\",\"/Internet/Acquisition/US_en/AppContent/OneSite/hysa/uplift/mfa-checking-mobile.png\"]]],[\"^ \",\"ctaText\",\"Explore Savings\",\"ctaType\",\"amexsavings\",\"ctaUrlPath\",\"https://www.americanexpress.com/en-us/banking/online-savings/high-yield-savings-account/\",\"shouldSkipIntLinkWithLinkNav\",false,\"headerText\",\"High Yield Savings Account\",\"bodyText\",\"Grow your money with American Express\u003csup\u003e®\u003c/sup\u003e Savings. Accounts offered by American Express National Bank. Member FDIC. Terms Apply. \",\"dtm\",[\"^ \",\"event\",[\"^ \",\"ctaType\",\"exploresavings\",\"location\",\"morefromamex\"],\"intLink\",[\"^ \",\"ctaType\",\"amexsavings\",\"location\",\"morefromamex\"]],\"image\",[\"^ \",\"altText\",\"\",\"breakpoints\",[\"^ \",\"lg\",\"/Internet/Acquisition/US_en/AppContent/OneSite/hysa/uplift/mfa-savings-desktop.png\",\"md\",\"/Internet/Acquisition/US_en/AppContent/OneSite/hysa/uplift/mfa-savings-tablet.png\",\"sm\",\"/Internet/Acquisition/US_en/AppContent/OneSite/hysa/uplift/mfa-savings-mobile.png\"]]],[\"^ \",\"ctaText\",\"Explore Credit Cards\",\"ctaType\",\"personalcards\",\"ctaUrlPath\",\"https://www.americanexpress.com/us/credit-cards/?inav=menu_cards_pc_viewallcards\",\"headerText\",\"Personal American Express® Cards\",\"bodyText\",\"View our selection of Cards and experience what it means to be backed by Amex. \",\"dtmText\",\"explorecreditcards\",\"dtm\",[\"^ \",\"event\",[\"^ \",\"ctaType\",\"explorecreditcards\"],\"intLink\",[\"^ \",\"ctaType\",\"personalcards\",\"location\",\"\"]],\"image\",[\"^ \",\"altText\",\"\",\"breakpoints\",[\"^ \",\"lg\",\"/Internet/Acquisition/US_en/AppContent/OneSite/hysa/uplift/mfa-cards-desktop.png\",\"md\",\"/Internet/Acquisition/US_en/AppContent/OneSite/hysa/uplift/mfa-cards-tablet.png\",\"sm\",\"/Internet/Acquisition/US_en/AppContent/OneSite/hysa/uplift/mfa-cards-mobile.png\"]]]]],\"offerBanner\",[\"^ \",\"dtm\",[\"^ \",\"impression\",\"offerbanner\"]],\"persistantQueryParams\",[\"irclickid\",\"irgwc\",\"pid\",\"extlink\",\"native\",\"utm_*\"],\"reinforcementBanner\",[\"^ \",\"dtm\",[\"^ \",\"impression\",\"reinforcementbanner\"],\"backgroundImage\",\"Internet/Acquisition/US_en/AppContent/OneSite/personal-loans/reinforcement-banner.svg\",\"body\",\"Let’s start looking ahead. Your interest earnings are waiting.\",\"contentAfterCTAText\",\"If you want more access to your money, check out a \u003ca class='text-underline' href='https://www.americanexpress.com/en-us/banking/online-savings/high-yield-savings-account/?intlink=us-acq-shop-consumer-banking-CD-highyieldsavingsaccount-reinforcement'\u003eHigh Yield Savings Account\u003c/a\u003e.\",\"ctas\",[[\"^ \",\"Component\",\"a\",\"$type\",\"secondary\",\"urlPath\",\"/en-us/banking/personal/savings/apply/psa-begin?product=certOfDeposit\",\"text\",\"Open CD Account\",\"shouldSkipEEP\",true,\"dtm\",[\"^ \",\"event\",[\"^ \",\"location\",\"reinforcementbanner\",\"ctaType\",\"openanaccount\"],\"intLink\",[\"^ \",\"ctaType\",\"openanaccount\",\"location\",\"reinforcementbanner\"]]]]],\"seo\",[\"^ \",\"additionalMetaTags\",[],\"tags\",[[\"^ \",\"@context\",\"https://schema.org/\",\"@type\",\"BreadcrumbList\",\"itemListElement\",[[\"^ \",\"@type\",\"ListItem\",\"position\",1,\"name\",\"Home\",\"item\",\"https://www.americanexpress.com/\"],[\"^ \",\"@type\",\"ListItem\",\"position\",2,\"name\",\"Online Savings\",\"item\",\"https://www.americanexpress.com/en-us/banking/online-savings/account/\"],[\"^ \",\"@type\",\"ListItem\",\"position\",3,\"name\",\"Certificate of Deposit\",\"item\",\"https://www.americanexpress.com/en-us/banking/online-savings/cd-account/\"]]],[\"^ \",\"@context\",\"https://schema.org\",\"@type\",\"FAQPage\",\"mainEntity\",[[\"^ \",\"@type\",\"Question\",\"name\",\"What is a Certificate of Deposit (\\\"CD\\\") account?\",\"acceptedAnswer\",[\"^ \",\"@type\",\"Answer\",\"text\",\"American Express offers CD accounts. These are accounts with fixed interest rates and different maturity terms to choose from. Funds cannot be withdrawn from the account prior to the maturity date without a penalty.\"]],[\"^ \",\"@type\",\"Question\",\"name\",\"What is the difference between a High Yield Savings Account and a CD?\",\"acceptedAnswer\",[\"^ \",\"@type\",\"Answer\",\"text\",\"High Yield Savings Accounts are considered a liquid asset and offer a variable rate which can increase and decrease over time. CDs have a specific term and a maturity date that locks in the interest rate for the term. Also, there is an \u003ca title=\\\"early withdrawal penalty\\\" href=\\\"http://www.americanexpress.com/en-us/banking/online-savings/faq/early-withdrawal-from-cd\\\" class=\\\"link-underlined  linkout\\\" target=\\\"_blank\\\"\u003eearly withdrawal penalty\u003c/a\u003e to take funds out of the CD before the maturity date.\"]],[\"^ \",\"@type\",\"Question\",\"name\",\"Can I add additional funds to a CD once it’s been opened?\",\"acceptedAnswer\",[\"^ \",\"@type\",\"Answer\",\"text\",\"The initial funding of a CD during opening is the primary way to add funds. However, you may add funds during the 10 calendar-day period (grace period) following the Maturity Date. At maturity, if your CD is set to automatically renew, there is a 10 calendar-day grace period during which you can add or withdraw funds from your CD account without penalty.\"]],[\"^ \",\"@type\",\"Question\",\"name\",\"What is a Maturity Date and what happens after that date?\",\"acceptedAnswer\",[\"^ \",\"@type\",\"Answer\",\"text\",\"The Maturity Date is the date your CD is scheduled to be renewed or closed. A penalty may be imposed for a withdrawal of principal before the Maturity Date. Your CD will automatically renew on the Maturity Date, unless we are no longer offering a CD with the same term as your maturing CD or you have asked us to not automatically renew your maturing CD during the term of your CD. At maturity, if your maturing CD automatically renews, you will have a 10 calendar-day period (grace period) during which you can make a deposit or withdraw funds from your CD account without penalty. If you give us instructions prior to the Maturity Date to add or withdraw funds from your CD at maturity, your CD will be renewed on the Maturity Date and there will not be a grace period. You may prevent automatic renewal if you follow the steps online to change your maturity option, call us prior to the maturity date to change your maturity option, or if we receive written notice from you before the Maturity Date.\u003cbr\u003eFor more information on the terms and conditions of your CD, please see the \u003ca title=\\\"Consumer Deposit Account Agreement and Savings Schedules\\\" href=\\\"https://go.amex/savingsdaa\\\" class=\\\"link-underlined  linkout\\\"\u003eConsumer Deposit Account Agreement and Savings Schedules\u003c/a\u003e. For additional terms and conditions, see \\\"Truth-In-Savings disclosures\\\", and \\\"Automatic Renewal.\\\"\"]],[\"^ \",\"@type\",\"Question\",\"name\",\"Am I allowed a  partial withdrawal of funds from my CD?\",\"acceptedAnswer\",[\"^ \",\"@type\",\"Answer\",\"text\",\"American Express does not allow partial withdrawals from our CD accounts. If you wish to make a withdrawal, you will be required to withdraw the full amount in your account and the account will be closed.\"]],[\"^ \",\"@type\",\"Question\",\"name\",\"What if I want to withdraw my funds from my CD before the Maturity Date?\",\"acceptedAnswer\",[\"^ \",\"@type\",\"Answer\",\"text\",\"A penalty will be imposed if you withdraw principal from your CD before maturity, or if your CD is closed for any other reason before maturity. (In certain circumstances, such as the death or incompetence of an account holder, we may agree to waive the early withdrawal penalty.) You understand that, if the amount of the penalty is greater than the available interest earned or credited on your CD, we will deduct the difference from your principal. \u003cul\u003e\u003cli\u003eFor a CD with a Term of Less than 12 Months: If you withdraw all of your principal balance or if the account is closed for any other reason before maturity, the penalty is 90 days’ interest on the withdrawn amount applying the interest rate disclosed in your account-opening documents.\u003c/li\u003e\u003cli\u003eFor a CD with a Term of at least 12 Months but Less than 48 Months: If you withdraw all of your principal balance or if the account is closed for any other reason before maturity, the penalty is 270 days’ interest on the withdrawn amount applying the interest rate disclosed in your account-opening documents.\u003c/li\u003e\u003cli\u003eFor a CD with a Term of at least 48 Months but Less than 60 Months: If you withdraw all of your principal balance or if the account is closed for any other reason before maturity, the penalty is 365 days’ interest on the withdrawn amount applying the interest rate disclosed in your account-opening documents.\u003c/li\u003e\u003cli\u003eFor a CD with a Term of 60 Months or more: If you withdraw all of your principal balance or if the account is closed for any other reason before maturity, the penalty is 540 days’ interest on the withdrawn amount applying the interest rate disclosed in your account-opening documents.\u003c/li\u003e\u003c/ul\u003e\"]],[\"^ \",\"@type\",\"Question\",\"name\",\"How does the interest on a CD compound, and can I choose to withdraw the interest on a CD?\",\"acceptedAnswer\",[\"^ \",\"@type\",\"Answer\",\"text\",\"Interest on CDs compound daily and post to the account monthly. You can choose to receive payments of interest from your CD. You can have the interest paid out to you via monthly transfer to your Savings account or linked external account. You can also choose to have the interest paid via check on a monthly, quarterly, or annual basis. If you choose to have interest paid out, instead of remaining in the account, it will affect the Annual Percentage Rate Earned (APYE) because the Annual Percentage Rate (APY) is calculated assuming the interest will remain on deposit.\"]],[\"^ \",\"@type\",\"Question\",\"name\",\"What is CD Laddering?\",\"acceptedAnswer\",[\"^ \",\"@type\",\"Answer\",\"text\",\"You are able to open multiple CD accounts with varying term lengths to take advantage of a CD laddering strategy. A CD ladder allows you to take advantage of the benefits of shorter-term CDs, while also having some funds earn predictable rates for longer terms.\"]]]],[\"^ \",\"@context\",\"https://schema.org\",\"@type\",\"FinancialProduct\",\"name\",\"American Express Certificate of Deposit (CD) Account\",\"description\",\"A CD account with fixed interest rates across multiple terms, no monthly fees, and daily compounded interest.\",\"feesAndCommissionsSpecification\",\"No monthly fees; early withdrawal penalties apply for funds withdrawn before the maturity date.\",\"offers\",[\"^ \",\"@type\",\"Offer\",\"name\",\"American Express CD Terms\",\"description\",\"Various term options are available for Certificate of Deposit (CD) accounts.\"],\"provider\",[\"^ \",\"@type\",\"FinancialService\",\"name\",\"American Express National Bank\",\"url\",\"https://www.americanexpress.com/en-us/banking/online-savings/cd-account/\"]]]],\"subNav\",[\"^ \",\"header\",\"Savings\",\"cta\",[\"^ \",\"text\",\"Open an Account\",\"url\",\"/en-us/banking/personal/savings/apply/psa-begin?product=certOfDeposit\u0026intlink=us-acq-shop-consumer-saving-CD-openanaccount-subnav\",\"dtmName\",\"openanaccount\",\"shouldSkipEEP\",true],\"navLinks\",[[\"^ \",\"text\",\"High Yield Savings\",\"url\",\"https://www.americanexpress.com/en-us/banking/online-savings/high-yield-savings-account/?linknav=savings-nav-hysa\",\"iconName\",\"savings\",\"id\",\"highYieldSavings\",\"dtmName\",\"HYSA\"],[\"^ \",\"text\",\"CDs\",\"url\",\"https://www.americanexpress.com/en-us/banking/online-savings/cd-account/?linknav=savings-nav-cd\",\"iconName\",\"cd\",\"id\",\"certificateOfDeposit\",\"dtmName\",\"CDs\"],[\"^ \",\"text\",\"Support\",\"url\",\"https://www.americanexpress.com/en-us/banking/online-savings/support/?linknav=savings-nav-support\",\"iconName\",\"help\",\"id\",\"support\",\"dtmName\",\"support\"]]],\"threeStepsBanner\",[\"^ \",\"mainHeader\",\"Apply for an Account in minutes\",\"bannerData\",[[\"^ \",\"header\",\"Open a Certificate of Deposit\",\"description\",\"\u003cbr\u003eand we’ll verify your identity – you’ll receive a confirmation email when your Account is opened.\"],[\"^ \",\"header\",\"Register your online account\",\"description\",\"\u003cbr\u003eafter you receive your confirmation email.\"],[\"^ \",\"header\",\"Sign in and fund your new Account\",\"description\",\"\u003cbr\u003eby linking your current bank. Linking your external account can take up to two days. Or you may also mail a check.\"]],\"disclaimerText\",\"See \u003ca class='text-underline' href='https://www.americanexpress.com/en-us/banking/online-savings/support/cd/?intlink=us-acq-shop-consumer-saving-CD-3stepsbanner-FAQ' target='_blank'\u003eFAQs\u003c/a\u003e for further details about the transfer process, or \u003ca class='text-underline' href='https://www.americanexpress.com/en-us/banking/online-savings/contact-us/?intlink=us-acq-shop-consumer-saving-CD-3stepsbanner-contactus' target='_blank'\u003econtact us 24/7\u003c/a\u003e with questions.\",\"image\",[\"^ \",\"altText\",\"\",\"breakpoints\",[\"^ \",\"lg\",\"/Internet/Acquisition/US_en/AppContent/OneSite/hysa/uplift/2-steps-desktop.png\",\"md\",\"/Internet/Acquisition/US_en/AppContent/OneSite/hysa/uplift/2-steps-tablet.png\",\"sm\",\"/Internet/Acquisition/US_en/AppContent/OneSite/hysa/uplift/2-steps-mobile.png\"]],\"ctaData\",[\"^ \",\"text\",\"Open CD Account\",\"urlPath\",\"/en-us/banking/personal/savings/apply/psa-begin?product=certOfDeposit\",\"shouldSkipEEP\",true,\"dtm\",[\"^ \",\"impression\",\"openanaccount\",\"event\",[\"^ \",\"location\",\"threestepsbanner\",\"ctaType\",\"openanaccount\"],\"intLink\",[\"^ \",\"ctaType\",\"openanaccount\",\"location\",\"howtoopenanaccount\"]]]],\"tiles\",[\"^ \",\"tileData\",[[\"^ \",\"content\",[\"^ \",\"cardImages\",[\"^ \",\"altText\",\"A short animation showing how the Amex App combines credit card and checking account features, including account and Membership Reward point balances.\",\"breakpoints\",[\"^ \",\"sm\",[\"^ \",\"1x\",\"/Internet/Acquisition/US_en/AppContent/OneSite/CD/uplift/basic-cd-mobile.png\",\"2x\",\"/Internet/Acquisition/US_en/AppContent/OneSite/CD/uplift/basic-cd-mobile.png\"],\"md\",[\"^ \",\"1x\",\"/Internet/Acquisition/US_en/AppContent/OneSite/CD/uplift/basic-cd-tablet.png\",\"2x\",\"/Internet/Acquisition/US_en/AppContent/OneSite/CD/uplift/basic-cd-tablet.png\"],\"lg\",[\"^ \",\"1x\",\"/Internet/Acquisition/US_en/AppContent/OneSite/CD/uplift/basic-cd-desktop.png\",\"2x\",\"/Internet/Acquisition/US_en/AppContent/OneSite/CD/uplift/basic-cd-desktop.png\"],\"xl\",[\"^ \",\"1x\",\"/Internet/Acquisition/US_en/AppContent/OneSite/CD/uplift/basic-cd-desktop.png\",\"2x\",\"/Internet/Acquisition/US_en/AppContent/OneSite/CD/uplift/basic-cd-desktop.png\"]]],\"title\",\"Get to know CDs and HYSAs: a path to smart savings\",\"bulletPoints\",[[\"^ \",\"text\",\"Certificates of deposit (CDs) and high-yield savings accounts (HYSAs) can be smart, convenient ways to grow your funds.\"],[\"^ \",\"text\",\"\u003cb\u003eCDs\u003c/b\u003e offer the certainty of knowing exactly how much you'll earn. Your rate is locked in for the life of the CD, allowing you to keep your rate if interest rates drop. There's a fee for early withdrawals, but this encourages disciplined money growth. You can enhance your returns with CD laddering – a savvy tactic to spread the dates when your CDs mature. You benefit from locked-in returns across different rates and terms.\"],[\"^ \",\"text\",\"Prefer more flexibility? A \u003cb\u003eHYSA\u003c/b\u003e offers strong growth with the added perk of fee-free withdrawals. Interest rates could go up or down based on market fluctuations – but the added freedom is ideal for life’s unexpected turns.\"]]],\"ctas\",[[\"^ \",\"Component\",\"a\",\"$type\",\"secondary\",\"urlPath\",\"https://www.americanexpress.com/en-us/banking/online-savings/articles/what-is-cd/\",\"shouldSkipEEP\",true,\"text\",\"Learn More About CDs\",\"dtm\",[\"^ \",\"event\",[\"^ \",\"location\",\"GetToKnowCDs\"],\"intLink\",[\"^ \",\"location\",\"GetToKnowCDs\"]]]],\"imagePosition\",\"right\",\"dtm\",[\"^ \",\"impression\",\"learnmore\"]]]],\"cdTerms\",[\"^ \",\"badge\",[\"^ \",\"text\",\"Featured APY\",\"icon\",\"high-yield\"],\"footerText\",\"Choose your term when you \u003ca class='dls-bright-blue text-underline' href='https://www.americanexpress.com/en-us/banking/personal/savings/apply/psa-begin?product=certOfDeposit\u0026intlink=us-acq-shop-consumer-saving-CD-openanaccount-exploreallterms'\u003eopen a CD account\u003c/a\u003e\",\"headerText\",\"Browse all available CD terms\",\"dtm\",[\"^ \",\"impression\",\"exploreallterms\",\"event\",[\"^ \",\"location\",\"exploreallterms\"]]],\"savingsVsCd\",[\"^ \",\"header\",\"Compare Savings products\",\"images\",[\"^ \",\"altText\",\"\",\"breakpoints\",[\"^ \",\"sm\",\"/Internet/Acquisition/US_en/AppContent/OneSite/CD/uplift/hysaVsCDMobile.png\",\"md\",\"/Internet/Acquisition/US_en/AppContent/OneSite/CD/uplift/hysaVsCDTablet.png\",\"lg\",\"/Internet/Acquisition/US_en/AppContent/OneSite/CD/uplift/hysaVsCDDesktop.png\"],\"placeholder\",\"/Internet/Acquisition/US_en/AppContent/OneSite/consumer-checking/hero-image-small.png\"],\"savingsColumn\",[\"^ \",\"header\",\"High-Yield Savings Account (HYSA)\",\"content\",[\"High-yield growth with added flexibility\",\"Interest rates can go up or down based on the market\",\"Funds can be withdrawn with no penalty — great for unexpected challenges\"],\"ctas\",[[\"^ \",\"$type\",\"secondary\",\"text\",\"Explore HYSA\",\"urlPath\",\"/en-us/banking/online-savings/high-yield-savings-account/\",\"dtm\",[\"^ \",\"intLink\",[\"^ \",\"ctaType\",\"exploresavings\",\"location\",\"HYSAvsCD\"],\"event\",[\"^ \",\"ctaType\",\"exploresavings\",\"location\",\"HYSAvsCD\"]]]],\"dtm\",[\"^ \",\"impression\",\"HYSAvsCD\"]],\"CDColumn\",[\"^ \",\"header\",\"Certificate of Deposit Account\",\"content\",[\"Know exactly how much your investment will earn\",\"A fixed APY protects you from falling interest rates\",\"Early withdrawal fee helps reinforce a committed savings strategy\"],\"ctas\",[[\"^ \",\"$type\",\"secondary\",\"text\",\"Open CD Account\",\"urlPath\",\"/en-us/banking/personal/savings/apply/psa-begin?product=certOfDeposit\",\"dtm\",[\"^ \",\"intLink\",[\"^ \",\"ctaType\",\"openanaccount\",\"location\",\"HYSAvsCD\"],\"event\",[\"^ \",\"ctaType\",\"openanaccount\",\"location\",\"HYSAvsCD\"]]]]]],\"validErrorCodes\",[6410,6510]],\"ok\",true,\"headers\",[\"^ \",\"access-control-max-age\",\"3000000\",\"cache-control\",\"no-store, no-cache, must-revalidate, proxy-revalidate\",\"connection\",\"close\",\"content-encoding\",\"gzip\",\"content-type\",\"application/json; charset=utf-8\",\"date\",\"Fri, 09 Oct 2026 02:15:00 GMT\",\"expires\",\"0\",\"pragma\",\"no-cache\",\"server-timing\",\", VTO;dur=954;desc=VTO\",\"set-cookie\",\"SaneID=148.173.89.129-1791512100433865; Domain=americanexpress.com; Path=/, acq_journey_id=13365c2d-0a7b-42d7-9bb0-7ca1d8e10116; Domain=americanexpress.com; Path=/; HttpOnly; Secure; SameSite=Lax, pznid=94378401189754799743625417039805480141%7C9; Domain=americanexpress.com; Path=/; Expires=Tue, 09 Nov 2027 02:15:00 GMT, CARDSHOP_SESS=s%3A7fb5059e-c8ca-4e09-b3e3-3e0602ac6959.K76HHyY2%2FyP7zohT8sG0zQyeh8TUqQlSPcxrOa2K7zw; Domain=americanexpress.com; Path=/; HttpOnly; Secure, TS01a91ed4=01368fc6df68af381644b58699a50af386fee927cf9e5f703076ad558da08f7547dd8f09eaacdbf7943e30333aa6d686ed7749755b; Path=/; Domain=.americanexpress.com\",\"strict-transport-security\",\"max-age=31536000; includeSubDomains\",\"surrogate-control\",\"no-store\",\"transfer-encoding\",\"chunked\",\"vary\",\"Accept-Encoding\",\"x-aexp-build\",\"37869111053\",\"x-aexp-timestamp\",\"2026-10-09 01:20:47\",\"x-content-type-options\",\"nosniff\",\"x-download-options\",\"noopen\",\"x-fra