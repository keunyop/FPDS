ion-shop/login\",\"rootModuleName\",\"axp-shop-root\",\"statsig\",\"client-MdMfJToYG5b6by897fM2sH9EjjKO06iWPhGJZJavBOg\"]],\"errorReporting\",[\"~#iM\",[\"queue\",[\"~#iL\",[]],\"pending\",[\"~#iL\",[]],\"pendingPromise\",null,\"retryWait\",500,\"sessionData\",[\"~#iM\",[]]]],\"modules\",[\"~#iM\",[\"axp-shop-root\",[\"~#iM\",[\"experimentConfig\",[\"~#iM\",[\"agentId\",null,\"segmentation\",[\"~#iM\",[]],\"error\",null,\"buckets\",null,\"qaList\",null,\"bbp\",null,\"experiments\",null,\"visualEditorChanges\",null,\"loading\",[\"~#iM\",[\"axp-shop-root\",true]]]],\"requestMetadataReducer\",[\"^ \",\"isExperimentationDisabled\",false,\"isCardMember\",false],\"fetchye\",[\"~#iM\",[\"errors\",[\"~#iM\",[]],\"loading\",[\"~#iS\",[]],\"data\",[\"~#iM\",[\"6a55db778814bb5bfbdbdf34582abce4e4f7f929\",[\"^ \",\"body\",[\"^ \",\"featureFlag\",[\"^ \",\"enableTargetedCampaign\",true,\"enableBroadScaleCampaign\",false,\"enableViewAllCards\",true],\"errorBanner\",[\"^ \",\"header\",\"\u003cb\u003eSorry, an error occured\u003c/b\u003e\",\"body\",\"The service you requested is currently not available. Please try again later.\"],\"persistantQueryParams\",[\"irclickid\",\"irgwc\",\"pid\",\"extlink\",\"native\",\"utm_*\"],\"fallbackContent\",[\"^ \",\"eep\",\"81036\"],\"eeps\",[\"^ \",\"cardmember_default\",\"81036\",\"prospect_default\",\"81036\",\"targeted\",[\"83928\",\"83929\",\"83930\",\"83931\",\"83932\",\"83933\",\"83934\",\"83935\",\"83936\",\"83937\",\"83938\",\"83939\",\"83940\",\"83941\",\"83942\",\"83943\",\"83944\",\"83945\",\"83946\",\"83947\",\"83948\",\"83949\",\"83950\",\"83951\",\"83952\",\"83953\",\"83954\",\"83955\",\"83974\",\"83975\",\"83976\",\"83977\",\"83978\",\"83979\",\"83980\",\"83981\",\"83982\",\"83983\",\"83984\",\"83985\",\"83986\",\"83987\",\"83988\",\"83989\",\"83990\",\"83991\",\"83992\",\"83993\",\"83994\",\"83995\",\"83996\",\"83997\",\"83998\",\"83999\",\"84000\",\"84001\",\"84002\",\"84003\",\"84004\",\"84005\",\"84123\",\"84124\"],\"checking_cta_eep\",\"83053\"],\"hostingURIs\",[\"^ \",\"LOCAL_DEVELOPMENT\",\"https://qwww.americanexpress.com/\",\"E1\",\"https://qwww.americanexpress.com/\",\"E2\",\"https://qwww.americanexpress.com/\",\"E3_IPC1\",\"https://www.americanexpress.com/\",\"E3_IPC2\",\"https://www.americanexpress.com/\"],\"urlPath\",\"en-us/banking/online-savings/high-yield-savings-account\",\"validErrorCodes\",[6410,6510],\"FAQs\",[\"^ \",\"dtm\",[\"^ \",\"event\",[\"^ \",\"location\",\"FAQ\"],\"impression\",\"FAQ\"],\"header\",\"Frequently Asked Questions\",\"content\",[[\"^ \",\"question\",\"What is an American Express High Yield Savings Account (HYSA)?\",\"answer\",[\"The American Express High Yield Savings Account is a savings account with a variable interest rate. Interest on our HYSA is compounded daily and posted to accounts monthly.\"]],[\"^ \",\"question\",\"Do I get an ATM card, a debit card, or checks when I open an American Express HYSA?\",\"answer\",[\"Savings accounts are not meant for everyday spending. ATM cards, debit cards, or checks are not provided. However, for your everyday spending needs, you may be eligible for an American Express\u003csup\u003e®\u003c/sup\u003e Rewards Checking account. Additional terms and eligibility apply. To learn more about an American Express Rewards Checking account, please visit \u003ca class='text-underline' href='https://www.americanexpress.com/en-us/banking/checking-account/' target='_blank'\u003eamericanexpress.com/rewardschecking\u003c/a\u003e.\"]],[\"^ \",\"question\",\"What is the difference between Individual and Joint Accounts?\",\"answer\",[\"An Individual Account is an account in the name of one person. A Joint Account with Right of Survivorship (and not as Tenants in Common) is an account in the name of two persons. Each account holder intends that when they die, the balance in the account (subject to any previous pledge to which we have agreed) will belong to the survivor.\",\"\u003cbr\u003ePlease note: The interest earned on the account will be reported to the IRS under the Social Security number of the primary (first named) account holder. Each joint account holder has equal access to the Joint Account but does not have access to online tax forms. American Express National Bank may act on instructions and notices we receive from any one joint account holder.\"]],[\"^ \",\"question\",\"What is the difference between Interest Rate and APY?\",\"answer\",[\"Interest Rate is the annualized rate applied to the principal balance of the account each day in order to determine the amount of interest that has accrued on that day’s principal balance. Annual Percentage Yield (APY) reflects the effect of compounding frequency (Savings accounts are compounded daily) on the interest rate over a 365-day period.\",\"\u003cbr\u003eFor more information, please see the \u003ca class='text-underline' href='https://www.americanexpress.com/content/dam/amex/en-us/banking/personal-savings/deposit_account_agreement.pdf?extlink=US-Servicing-null-savingsdaa' target='_blank'\u003eConsumer Deposit Account Agreement and Savings Schedules\u003c/a\u003e for additional terms and conditions and Truth-In-Savings disclosures.\"]],[\"^ \",\"question\",\"How long does it usually take to transfer funds online?\",\"answer\",[\"The best method for transferring funds is typically by initiating an ACH transfer on the website of the bank where the funds are currently held. By doing this, you are pushing funds to the recipient bank. If you open a High Yield Savings Account (HYSA) with American Express, the fastest way to transfer your funds out HYSA and into another account would be by initiating the transfer on the American Express site. In many cases, you may qualify for express transfers that can appear as soon as the same day.\",\"\u003cbr\u003eHowever, if you chose to initiate an ACH transfer with the bank where you want funds to arrive, you would then be pulling funds. If the recipient bank is American Express National Bank and you initiated the transfer on the American Express website, the amount will be reflected in your Current Balance and will begin earning interest immediately. For more information about funds availability and withdrawal timing, please see the \u003ca class='text-underline' href='https://www.americanexpress.com/content/dam/amex/en-us/banking/personal-savings/deposit_terms.pdf' target='_blank'\u003eSavings Schedule and Deposit Account Agreement\u003c/a\u003e.\"]]],\"footer\",\"Have other questions? Get more answers by reviewing our full list of \",\"footerCTA\",[\"^ \",\"href\",\"https://www.americanexpress.com/en-us/banking/online-savings/support/?linknav=savings-nav-support\",\"text\",\"FAQs\",\"title\",\"FAQs link\",\"ariaLabel\",\"Link to FAQs page\",\"target\",\"_blank\",\"dtm\",[\"^ \",\"event\",[\"^ \",\"location\",\"FAQlist\"]]],\"disclaimerLinks\",[[\"^ \",\"href\",\"https://www.americanexpress.com/en-us/banking/legal-library/index.html?extlink=US-Web-null-depositslegal\",\"text\",\"Consumer Banking Legal Agreements\",\"ariaLabel\",\"Consumer Banking Legal Agreements\",\"target\",\"_blank\",\"iconName\",\"IconDocument\",\"dtm\",[\"^ \",\"event\",[\"^ \",\"location\",\"disclaimerLinks\"]]],[\"^ \",\"href\",\"https://www.americanexpress.com/en-us/banking/online-savings/support/printable-forms/?intlink=savingshysa-support-forms\",\"text\",\"Printable Forms\",\"ariaLabel\",\"Printable Forms\",\"target\",\"_blank\",\"iconName\",\"IconPrint\",\"dtm\",[\"^ \",\"event\",[\"^ \",\"location\",\"disclaimerLinks\"]]],[\"^ \",\"href\",\"https://www.americanexpress.com/en-us/banking/online-savings/contact-us/?intlink=savingshysa-support-contact\",\"text\",\"Contact Us\",\"ariaLabel\",\"Contact Us\",\"target\",\"_blank\",\"iconName\",\"IconTelephone\",\"dtm\",[\"^ \",\"event\",[\"^ \",\"location\",\"disclaimerLinks\"]]],[\"^ \",\"href\",\"https://www.americanexpress.com/en-us/banking/personal/savings/register/account-verification/identify?cancelUrl=https%3A%2F%2Fwww.americanexpress.com%2Fen-us%2Fbanking%2Fonline-savings%2Fhigh-yield-savings%2F\u0026submitUrl=%2Fen-us%2Fbanking%2Fpersonal%2Fsavings%2Fdashboard\",\"text\",\"Create Online Access\",\"ariaLabel\",\"Create Online Access\",\"target\",\"_blank\",\"iconName\",\"IconDesktop\",\"dtm\",[\"^ \",\"event\",[\"^ \",\"location\",\"disclaimerLinks\"]]]]],\"moreFromAmexModule\",[\"^ \",\"dtm\",[\"^ \",\"impression\",\"morefromamex\"],\"backgroundImage\",\"/Internet/Acquisition/US_en/AppContent/OneSite/personal-loans/More_From_Amex_Background.webp\",\"amexLogo\",[\"^ \",\"altText\",\"\",\"breakpoints\",[\"^ \",\"lg\",\"/Internet/Acquisition/US_en/AppContent/OneSite/consumer-checking/amex-logo-desktop.png\",\"md\",\"/Internet/Acquisition/US_en/AppContent/OneSite/consumer-checking/amex-logo-tablet.png\",\"sm\",\"/Internet/Acquisition/US_en/AppContent/OneSite/consumer-checking/amex-logo-mobile.png\"]],\"header\",\"More From American Express\",\"moduleData\",[[\"^ \",\"tagCheckingEep\",true,\"checking_default\",\"83053\",\"ctaText\",\"Explore Rewards Checking\",\"ctaType\",\"personalcards\",\"ctaUrlPath\",\"https://www.americanexpress.com/en-us/banking/checking-account/\",\"headerText\",\"Earn $300 with a new Amex® Rewards Checking Account\",\"headerText_var_a\",\"Amex® Rewards Checking - Reliable Customer Support\",\"headerText_var_b\",\"Amex® Rewards Checking - Manage Your Accounts in One Place\",\"occupyFullRow\",true,\"bodyText\",\"After qualifying actions. Terms and eligibility apply. American Express National Bank. Member FDIC. \",\"dtmText\",\"explorecreditcards\",\"dtm\",[\"^ \",\"event\",[\"^ \",\"ctaType\",\"explorechecking\",\"location\",\"morefromamex\"],\"intLink\",[\"^ \",\"ctaType\",\"amexsavings\",\"location\",\"morefromamex\"]],\"image\",[\"^ \",\"altText\",\"\",\"breakpoints\",[\"^ \",\"lg\",\"/Internet/Acquisition/US_en/AppContent/OneSite/hysa/uplift/mfa-checking-desktop.png\",\"md\",\"/Internet/Acquisition/US_en/AppContent/OneSite/hysa/uplift/mfa-checking-desktop.png\",\"sm\",\"/Internet/Acquisition/US_en/AppContent/OneSite/hysa/uplift/mfa-checking-mobile.png\"]]],[\"^ \",\"ctaText\",\"Explore Savings\",\"ctaType\",\"amexsavings\",\"ctaUrlPath\",\"https://www.americanexpress.com/en-us/banking/online-savings/cd-account/\",\"shouldSkipIntLinkWithLinkNav\",false,\"headerText\",\"Certificate of Deposit (CD)\",\"bodyText\",\"Earn interest with a Certificate of Deposit Account — and watch your money grow. Member FDIC. Terms apply. \",\"dtm\",[\"^ \",\"event\",[\"^ \",\"ctaType\",\"exploresavings\",\"location\",\"morefromamex\"],\"intLink\",[\"^ \",\"ctaType\",\"amexsavings\",\"location\",\"morefromamex\"]],\"image\",[\"^ \",\"altText\",\"\",\"breakpoints\",[\"^ \",\"lg\",\"/Internet/Acquisition/US_en/AppContent/OneSite/hysa/uplift/mfa-cd-desktop.png\",\"md\",\"/Internet/Acquisition/US_en/AppContent/OneSite/hysa/uplift/mfa-cd-tablet.png\",\"sm\",\"/Internet/Acquisition/US_en/AppContent/OneSite/hysa/uplift/mfa-cd-mobile.png\"]]],[\"^ \",\"ctaText\",\"Explore Credit Cards\",\"ctaType\",\"personalcards\",\"ctaUrlPath\",\"https://www.americanexpress.com/us/credit-cards/?inav=menu_cards_pc_viewallcards\",\"headerText\",\"Personal American Express® Cards\",\"bodyText\",\"View our selection of Cards and experience what it means to be backed by Amex. \",\"dtmText\",\"explorecreditcards\",\"dtm\",[\"^ \",\"event\",[\"^ \",\"ctaType\",\"explorecreditcards\"],\"intLink\",[\"^ \",\"ctaType\",\"personalcards\",\"location\",\"\"]],\"image\",[\"^ \",\"altText\",\"\",\"breakpoints\",[\"^ \",\"lg\",\"/Internet/Acquisition/US_en/AppContent/OneSite/hysa/uplift/mfa-cards-desktop.png\",\"md\",\"/Internet/Acquisition/US_en/AppContent/OneSite/hysa/uplift/mfa-cards-tablet.png\",\"sm\",\"/Internet/Acquisition/US_en/AppContent/OneSite/hysa/uplift/mfa-cards-mobile.png\"]]]]],\"legalDisclaimers\",[\"^ \",\"disclaimerLinks\",[[\"^ \",\"href\",\"https://www.americanexpress.com/content/dam/amex/en-us/banking/personal-savings/deposit_account_agreement.pdf?extlink=US-Servicing-null-savingsdaa\",\"text\",\"Deposit Account Agreement\",\"ariaLabel\",\"Deposit Account Agreement\",\"target\",\"_blank\",\"dtm\",[\"^ \",\"event\",[\"^ \",\"location\",\"disclaimerLinks\"]]],[\"^ \",\"href\",\"https://www.americanexpress.com/us/company/privacy-center/online-privacy-disclosures/\",\"text\",\"Privacy Statement\",\"ariaLabel\",\"Privacy Statement\",\"target\",\"_blank\",\"dtm\",[\"^ \",\"event\",[\"^ \",\"location\",\"disclaimerLinks\"]]],[\"^ \",\"href\",\"https://www.americanexpress.com/en-us/banking/online-savings/support/\",\"text\",\"Need Help?\",\"ariaLabel\",\"Need Help?\",\"target\",\"_blank\",\"dtm\",[\"^ \",\"event\",[\"^ \",\"location\",\"disclaimerLinks\"]]]]],\"disclosures\",[\"^ \",\"header\",\"\u003cb\u003eTerms and Conditions\u003c/b\u003e\",\"items\",[[\"^ \",\"content\",\"\u003csup\u003e1\u003c/sup\u003e The average savings account interest rate is based on the FDIC's published monthly National Rates and Rate Caps information for Savings deposit products. Visit the \u003ca class='text-underline' title='FDIC website' href='https://www.fdic.gov/national-rates-and-rate-caps' target='_blank'\u003eFDIC website\u003c/a\u003e for details.\"],[\"^ \",\"content\",\"\u003csup\u003e2\u003c/sup\u003e The Annual Percentage Yield (APY) as advertised is accurate as of {{todaysDate}}. Interest rate and APY are subject to change at any time without notice before and after a High Yield Savings Account is opened.\"],[\"^ \",\"content\",\"\u003csup\u003e3\u003c/sup\u003e The national rate referenced is from the FDIC's published monthly National Rates and Rate Caps information for Savings deposit products in the $0–$2,500 deposit tier. Visit the \u003ca class='text-underline' title='FDIC website' href='https://www.fdic.gov/national-rates-and-rate-caps' target='_blank'\u003eFDIC website\u003c/a\u003e for details.\"],[\"^ \",\"content\",\"\u003csup\u003e4\u003c/sup\u003e There is no minimum balance required to open your Account, to avoid being charged a fee, or obtain the Annual Percentage Yield (APY) disclosed to you.\"],[\"^ \",\"content\",\"\u003csup\u003e5\u003c/sup\u003e Calculations are estimates of expected interest earned. Actual results may vary, based on various factors such as leap years, timing of deposits, rounding, and variation in interest rates. The first recurring deposit is assumed to begin in the second period after any initial deposit.\"],[\"^ \",\"content\",\"\u003csup\u003e6\u003c/sup\u003e Mobile Check Deposit is subject to deposit limits and other restrictions, which may change in the future. Please see the American Express\u003csup\u003e®\u003c/sup\u003e Savings Mobile Deposit Agreement at \u003ca class='text-underline' href='https://go.amex/savingsmcdterms' target='_blank'\u003ehttps://go.amex/savingsmcdterms\u003c/a\u003e for details and for information about when funds deposited through Mobile Check Deposit are made available. Mobile data rates may apply.\"],[\"^ \",\"content\",\"\u003csup\u003e7\u003c/sup\u003e For purposes of transferring funds to or from an external bank, business days are Monday through Friday, excluding federal holidays. Transfers can be initiated 24/7 digitally or may be made by phone (transfers are not available by phone between 7:00 PM and 11:59 PM), but any transfers initiated after 7:00 PM Eastern Time or on non-business days will begin processing on the next business day. Funds deposited into your account may be subject to holds. See the Funds Availability section of your Consumer Deposit Account Agreement and Savings Schedules for more information.\"],[\"^ \",\"content\",\"\u003csup\u003e8\u003c/sup\u003e The American Express\u003csup\u003e®\u003c/sup\u003e App and app features are available only for eligible accounts in the United States. American Express\u003csup\u003e®\u003c/sup\u003e prepaid Cards and Cards issued by non-American Express issuers are not eligible. To log in, customers must have an American Express user ID and password or create one in the app.\"]]],\"reinforcementBanner\",[\"^ \",\"dtm\",[\"^ \",\"impression\",\"reinforcementbanner\"],\"backgroundImage\",\"Internet/Acquisition/US_en/AppContent/OneSite/personal-loans/reinforcement-banner.svg\",\"body\",\"Let’s start looking ahead. Your interest earnings are waiting.\",\"ctas\",[[\"^ \",\"Component\",\"a\",\"$type\",\"secondary\",\"urlPath\",\"/en-us/banking/personal/savings/apply/psa-begin?product=highYieldSavings\",\"text\",\"Open an Account\",\"shouldSkipEEP\",false,\"dtm\",[\"^ \",\"event\",[\"^ \",\"location\",\"reinforcementbanner\",\"ctaType\",\"openanaccount\"],\"intLink\",[\"^ \",\"ctaType\",\"openanaccount\",\"location\",\"reinforcementbanner\"]]]]],\"subNav\",[\"^ \",\"header\",\"Savings\",\"cta\",[\"^ \",\"text\",\"Open an Account\",\"url\",\"/en-us/banking/personal/savings/apply/psa-begin?product=highYieldSavings\u0026intlink=us-acq-shop-consumer-saving-HYSA-openanaccount-subnav\",\"dtmName\",\"openanaccount\",\"shouldSkipEEP\",false],\"navLinks\",[[\"^ \",\"text\",\"High Yield Savings\",\"url\",\"/en-us/banking/online-savings/high-yield-savings-account/?linknav=savings-nav-hysa\",\"iconName\",\"savings\",\"id\",\"highYieldSavings\",\"dtmName\",\"HYSA\"],[\"^ \",\"text\",\"CDs\",\"url\",\"https://www.americanexpress.com/en-us/banking/online-savings/cd/?linknav=savings-nav-cd\",\"iconName\",\"cd\",\"id\",\"cds\",\"dtmName\",\"CDs\"],[\"^ \",\"text\",\"Support\",\"url\",\"https://www.americanexpress.com/en-us/banking/online-savings/support/?linknav=savings-nav-support\",\"iconName\",\"help\",\"id\",\"support\",\"dtmName\",\"support\"]]],\"calculator\",[\"^ \",\"maxInputtedAmount\",5000000,\"header\",\"Calculate how much you may save based on today's rates.\",\"body\",\"\",\"initialDepositInput\",\"Initial Deposit Amount\",\"initialDepositInputDisclaimer\",\"No minimum balance required\",\"totalEstimatedBalance\",\"Total estimated balance after {{yearsLabel}}\",\"potentialInterestText\",\"Potential interest earned using today's rates. Rates are variable and can change at any time.\",\"americanExpressText\",\"American Express:\",\"ariaLabelForGraphs\",\"Your potential interest earned after {{years}} years with {{apy}} apy is {{interestEarned}} \",\"nationalAverageText\",\"National Average:\",\"fedApyText\",\"{{apy}}% APY³ as of 09/2026\",\"amexApyText\",\"{{apy}}% APY²\",\"yearsLabelMap\",[[\"^ \",\"label\",\"1 year\",\"termLengthInMonths\",12],[\"^ \",\"label\",\"3 years\",\"termLengthInMonths\",36],[\"^ \",\"label\",\"5 years\",\"termLengthInMonths\",60]],\"fedRate\",0.37,\"dtm\",[\"^ \",\"impression\",\"calculator\",\"event\",[\"^ \",\"location\",\"calculator\",\"ctaType\",\"initialDeposit\"]],\"ctas\",[[\"^ \",\"Component\",\"a\",\"$type\",\"secondary\",\"urlPath\",\"/en-us/banking/personal/savings/apply/psa-begin?product=highYieldSavings\",\"shouldSkipEEP\",false,\"text\",\"Open an Account\",\"dtm\",[\"^ \",\"event\",[\"^ \",\"location\",\"Calculator\",\"ctaType\",\"openanaccount\"],\"intLink\",[\"^ \",\"ctaType\",\"openanaccount\",\"location\",\"calculator\"]]]],\"disclaimerText\",\"Interest compounds daily. Savings calculator is for illustration only⁵\"],\"keyBenefits\",[\"^ \",\"dtm\",[\"^ \",\"impression\",\"featuredBenefits\"],\"headerText\",[\"^ \",\"apyText\",\"{{apy}}% APY²\"],\"benefits\",[[\"^ \",\"iconName\",\"IconHighYield\",\"header\",\"Competitive APY\",\"content\",\"6x higher than the national rate\u003csup\u003e3\u003csup\u003e\"],[\"^ \",\"iconName\",\"IconRecurringInterest\",\"header\",\"Earns Daily Interest\",\"content\",\"Interest is compounded daily and credited to your account monthly\"],[\"^ \",\"iconName\",\"IconNoFee\",\"header\",\"No Monthly Fees\u003csup\u003e4\u003c/sup\u003e\",\"content\",\"No fee to open, no minimum deposit, and no monthly fees\"],[\"^ \",\"iconName\",\"IconRoundTheClock\",\"header\",\"24/7 Customer Support\",\"content\",\"Bank confidently with world-class customer service from American Express\"]]],\"offerBanner\",[\"^ \",\"dtm\",[\"^ \",\"impression\",\"offerbanner\"]],\"heroBanner\",[\"^ \",\"header\",\"Grow your money with a\u0026nbsp;High\u0026nbsp;Yield\u0026nbsp;Savings Account\",\"body\",\"Earn more interest than your average savings account and enjoy the convenience you expect from American Express.\u003csup\u003e1\u003c/sup\u003e\",\"backgroundImage\",null,\"FDICDisclaimer\",[\"^ \",\"logo\",[\"^ \",\"src\",\"/Internet/Acquisition/US_en/AppContent/OneSite/Data/SVG/banking/fdic-logo.svg\",\"altText\",\"FDIC Logo.\"],\"text\",\"FDIC-Insured - Backed by the full faith and credit of the U.S. Government.\"],\"callToActionWithLinkProps\",[\"^ \",\"ctas\",[[\"^ \",\"Component\",\"a\",\"$type\",\"Type.Primary\",\"urlPath\",\"/en-us/banking/personal/savings/apply/psa-begin?product=highYieldSavings\",\"shouldSkipEEP\",false,\"text\",\"Open an Account\",\"dtm\",[\"^ \",\"event\",[\"^ \",\"location\",\"HeroBanner\",\"ctaType\",\"openanaccount\"],\"intLink\",[\"^ \",\"ctaType\",\"openanaccount\",\"location\",\"hero\"]]]],\"contentAfterCTAText\",\"\"]],\"tiles\",[\"^ \",\"tileData\",[[\"^ \",\"content\",[\"^ \",\"cardImages\",[\"^ \",\"altText\",\"\",\"breakpoints\",[\"^ \",\"sm\",[\"^ \",\"1x\",\"/Internet/Acquisition/US_en/AppContent/OneSite/hysa/uplift/basic-mobile.png\",\"2x\",\"/Internet/Acquisition/US_en/AppContent/OneSite/hysa/uplift/basic-mobile.png\"],\"md\",[\"^ \",\"1x\",\"/Internet/Acquisition/US_en/AppContent/OneSite/hysa/uplift/basic-tablet.png\",\"2x\",\"/Internet/Acquisition/US_en/AppContent/OneSite/hysa/uplift/basic-tablet.png\"],\"lg\",[\"^ \",\"1x\",\"/Internet/Acquisition/US_en/AppContent/OneSite/hysa/uplift/basic-desktop.png\",\"2x\",\"/Internet/Acquisition/US_en/AppContent/OneSite/hysa/uplift/basic-desktop.png\"],\"xl\",[\"^ \",\"1x\",\"/Internet/Acquisition/US_en/AppContent/OneSite/hysa/uplift/basic-desktop.png\",\"2x\",\"/Internet/Acquisition/US_en/AppContent/OneSite/hysa/uplift/basic-desktop.png\"]]],\"title\",\"The Basics of High Yield Savings Accounts\",\"bulletPoints\",[[\"^ \",\"text\",\"A high-yield savings account (HYSA) generally offers higher interest rates than traditional savings accounts. They combine the flexibility of regular deposits and withdrawals with the benefit of earning more on your savings. Learn more about saving with a HYSA account. \u003ca class='text-underline' href='https://www.americanexpress.com/en-us/banking/online-savings/articles/all-about-high-yield-savings/?intlink=us-acq-shop-consumer-saving-HYSA-learnmore' target='_blank' aria-label='Learn more about The Basics of the High-Yield Savings Accounts'\u003eLearn More\u003c/a\u003e\"]]],\"imagePosition\",\"left\",\"dtm\",[\"^ \",\"impression\",\"learnmore\"]],[\"^ \",\"content\",[\"^ \",\"cardImages\",[\"^ \",\"altText\",\"QR code to download the Amex App\",\"breakpoints\",[\"^ \",\"sm\",[\"^ \",\"1x\",\"/Internet/Acquisition/US_en/AppContent/OneSite/hysa/uplift/access-your-account-on-the-go-mobile-appstore.png\",\"2x\",\"/Internet/Acquisition/US_en/AppContent/OneSite/hysa/uplift/access-your-account-on-the-go-mobile-appstore.png\"],\"md\",[\"^ \",\"1x\",\"/Internet/Acquisition/US_en/AppContent/OneSite/hysa/uplift/access-your-account-on-the-go-tablet-qr.png\",\"2x\",\"/Internet/Acquisition/US_en/AppContent/OneSite/hysa/uplift/access-your-account-on-the-go-tablet-qr.png\"],\"lg\",[\"^ \",\"1x\",\"/Internet/Acquisition/US_en/AppContent/OneSite/hysa/uplift/access-your-account-on-the-go-desktop-qr.png\",\"2x\",\"/Internet/Acquisition/US_en/AppContent/OneSite/hysa/uplift/access-your-account-on-the-go-desktop-qr.png\"],\"xl\",[\"^ \",\"1x\",\"/Internet/Acquisition/US_en/AppContent/OneSite/hysa/uplift/access-your-account-on-the-go-desktop-qr.png\",\"2x\",\"/Internet/Acquisition/US_en/AppContent/OneSite/hysa/uplift/access-your-account-on-the-go-desktop-qr.png\"]]],\"title\",\"Access your Account On the Go\",\"bulletPoints\",[[\"^ \",\"text\",\"{{deviceDependentText}} on your mobile device.⁸ Seamlessly manage all your personal American Express\u003csup\u003e®\u003c/sup\u003e Card and Amex bank accounts on the go.\"]],\"deviceDependentText\",[\"^ \",\"lg\",\"Scan the QR code to download the award-winning\u003c/br\u003e American Express\u003csup\u003e®\u003c/sup\u003e App\",\"md\",\"Scan the QR code to download the award-winning American Express\u003csup\u003e®\u003c/sup\u003e App\",\"sm\",\"Download the award-winning American Express\u003csup\u003e®\u003c/sup\u003e App\"]],\"downloadButton\",[\"^ \",\"href\",\"http://m.amex/hhDLF7?dotamexclicksource=qr\",\"position\",\"bottom-left\"],\"imagePosition\",\"left\",\"dtm\",[\"^ \",\"impression\",\"accountonthego\"],\"disclaimerText\",[\"^ \",\"iphone\",\"Apple and the Apple logo are trademarks of Apple Inc., registered in the U.S. and other countries. App Store is a service mark of Apple Inc.\",\"android\",\"Google Play and the Google Play logo are trademarks of Google LLC.\"]]]],\"threeStepsBanner\",[\"^ \",\"mainHeader\",\"Apply for an Account in minutes\",\"bannerData\",[[\"^ \",\"header\",\"Complete an Application\",\"description\",\"\u003cbr\u003eand we'll verify your identity – you'll receive a confirmation email when your Account is approved and opened.\"],[\"^ \",\"header\",\"Register your online account\",\"description\",\"\u003cbr\u003eafter you receive your confirmation email.\"],[\"^ \",\"header\",\"Sign in and fund your new Account\",\"description\",\"\u003cbr\u003eby depositing a check using your mobile phone⁶, transferring funds from an American Express\u003csup\u003e®\u003c/sup\u003e Rewards Checking account or linking to your current bank⁷. Linking an external account can take up to two days. Or you may also mail a check.\"]],\"disclaimerText\",\"See \u003ca class='text-underline' href='https://www.americanexpress.com/en-us/banking/online-savings/support/?linknav=savings-nav-support' target='_blank'\u003eFAQs\u003c/a\u003e for further details about the transfer process, or \u003ca class='text-underline' href='https://www.americanexpress.com/en-us/banking/online-savings/contact-us/?intlink=savingshysa-startbanking-contact' target='_blank'\u003econtact us 24/7\u003c/a\u003e with questions.\",\"image\",[\"^ \",\"altText\",\"\",\"breakpoints\",[\"^ \",\"lg\",\"/Internet/Acquisition/US_en/AppContent/OneSite/hysa/uplift/2-steps-desktop.png\",\"md\",\"/Internet/Acquisition/US_en/AppContent/OneSite/hysa/uplift/2-steps-tablet.png\",\"sm\",\"/Internet/Acquisition/US_en/AppContent/OneSite/hysa/uplift/2-steps-mobile.png\"]],\"ctaData\",[\"^ \",\"text\",\"Open an Account\",\"urlPath\",\"/en-us/banking/personal/savings/apply/psa-begin?product=highYieldSavings\",\"shouldSkipEEP\",false,\"dtm\",[\"^ \",\"impression\",\"openanaccount\",\"event\",[\"^ \",\"location\",\"threeStep\",\"ctaType\",\"openanaccount\"],\"intLink\",[\"^ \",\"ctaType\",\"openanaccount\",\"location\",\"howtoopenanaccount\"]]]],\"fdicBanner\",[\"^ \",\"disclaimerText\",\"Accounts offered by American Express National Bank. Member FDIC.\",\"insuredText\",\"FDIC-Insured - Backed by the full faith and credit of the U.S.\u0026nbsp;Government.\"],\"seo\",[\"^ \",\"title\",\"High Yield Savings Account Online with no Fees | Amex US\",\"description\",\"Maximize Your Savings with an American Express High Yield Savings Account. Featuring Competitive Interest Rates \u0026 No Fees. Open an Account Today!\",\"canonical\",\"https://www.americanexpress.com/en-us/banking/online-savings/high-yield-savings-account/\",\"additionalMetaTags\",[[\"^ \",\"type\",\"property\",\"value\",\"og:title\",\"content\",\"High Yield Savings Account Online with No Fees | Amex US\"],[\"^ \",\"type\",\"property\",\"value\",\"og:description\",\"content\",\"Maximize Your Savings with an American Express High Yield Savings Account. Featuring Competitive Interest Rates \u0026 No Fees. Open an Account Today!\"],[\"^ \",\"type\",\"property\",\"value\",\"og:url\",\"content\",\"https://www.americanexpress.com/en-us/banking/online-savings/high-yield-savings-account/\"],[\"^ \",\"type\",\"property\",\"value\",\"og:image\",\"content\",\"https://icm.aexp-static.com/Internet/Acquisition/US_en/AppContent/OneSite/hysa/HYSA_OG.png\"],[\"^ \",\"type\",\"name\",\"value\",\"twitter:card\",\"content\",\"summary\"],[\"^ \",\"type\",\"name\",\"value\",\"twitter:title\",\"content\",\"High Yield Savings Account Online with No Fees | Amex US\"],[\"^ \",\"type\",\"name\",\"value\",\"twitter:description\",\"content\",\"Maximize Your Savings with an American Express High Yield Savings Account. Featuring Competitive Interest Rates \u0026 No Fees. Open an Account Today!\"],[\"^ \",\"type\",\"name\",\"value\",\"twitter:image\",\"content\",\"https://icm.aexp-static.com/Internet/Acquisition/US_en/AppContent/OneSite/hysa/HYSA_Twitter.png\"]],\"tags\",[[\"^ \",\"@context\",\"https://schema.org/\",\"@type\",\"BreadcrumbList\",\"itemListElement\",[[\"^ \",\"@type\",\"ListItem\",\"position\",1,\"name\",\"Home\",\"item\",\"https://www.americanexpress.com/\"],[\"^ \",\"@type\",\"ListItem\",\"position\",2,\"name\",\"Savings\",\"item\",\"https://www.americanexpress.com/en-us/banking/online-savings/account/\"],[\"^ \",\"@type\",\"ListItem\",\"position\",3,\"name\",\"High Yield Savings\",\"item\",\"https://www.americanexpress.com/en-us/banking/online-savings/high-yield-savings-account/\"]]],[\"^ \",\"@context\",\"https://schema.org\",\"@type\",\"FinancialProduct\",\"name\",\"American Express High Yield Savings Account\",\"description\",\"A savings account offering competitive interest rates with no monthly fees and daily compounded interest.\",\"feesAndCommissionsSpecification\",\"No monthly fees, no minimum balance required.\",\"provider\",[\"^ \",\"@type\",\"FinancialService\",\"name\",\"American Express National Bank\",\"url\",\"https://www.americanexpress.com/en-us/banking/online-savings/high-yield-savings-account/\"],\"termsOfService\",\"https://www.americanexpress.com/content/dam/amex/en-us/banking/personal-savings/deposit_account_agreement.pdf\"],[\"^ \",\"@context\",\"https://schema.org\",\"@type\",\"FAQPage\",\"mainEntity\",[[\"^ \",\"@type\",\"Question\",\"name\",\"What is an American Express High Yield Savings Account (HYSA)?\",\"acceptedAnswer\",[\"^ \",\"@type\",\"Answer\",\"text\",\"The American Express High Yield Savings Account is a savings account with a variable interest rate. Interest on our HYSA is compounded daily and posted to accounts monthly.\"]],[\"^ \",\"@type\",\"Question\",\"name\",\"Do I get an ATM card, a debit card, or checks when I open an American Express HYSA?\",\"acceptedAnswer\",[\"^ \",\"@type\",\"Answer\",\"text\",\"Savings accounts are not meant for everyday spending. ATM cards, debit cards, or checks are not provided. However, for your everyday spending needs, you may be eligible for an American Express\u003csup\u003e®\u003c/sup\u003e Rewards Checking account. Additional terms and eligibility apply. To learn more about an American Express Rewards Checking account, please visit \u003ca class='text-underline' href='https://www.americanexpress.com/en-us/banking/checking-account/' target='_blank'\u003eamericanexpress.com/rewardschecking\u003c/a\u003e.\"]],[\"^ \",\"@type\",\"Question\",\"name\",\"What is the difference between Individual and Joint Accounts?\",\"acceptedAnswer\",[\"^ \",\"@type\",\"Answer\",\"text\",\"An Individual Account is an account in the name of one person. A Joint Account with Right of Survivorship (and not as Tenants in Common) is an account in the name of two persons. Each account holder intends that when they die, the balance in the account (subject to any previous pledge to which we have agreed) will belong to the survivor.\u003cbr\u003ePlease note: The interest earned on the account will be reported to the IRS under the Social Security number of the primary (first named) account holder. Each joint account holder has equal access to the Joint Account but does not have access to online tax forms. American Express National Bank may act on instructions and notices we receive from any one joint account holder.\"]],[\"^ \",\"@type\",\"Question\",\"name\",\"What is the difference between Interest Rate and APY?\",\"acceptedAnswer\",[\"^ \",\"@type\",\"Answer\",\"text\",\"Interest Rate is the annualized rate applied to the principal balance of the account each day in order to determine the amount of interest that has accrued on that day’s principal balance. Annual Percentage Yield (APY) reflects the effect of compounding frequency (Savings accounts are compounded daily) on the interest rate over a 365-day period.\u003cbr\u003eFor more information, please see the \u003ca class='text-underline' href='https://www.americanexpress.com/content/dam/amex/en-us/banking/personal-savings/deposit_account_agreement.pdf?extlink=US-Servicing-null-savingsdaa' target='_blank'\u003eConsumer Deposit Account Agreement and Savings Schedules\u003c/a\u003e for additional terms and conditions and Truth-In-Savings disclosures.\"]],[\"^ \",\"@type\",\"Question\",\"name\",\"How long does it usually take to transfer funds online?\",\"acceptedAnswer\",[\"^ \",\"@type\",\"Answer\",\"text\",\"The best method for transferring funds is typically by initiating an ACH transfer on the website of the bank where the funds are currently held. By doing this, you are pushing funds to the recipient bank. If you open a High Yield Savings Account (HYSA) with American Express, the fastest way to transfer your funds out HYSA and into another account would be by initiating the transfer on the American Express site. In many cases, you may qualify for express transfers that can appear as soon as the same day.\u003cbr\u003eHowever, if you chose to initiate an ACH transfer with the bank where you want funds to arrive, you would then be pulling funds. If the recipient bank is American Express National Bank and you initiated the transfer on the American Express website, the amount will be reflected in your Current Balance and will begin earning interest immediately. For more information about funds availability and withdrawal timing, please see the \u003ca class='text-underline' href='https://www.americanexpress.com/content/dam/amex/en-us/banking/personal-savings/deposit_terms.pdf' target='_blank'\u003eSavings Schedule and Deposit Account Agreement\u003c/a\u003e.\"]]]]]]],\"ok\",true,\"headers\",[\"^ \",\"access-control-max-age\",\"3000000\",\"cache-control\",\"no-store, no-cache, must-revalidate, proxy-revalidate\",\"connection\",\"close\",\"content-encoding\",\"gzip\",\"content-type\",\"application/json; charset=utf-8\",\"date\",\"Fri, 09 Oct 2026 02:13:07 GMT\",\"expires\",\"0\",\"pragma\",\"no-cache\",\"server-timing\",\", VTO;dur=1149;desc=VTO\",\"set-cookie\",\"SaneID=148.173.89.129-1791511987105561; Domain=americanexpress.com; Path=/, acq_journey_id=8c918835-cb55-49d5-87d4-82d1f4c9e7b9; Domain=americanexpress.com; Path=/; HttpOnly; Secure; SameSite=Lax, pznid=45619693616496521460774969819859046398%7C9; Domain=americanexpress.com; Path=/; Expires=Tue, 09 Nov 2027 02:13:07 GMT, CARDSHOP_SESS=s%3Af555d3cc-b502-4cbe-bdba-a6a4c1d32d46.isCTPRtR%2FqbyHJ2lKGjJAOT8Ktt46YEpFlTIaLgxyrA; Domain=americanexpress.com; Path=/; HttpOnly; Secure, TS01a91ed4=01368b54317ca934d855219f4ec35ccbf871cfd4e333d9a273dccc45080211db516df9e1a53fb53a93a1a45723ca1b715d4025834b; Path=/; Domain=.americanexpress.com\",\"strict-transport-security\",\"max-age=31536000; includeSubDomains\",\"surrogate-control\",\"no-store\",\"transfer-encoding\",\"chunked\",\"vary\",\"Accept-Encoding\",\"x-aexp-build\",\"37869111053\",\"x-aexp-timestamp\",\"2026-10-09 01:20:47\",\"x-content-type-options\",\"nosniff\",\"x-download-options\",\"noopen\",\"x-frame-options\",\"ALLOW-FROM\",\"x-trace-id\",\"11d840712394375bb3410adc3d6de560\",\"x-xss-protection\",\"1; mode=block\"],\"status\",200]]]]],\"products\",[\"~#iM\",[\"registry\",[\"~#iM\",[\"loading\",null,\"loaded\",false,\"cardError\",null,\"customerError\",null,\"types\",[\"~#iM\",[]]]],\"details\",[\"~#iM\",[\"loading\",[\"~#iM\",[]],\"errors\",[\"~#iM\",[]],\"types\",[\"~#iM\",[]]]],\"injectedCardData\",