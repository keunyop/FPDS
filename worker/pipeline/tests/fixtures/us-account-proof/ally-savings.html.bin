"aria-hidden\":false,\"className\":\"styles_svgIcon__UoR7M\",\"width\":25,\"height\":25,\"xmlns\":\"http://www.w3.org/2000/svg\",\"children\":[[\"$\",\"title\",null,{\"children\":\"Facebook Logo\"}],[\"$\",\"image\",null,{\"href\":\"//secure.ally.com/acs/content/cms/images/201178/kihwedicfgkh/2LMJ9WlZiWU6OtQCRqbvob/9dd16b86bb0714fae4fac09e800eee3b/Facebook_Logo__1_.svg\",\"width\":25,\"height\":25}]]}],\"$undefined\"]}],[\"$\",\"a\",\"Thirdparty: TikTok\",{\"className\":\"Link_link__JHJ4m Link_-underline__lnWRl Link_-inline__GtMVe\",\"data-allytmln\":\"TikTok\",\"href\":\"https://www.tiktok.com/@allydoitright\",\"onClick\":\"$undefined\",\"target\":\"_blank\",\"aria-describedby\":\"$undefined\",\"aria-label\":\"TikTok\",\"ref\":\"$undefined\",\"data-testid\":\"$undefined\",\"role\":\"$undefined\",\"data-target-id\":\"$undefined\",\"children\":[\"$undefined\",[\"$\",\"svg\",\"svgIcon-1P0blWg1zAtdEeZE8dWmnw-0\",{\"aria-hidden\":false,\"className\":\"styles_svgIcon__UoR7M\",\"width\":25,\"height\":25,\"xmlns\":\"http://www.w3.org/2000/svg\",\"children\":[[\"$\",\"title\",null,{\"children\":\"TikTok Logo\"}],[\"$\",\"image\",null,{\"href\":\"//secure.ally.com/acs/content/cms/images/201178/kihwedicfgkh/5aEepFh5wRw9EuOGrlb1WR/f901a559b3287968cf8a4de7c240cd17/TikTok_Logo__1_.svg\",\"width\":25,\"height\":25}]]}],\"$undefined\"]}]]}],[\"$\",\"div\",null,{\"className\":\"styles_additionalLinks__mLHCT\",\"children\":[[\"$\",\"div\",\"About\",{\"className\":\"styles_linkGroup___iVE4\",\"children\":[[\"$\",\"span\",null,{\"id\":\"footer-linkGroup-label-about\",\"className\":\"Text_body-sm__UmmDO styles_heading__ys_XI styles_footerHeading__YhuFM\",\"tabIndex\":-1,\"children\":\"About\"}],\"$L3f\"]}],\"$L40\",\"$L41\",\"$L42\",\"$L43\"]}],\"$L44\",\"$L45\"]}]\n46:Te9f,[{\"@context\":\"https://schema.org\",\"@type\":\"DepositAccount\",\"name\":\"Savings Account\",\"provider\":{\"@type\":\"Organization\",\"name\":\"Ally Bank\",\"url\":\"https://www.ally.com/bank/\"},\"url\":\"https://www.ally.com/bank/online-savings-account/\",\"mainEntityOfPage\":\"https://www.ally.com/bank/online-savings-account/\"},{\"@context\":\"https://schema.org\",\"@type\":\"BreadcrumbList\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Savings\",\"item\":\"https://www.ally.com/bank/savings-account-rates\"}]},{\"@context\":\"https://schema.org\",\"@type\":\"FAQPage\",\"mainEntity\":[{\"@type\":\"Question\",\"name\":\"How do I add money to my account?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"\u003cp\u003eThere are several ways to add money to your account: \u003c/p\u003e\u003cp\u003e\u003cb\u003e1. Online transfers:\u003c/b\u003e You can transfer money from another Ally account or an account you have at another institution, right from our app. Select\u003cb\u003e Menu \u003c/b\u003eand then \u003cb\u003eLinked Accounts \u003c/b\u003eto link your accounts at other banks. \u003c/p\u003e\u003cp\u003e\u003cb\u003e2. Ally eCheck Deposit℠:\u003c/b\u003e You can deposit a check in our app with your phone’s camera. Make sure each check is properly endorsed with signatures of all payees. Also write \u003cb\u003eFor Mobile Deposit Only \u003c/b\u003eon the back. \u003c/p\u003e\u003cp\u003e\u003cb\u003e3. Wire transfer:\u003c/b\u003e If you want to wire money from an account you have at another institution, select \u003cb\u003eMenu \u003c/b\u003eand then choose\u003cb\u003e Wire Money.\u003c/b\u003e Then select \u003cb\u003eReceive a wire\u003c/b\u003e for more info on how you can wire from another financial institution into your Ally Bank account. \u003c/p\u003e\u003cp\u003e\u003cb\u003e4. Mail your check:\u003c/b\u003e Make sure each check is properly endorsed with signatures of all payees and include a deposit slip if you have one. Also write your account number and \u003cb\u003eFor Deposit Only \u003c/b\u003eon the back. Be sure to seal the envelope properly and mail it to us at: \u003c/p\u003e\u003cp\u003e     Ally Bank \\n     P.O. Box 13625 \\n     Philadelphia, PA \\n     19101-3625 \u003c/p\u003e\u003cp\u003e\u003cb\u003e5. Direct deposit:\u003c/b\u003e Head over to our \u003cb\u003edirect deposit setup page\u003c/b\u003e and set it up with your payment provider to automatically add money to your account every time you get paid. \u003c/p\u003e\u003cp\u003e\u003cb\u003e6. Add cash to a Spending Account: \u003c/b\u003eVisit a Walmart Money Center or customer service desk and show the associate your unique barcode to add cash. To get your barcode, log in to our app, go to\u003cb\u003e Menu \u003c/b\u003eand select\u003cb\u003e Add Cash\u003c/b\u003e.\u003c/p\u003e\"}},{\"@type\":\"Question\",\"name\":\"How many withdrawals can I make from my Savings Account each month?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"\u003cp\u003eYou can make 10 limited withdrawals and transfers per statement cycle from your Savings Account. There’s no fee for going over the limit, but we’ll close your account if you exceed it on more than an occasional basis.\u003c/p\u003e\"}},{\"@type\":\"Question\",\"name\":\"What's the difference between a savings account and money market account?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"\u003cp\u003eOur savings account includes buckets and boosters, designed to help you organize and optimize your savings. Like digital envelopes, savings buckets help you organize whatever you\u0026#39;re saving for without needing multiple accounts. Boosters like Surprise Savings and Round ups are money-saving tools to help you reach your goals faster.\u003c/p\u003e\u003cp\u003eOur money market account doesn\u0026#39;t have buckets and boosters, but does offer a debit card and checks.\u003c/p\u003e\"}},{\"@type\":\"Question\",\"name\":\"Can I change or convert a Savings Account to a Money Market account?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"\u003cp\u003eNo, because the two account types include different features, and utilize different ways of accessing funds. Instead, a new Money Market Account \u003ca href=\\\"https://secure.ally.com/open-account/?OAP=MMDA\\\"\u003emust be opened\u003c/a\u003e. Then, you can choose to keep both accounts, or request to close the account you no longer want.\u003c/p\u003e\"}}]}]29:[\"$\",\"script\",null,{\"type\":\"application/ld+json\",\"id\":\"ldjson\",\"children\":\"$46\"}]\n"])</script><script>self.__next_f.push([1,"47:I[59436,[\"7529\",\"static/chunks/0acea031-952d87345aa3ee22.js\",\"27\",\"static/chunks/49d9ad54-e88faf994f75241f.js\",\"3990\",\"static/chunks/883ee446-2e1e66f9aaf098c6.js\",\"437\",\"static/chunks/437-c83767f3bc7a1bae.js\",\"1062\",\"static/chunks/1062-9be3540c32cef396.js\",\"8500\",\"static/chunks/8500-74c368e06d70378e.js\",\"1050\",\"static/chunks/1050-b14a0d5b413966f1.js\",\"3035\",\"static/chunks/3035-755eb0f2fab4147a.js\",\"1724\",\"static/chunks/1724-8705b01c8bfd22f0.js\",\"4113\",\"static/chunks/4113-3e1d12f5563a4c44.js\",\"8089\",\"static/chunks/8089-67694491b1504387.js\",\"8554\",\"static/chunks/8554-04183da7668b78a9.js\",\"6036\",\"static/chunks/6036-d3638bca2959ce52.js\",\"982\",\"static/chunks/app/(pages)/%40main/%5B...slug%5D/page-b7f98a4676c9b610.js\"],\"default\"]\n48:I[15035,[\"7529\",\"static/chunks/0acea031-952d87345aa3ee22.js\",\"27\",\"static/chunks/49d9ad54-e88faf994f75241f.js\",\"3990\",\"static/chunks/883ee446-2e1e66f9aaf098c6.js\",\"437\",\"static/chunks/437-c83767f3bc7a1bae.js\",\"1062\",\"static/chunks/1062-9be3540c32cef396.js\",\"8500\",\"static/chunks/8500-74c368e06d70378e.js\",\"1050\",\"static/chunks/1050-b14a0d5b413966f1.js\",\"3035\",\"static/chunks/3035-755eb0f2fab4147a.js\",\"1724\",\"static/chunks/1724-8705b01c8bfd22f0.js\",\"4113\",\"static/chunks/4113-3e1d12f5563a4c44.js\",\"8089\",\"static/chunks/8089-67694491b1504387.js\",\"8554\",\"static/chunks/8554-04183da7668b78a9.js\",\"6036\",\"static/chunks/6036-d3638bca2959ce52.js\",\"982\",\"static/chunks/app/(pages)/%40main/%5B...slug%5D/page-b7f98a4676c9b610.js\"],\"default\"]\n4a:I[4