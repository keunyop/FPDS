ansform/eec38eb2-b171-4880-85f5-1090bb63174a/e9f57e70-extended-warranty-desktop?format=webp&amp;quality=100" type="image/webp"><source media="(max-width:767px)" srcset="https://www.bmo.com/dam_asset/transform/eec38eb2-b171-4880-85f5-1090bb63174a/e9f57e70-extended-warranty-desktop?format=webp&amp;quality=100" type="image/webp"><source media="(min-width:1268px)" srcset="https://www.bmo.com/dam_asset/transform/eec38eb2-b171-4880-85f5-1090bb63174a/e9f57e70-extended-warranty-desktop?format=jpg&amp;quality=100" type="image/jpeg"><source media="(min-width:1024px)" srcset="https://www.bmo.com/dam_asset/transform/eec38eb2-b171-4880-85f5-1090bb63174a/e9f57e70-extended-warranty-desktop?format=jpg&amp;quality=100" type="image/jpeg"><source media="(min-width:768px)" srcset="https://www.bmo.com/dam_asset/transform/eec38eb2-b171-4880-85f5-1090bb63174a/e9f57e70-extended-warranty-desktop?format=jpg&amp;quality=100" type="image/jpeg"><source media="(max-width:767px)" srcset="https://www.bmo.com/dam_asset/transform/eec38eb2-b171-4880-85f5-1090bb63174a/e9f57e70-extended-warranty-desktop?format=jpg&amp;quality=100" type="image/jpeg"><img loading="eager" class="primitive-image css-1rvhu3f e188sdvu0" src="https://www.bmo.com/dam_asset/transform/eec38eb2-b171-4880-85f5-1090bb63174a/e9f57e70-extended-warranty-desktop?format=jpg&amp;quality=100" alt=""></picture></div><div class="css-0 e1m1kb961"><div class="css-pxawwf e1m1kb966"><span class="css-1x3x2ym e5cyl7f0"><h3 class="css-0">Extended warranty</h3></span></div><div class="css-kaq1dv e1m1kb963"><span class="css-1x3x2ym e5cyl7f0"><p>We will double the original manufacturer’s (or <span><abbr>U.S.</abbr></span> store brand) warranty for up to an additional 12 months of coverage on most new items<sup><span class="css-wvkc32 e19opmff0">&nbsp;footnote 4&nbsp;</span><span aria-hidden="true">4</span></sup></p></span></div></div></li><li id="pers-4VzIHscfTaTbeBMxbujCWDCard-2-2" role="listitem" class="css-xan8j0 e1m1kb965"><div class="css-adf5d8 e1m1kb962"><picture data-testid="picture"><source media="(min-width:1268px)" srcset="https://www.bmo.com/dam_asset/transform/83dc2da8-a7ae-4175-b2da-5f6dbed4f734/33d8c5eb-roadside-assistance-desktop?format=webp&amp;quality=100" type="image/webp"><source media="(min-width:1024px)" srcset="https://www.bmo.com/dam_asset/transform/83dc2da8-a7ae-4175-b2da-5f6dbed4f734/33d8c5eb-roadside-assistance-desktop?format=webp&amp;quality=100" type="image/webp"><source media="(min-width:768px)" srcset="https://www.bmo.com/dam_asset/transform/83dc2da8-a7ae-4175-b2da-5f6dbed4f734/33d8c5eb-roadside-assistance-desktop?format=webp&amp;quality=100" type="image/webp"><source media="(max-width:767px)" srcset="https://www.bmo.com/dam_asset/transform/83dc2da8-a7ae-4175-b2da-5f6dbed4f734/33d8c5eb-roadside-assistance-desktop?format=webp&amp;quality=100" type="image/webp"><source media="(min-width:1268px)" srcset="https://www.bmo.com/dam_asset/transform/83dc2da8-a7ae-4175-b2da-5f6dbed4f734/33d8c5eb-roadside-assistance-desktop?format=jpg&amp;quality=100" type="image/jpeg"><source media="(min-width:1024px)" srcset="https://www.bmo.com/dam_asset/transform/83dc2da8-a7ae-4175-b2da-5f6dbed4f734/33d8c5eb-roadside-assistance-desktop?format=jpg&amp;quality=100" type="image/jpeg"><source media="(min-width:768px)" srcset="https://www.bmo.com/dam_asset/transform/83dc2da8-a7ae-4175-b2da-5f6dbed4f734/33d8c5eb-roadside-assistance-desktop?format=jpg&amp;quality=100" type="image/jpeg"><source media="(max-width:767px)" srcset="https://www.bmo.com/dam_asset/transform/83dc2da8-a7ae-4175-b2da-5f6dbed4f734/33d8c5eb-roadside-assistance-desktop?format=jpg&amp;quality=100" type="image/jpeg"><img loading="eager" class="primitive-image css-1rvhu3f e188sdvu0" src="https://www.bmo.com/dam_asset/transform/83dc2da8-a7ae-4175-b2da-5f6dbed4f734/33d8c5eb-roadside-assistance-desktop?format=jpg&amp;quality=100" alt=""></picture></div><div class="css-1nz0tfv e1m1kb961"><div class="css-pxawwf e1m1kb966"><span class="css-1x3x2ym e5cyl7f0"><h3 class="css-0">Enjoy the ride, worry-free</h3></span></div><div class="css-kaq1dv e1m1kb963"><span class="css-1x3x2ym e5cyl7f0"><p>With Master RoadAssist<sup class="css-129gw94 eyqmael1">®</sup> Roadside Service, get help with jump-starts, tire changes, towing and even gas delivery, whenever you need it.<sup><span class="css-wvkc32 e19opmff0">&nbsp;footnote 4&nbsp;</span><span aria-hidden="true">4</span></sup></p></span></div><a id="pers-4VzIHscfTaTbeBMxbujCWD-2-2" href="https://www.bmo.com/en-us/pdf/credit/consumermcgtb.pdf" aria-label="Access the Guide to benefits to learn more about RoadAssist (P D F,  498 K B), opens in a new tab" data-ana="learn more about roadassist--tiledynamic 3-rowdynamic-tilegriddynamictile" data-meta="learn more about roadassist--tiledynamic 3-rowdynamic-tilegriddynamictile" data-region="tileDynamic 3-rowDynamic-tileGridDynamicTile" target="_blank" class="css-qbalzt">Learn more about&nbsp;<span style="display:inline-flex">RoadAssist<img class="css-qzh2ym" height="16" width="16" src="https://www.bmo.com/dam_asset/asset/404aec6f-6ff4-42c4-bf97-c5abe8ce7883/baby-chevron-right-16.svg" alt="" loading="eager" data-testid="icon"></span></a></div></li></ul></div></div></div></section><section id="pers-2nshbYN5fZ96WTuP5YDRnj" data-region="ratesAndFeesUsDeposit" tabindex="-1" class="css-gywdsc e1jqivam3"><div class="css-18bgle7 e1jqivam0"><div data-testid="outerWrapper" data-sticky="false" class="css-hzomnp ev2g0gq0"><div id="pers-2nshbYN5fZ96WTuP5YDRnj-USRatesAndFees-innerWrapper" class="css-m9cszz ev2g0gq1"><div class="css-jvsx4c ev2g0gq2"><h2 class="css-0">Your rates at a glance</h2></div><ul id="pers-2nshbYN5fZ96WTuP5YDRnj-USRatesAndFees" role="list" class="css-1235xqx ev2g0gq5"><li id="pers-2nshbYN5fZ96WTuP5YDRnj-item-1-listItem" role="listitem" data-testid="ratesFeesCardContentWrapper" class="css-1b35khe ev2g0gq9"><div id="pers-2nshbYN5fZ96WTuP5YDRnj-item-1-listItem-heading" class="css-g9ix3a ev2g0gq10"><p>Annual Fee<span><span aria-hidden="true" class="css-0 enikfnm1">*</span><span class="css-v12mhn enikfnm0">Footnote star</span></span>​</p></div><div id="pers-2nshbYN5fZ96WTuP5YDRnj-item-1-listItem-content" class="css-1uodb52 ev2g0gq11"><p><a aria-label="zero dollar, Access the Summary of Credit Terms (P D F, 500 k b), opens in a new tab" data-meta="0--rte-item1value-ratesandfeesusdeposit" data-ana="0--rte-item1value-ratesandfeesusdeposit" href="https://www.bmo.com/en-us/pdf/credit/standardcreditcards.pdf" target="_blank" rel="noopener" data-rte="true">$0</a></p></div></li><li id="pers-2nshbYN5fZ96WTuP5YDRnj-item-2-listItem" role="listitem" data-testid="ratesFeesCardContentWrapper" class="css-1b35khe ev2g0gq9"><div id="pers-2nshbYN5fZ96WTuP5YDRnj-item-2-listItem-heading" class="css-g9ix3a ev2g0gq10"><p>Variable purchase APR<span><span aria-hidden="true" class="css-0 enikfnm1">*</span><span class="css-v12mhn enikfnm0">Footnote star</span></span>​</p></div><div id="pers-2nshbYN5fZ96WTuP5YDRnj-item-2-listItem-content" class="css-1uodb52 ev2g0gq11"><p><strong><span><span aria-hidden="true" class="css-0 enikfnm1">19.49% - 27.49%</span><span class="css-v12mhn enikfnm0">19.49% to 27.49%</span></span></strong>,</p><p class="typography-legal css-5hibg6">based on your creditworthiness</p></div></li><li id="pers-2nshbYN5fZ96WTuP5YDRnj-item-3-listItem" role="listitem" data-testid="ratesFeesCardContentWrapper" class="css-1b35khe ev2g0gq9"><div id="pers-2nshbYN5fZ96WTuP5YDRnj-item-3-listItem-heading" class="css-g9ix3a ev2g0gq10"><p>Balance transfer APR<span><span aria-hidden="true" class="css-0 enikfnm1">*</span><span class="css-v12mhn enikfnm0">Footnote star</span></span>​</p></div><div id="pers-2nshbYN5fZ96WTuP5YDRnj-item-3-listItem-content" class="css-1uodb52 ev2g0gq11"><p class="typography-legal css-5hibg6"><strong>0% introductory APR<sup><span class="css-wvkc32 e19opmff0">&nbsp;footnote 5&nbsp;</span><span aria-hidden="true">5</span></sup></strong>&nbsp;on balance transfers for <strong>12 months from date of first transfer when transfers </strong>are completed within 90 days from date of account opening. After that, a variable APR applies, currently&nbsp;<strong>19.49% - 27.49%</strong>, based on your creditworthiness.</p></div></li></ul><div class="css-msgj0t ev2g0gq6"><a id="pers-2nshbYN5fZ96WTuP5YDRnj-OpenNow-link" href="https://www.bmo.com/en-us/pdf/credit/standardcreditcards.pdf" aria-label="star, Access the summary of credit terms (P D F, 133 K B), opens in a new tab" data-ana="access credit terms--ratesandfeesusdeposit" data-meta="access credit terms--ratesandfeesusdeposit" data-region="ratesAndFeesUsDeposit" target="_blank" class="css-ljr3e9"><span style="display:inline-flex"><img class="css-1dvx7dh" src="https://www.bmo.com/dam_asset/asset/99bb3108-f963-458b-8602-19736c85f232/pdf-24.svg" alt="" loading="eager" data-testid="icon"><span>*Access Credit Terms</span></span></a></div></div></div></div></section><section data-region="navigationCards" id="pers-5EPOruQcJSu8JP1jzeY4P" tabindex="-1" class="css-168dy5z e1jqivam3"><div class="css-n3frn1 e1jqivam2"><div class="css-18bgle7 e1jqivam0"><div id="pers-5EPOruQcJSu8JP1jzeY4P-navigationCardsWrapper" class="css-1408fvk e1cuhpd60"><div id="pers-5EPOruQcJSu8JP1jzeY4P-navigationCardsHeadingWrapper" class="css-1g8ia9o e1cuhpd61"><h2 data-testid="nc-heading" class="css-17whzvm e1cuhpd63">Make the most of your rewards</h2><p class="e1cuhpd65 css-k9wmri" data-testid="nc-subheading">You’ve got the power and flexibility to redeem your points for what matters most to you.</p></div><ul id="pers-5EPOruQcJSu8JP1jzeY4PList" data-testid="navigation-cards" role="list" class="css-1clysxp e1cuhpd66"><li role="listitem" id="pers-5EPOruQcJSu8JP1jzeY4PItem0" class="css-e2yi8m e1cuhpd67"><div id="pers-5EPOruQcJSu8JP1jzeY4PItem0-navigation-card" class="css-e65lt1 e1cuhpd613"><div id="pers-5EPOruQcJSu8JP1jzeY4PItem0-icon" class="css-dt57y e1cuhpd610"><img src="https://www.bmo.com/dam_asset/asset/9cb0623a-b406-4cc1-94ed-022d03c22dfa/money-bags-xs.svg" alt="" loading="eager" data-testid="ill"></div><div id="pers-5EPOruQcJSu8JP1jzeY4PItem0-card-text" class="css-smn2r e1cuhpd69"><div id="pers-5EPOruQcJSu8JP1jzeY4PItem0-content" data-testid="navigation-card-content" class="css-z1jhhi e1cuhpd615"><span class="css-1x3x2ym e5cyl7f0"><h3 class="css-0">Redeem rewards for cash back</h3><p><span>Redeem your points for a statement credit to be applied to your account balance.</span><sup><span class="css-wvkc32 e19opmff0">&nbsp;footnote 1&nbsp;</span><span aria-hidden="true">1</span></sup></p></span></div></div></div></li><li role="listitem" id="pers-5EPOruQcJSu8JP1jzeY4PItem1" class="css-e2yi8m e1cuhpd67"><div id="pers-5EPOruQcJSu8JP1jzeY4PItem1-navigation-card" class="css-e65lt1 e1cuhpd613"><div id="pers-5EPOruQcJSu8JP1jzeY4PItem1-icon" class="css-dt57y e1cuhpd610"><img src="https://www.bmo.com/dam_asset/asset/3a3e46c2-b3c7-4d8d-9c3f-3240a0c9b33c/gift-points-xs.svg" alt="" loading="eager" data-testid="ill"></div><div id="pers-5EPOruQcJSu8JP1jzeY4PItem1-card-text" class="css-smn2r e1cuhpd69"><div id="pers-5EPOruQcJSu8JP1jzeY4PItem1-content" data-testid="navigation-card-content" class="css-z1jhhi e1cuhpd615"><span class="css-1x3x2ym e5cyl7f0"><h3 class="css-kx01j9">Merchandise</h3><p>Our online catalog has a wide range of electronics, kitchenware, sporting goods, health &amp; beauty supplies and more.<sup><span class="css-wvkc32 e19opmff0">&nbsp;footnote 1&nbsp;</span><span aria-hidden="true">1</span></sup></p></span></div></div></div></li><li role="listitem" id="pers-5EPOruQcJSu8JP1jzeY4PItem2" class="css-e2yi8m e1cuhpd67"><div id="pers-5EPOruQcJSu8JP1jzeY4PItem2-navigation-card" class="css-e65lt1 e1cuhpd613"><div id="pers-5EPOruQcJSu8JP1jzeY4PItem2-icon" class="css-dt57y e1cuhpd610"><img src="https://www.bmo.com/dam_asset/asset/c9ccf53c-9943-4287-95e7-f36824a19bb3/suitcase-xs.svg" alt="" loading="eager" data-testid="ill"></div><div id="pers-5EPOruQcJSu8JP1jzeY4PItem2-card-text" class="css-smn2r e1cuhpd69"><div id="pers-5EPOruQcJSu8JP1jzeY4PItem2-content" data-testid="navigation-card-content" class="css-z1jhhi e1cuhpd615"><span class="css-1x3x2ym e5cyl7f0"><h3 class="css-0">Travel and vacation packages</h3><p>Redeem your points for flights, hotels, cruises, vacation packages and car rentals.<sup><span class="css-wvkc32 e19opmff0">&nbsp;footnote 1&nbsp;</span><span aria-hidden="true">1</span></sup></p></span></div></div></div></li><li role="listitem" id="pers-5EPOruQcJSu8JP1jzeY4PItem3" class="css-e2yi8m e1cuhpd67"><div id="pers-5EPOruQcJSu8JP1jzeY4PItem3-navigation-card" class="css-e65lt1 e1cuhpd613"><div id="pers-5EPOruQcJSu8JP1jzeY4PItem3-icon" class="css-dt57y e1cuhpd610"><img src="https://www.bmo.com/dam_asset/asset/fa4efcbc-68a2-48bf-915f-33f432378155/collecting-points-xs.svg" alt="" loading="eager" data-testid="ill"></div><div id="pers-5EPOruQcJSu8JP1jzeY4PItem3-card-text" class="css-smn2r e1cuhpd69"><div id="pers-5EPOruQcJSu8JP1jzeY4PItem3-content" data-testid="navigation-card-content" class="css-z1jhhi e1cuhpd615"><span class="css-1x3x2ym e5cyl7f0"><h3 class="css-0">Gift cards</h3><p>Redeem points a wide range of gift cards such as prepaid, restaurants, spas, sporting events, shopping and more.<sup><span class="css-wvkc32 e19opmff0">&nbsp;footnote 1&nbsp;</span><span aria-hidden="true">1</span></sup></p></span></div></div></div></li></ul></div></div></div></section><section id="pers-2O3dKJkz6fy8OlFdiXYlb1-calculatorSection" data-region="calculator" tabindex="-1" class="css-1bh6ju1 e1jqivam3"><div id="calculator-platinum-rewards-wrapper" class="css-1a3n4op enqck1a0"><div id="calculator-platinum-rewards-grid" class="css-1p32uug enqck1a1"><div id="calculator-platinum-rewards-header-wrapper" class="css-11dfp1c enqck1a2"><h2 class="css-0">Maximize your point potential</h2><div id="calculator-platinum-rewards-results-heading" class="css-1xocmgt enqck1a3"><p><span>Earn <span><abbr>BMO</abbr></span> Flex Rewards points every time you spend and rack up the rewards.</s