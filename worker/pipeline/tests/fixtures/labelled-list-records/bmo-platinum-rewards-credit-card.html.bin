/images/bmoharris/credit-cards/escape-mastercard/app-section/card-monitor.webp","largeImage":"https://www.bmo.com/en-us/dist/images/bmoharris/credit-cards/escape-mastercard/app-section/card-monitor.webp","smallImage":"https://www.bmo.com/en-us/dist/images/bmoharris/credit-cards/escape-mastercard/app-section/card-monitor.webp","fallbackXXLargeImage":"https://www.bmo.com/en-us/dist/images/bmoharris/credit-cards/escape-mastercard/app-section/card-monitor.png","fallbackXLargeImage":"https://www.bmo.com/en-us/dist/images/bmoharris/credit-cards/escape-mastercard/app-section/card-monitor.png","fallbackLargeImage":"https://www.bmo.com/en-us/dist/images/bmoharris/credit-cards/escape-mastercard/app-section/card-monitor.png","fallbackSmallImage":"https://www.bmo.com/en-us/dist/images/bmoharris/credit-cards/escape-mastercard/app-section/card-monitor.png","loading":"No","dataRegion":"mobileAppListItem 3-mobileAppBanner"},"entryId":"53WW6YLb8iDTEWwEHYeykJ","componentType":"responsiveImage","locale":"en-CA","tags":[]},"showStars":false,"heading":"\u003ch3\u003e\u003ca href=\"https://www.bmo.com/en-us/main/personal/credit-cards/card-monitor/\" target=\"_blank\" data-logic=\"None\" aria-label=\"Learn more about the B M O credit card alerts digital app feature\" data-mce-href=\"https://www.bmo.com/en-us/main/personal/credit-cards/card-monitor/\" data-mce-selected=\"inline-boundary\" texttodisplay=\"﻿BMO Credit Card Alerts\"\u003e﻿BMO Credit Card Alerts\u003c/a\u003e\u003c/h3\u003e","content":"\u003cp\u003eTrack spending, receive real-time updates, and manage your card with custom alerts and notifications \u0026mdash; all in one place.\u003c/p\u003e","dataRegion":"mobileAppBanner"},"entryId":"2mD7W2Fw2uBCCfKlu6qRJv","componentType":"mobileAppListItem","locale":"en-CA","tags":[]}],"dataRegion":"mobileAppBanner"},"entryId":"30AROhWiaeAzJGdNSPvrYu","componentType":"mobileAppBanner","locale":"en-CA","tags":[],"sectionRegion":"mobileAppBanner"},{"props":{"entryName":"[US - Credit Cards] Platinum Rewards Credit Card FAQs","variant":"none","noImageHeaderPlacement":"above","backgroundColor":"white","heading":"\u003ch2\u003eBMO Platinum Rewards Credit Card \u003cac aria-hidden=\"true\" copy=\"Frequently Asked Questions\" style=\"border: 1px solid #646c76; border-radius: 0.25rem; padding-left: 0.15rem; padding-right: 0.15rem; background: #d9dce1;\"\u003eFAQs\u003c/ac\u003e​\u003c/h2\u003e","addListItemDivider":true,"items":[{"props":{"entryName":"[US - Credit Cards] How do I activate my new card? ","label":"\u003ch3\u003e\u003cspan lang=\"EN-CA\" xml:lang=\"EN-CA\" data-contrast=\"auto\"\u003eHow do I activate my new card?\u003c/span\u003e\u003cspan data-ccp-props=\"{\u0026quot;201341983\u0026quot;:0,\u0026quot;335559740\u0026quot;:259}\"\u003e\u0026nbsp;\u003c/span\u003e\u003c/h3\u003e","content":"\u003cp\u003eOnce you've received your card, just give us a call to activate it.\u0026nbsp;\u003c/p\u003e\n\u003cp\u003eIf you have a \u003cabbr\u003eBMO\u003c/abbr\u003e Platinum Credit Card, a \u003cabbr\u003eBMO\u003c/abbr\u003e Platinum Rewards Credit Card, \u003cabbr\u003eBMO\u003c/abbr\u003e Boost Secured Credit Card or a \u003cabbr\u003eBMO\u003c/abbr\u003e Cash Back Credit Card, call \u003ca class=\"a11y-copy-fail\" href=\"Tel:1-855-825-9237\" target=\"_self\" data-logic=\"None\" aria-label=\"Call us at 1 8 5 5 8 2 5 9 2 3 7\"\u003e1-855-825-9237\u003c/a\u003e.\u0026nbsp;\u003c/p\u003e\n\u003cp\u003eIf you have a \u003cabbr\u003eBMO\u003c/abbr\u003e Premium Rewards Credit Card or a \u003cabbr\u003eBMO\u003c/abbr\u003e Escape Credit Card call \u003ca class=\"a11y-copy-fail\" href=\"Tel:1-855-825-9238\" target=\"_self\" data-logic=\"None\" aria-label=\"Call us at 1 8 5 5 8 2 5 9 2 3 8\"\u003e1-855-825-9238\u003c/a\u003e.\u003c/p\u003e","dataRegion":"accordion","dataAna":"how do i activate my new card--accordion"},"entryId":"6wmj5FXbQ0mXPAvayawlMl","componentType":"accordionListItem","locale":"en-CA","tags":[]},{"props":{"entryName":"[US - Credit Cards] How can I use my BMO Platinum Rewards Credit Card to earn more points?","label":"\u003ch3\u003eHow can I use my \u003cabbr\u003eBMO\u003c/abbr\u003e Platinum Rewards Credit Card to earn more points?\u003cfootnotes data-footnotes=\"customfootnotes-1\" style=\"vertical-align: sup; position: relative; top: -0.4rem; font-size: smaller; margin-bottom: 3px;\"\u003e1\u003c/footnotes\u003e\u003csup\u003e,\u003c/sup\u003e\u003cfootnotes data-footnotes=\"customfootnotes-2\" style=\"vertical-align: sup; position: relative; top: -0.4rem; font-size: smaller; margin-bottom: 3px;\"\u003e2\u003c/footnotes\u003e\u003c/h3\u003e","content":"\u003cp\u003eIt\u0026rsquo;s easy! For every eligible dollar you charge to your \u003cabbr\u003eBMO\u003c/abbr\u003e Platinum Rewards Credit Card, you automatically earn points. Charges that are eligible for points include, but are not limited to, airline, restaurant, hotel, car rental, service station, mail and online orders and retail purchases. Payments and cash advances are ineligible for points accrual. Learn more about how the \u003ca class=\"a11y-copy-fail\" href=\"https://www.bmo.com/en-us/pdf/credit/rewardsconsumerpoints.pdf\" target=\"_blank\" rel=\"noopener\" aria-label=\"Access the B M O Flex Rewards program rules (P D F, 260 K B)\" data-logic=\"None\"\u003eBMO Flex Rewards Program\u003c/a\u003e works.\u003c/p\u003e","dataRegion":"accordion","dataAna":"how can i use my bmo platinum rewards credit card to earn more points12--accordion"},"entryId":"UmXzHGMzCOnM8F6ljKQUD","componentType":"accordionListItem","locale":"en-CA","tags":[]},{"props":{"entryName":"[US - Credit Cards] Do my points ever expire?","label":"\u003ch3\u003eDo my points ever expire?\u003c/h3\u003e","content":"\u003cp\u003e\u003cspan\u003eNo, your \u003c/span\u003e\u003cabbr\u003eBMO\u003c/abbr\u003e\u003cspan\u003e Flex Rewards points will not expire as long as your account is open and in Good Standing. Good Standing means that your account is not canceled, past due or otherwise in default under the terms of an Agreement you have with us. Find out more about the \u003c/span\u003e\u003ca href=\"https://www.bmo.com/en-us/pdf/credit/rewardsconsumerpoints.pdf\" target=\"_blank\" data-logic=\"None\" aria-label=\"Access the B M O Flex Rewards Program Rules (P D F, 257k b)\" data-mce-href=\"https://www.bmo.com/en-us/pdf/credit/rewardsconsumerpoints.pdf\" data-mce-selected=\"inline-boundary\" texttodisplay=\"BMO Flex Rewards Program Rules\"\u003eBMO Flex Rewards Program Rules\u003c/a\u003e\u003cspan\u003e.\u0026nbsp;\u003c/span\u003e\u003c/p\u003e","dataRegion":"accordion","dataAna":"do my points ever expire--accordion"},"entryId":"56Eb1X0on6NNyIWls5XvvX","componentType":"accordionListItem","locale":"en-CA","tags":[]},{"props":{"entryName":"[US - Credit Cards] How do balance transfers work?5","label":"\u003ch3\u003eHow do balance transfers work?\u003cfootnotes data-footnotes=\"customfootnotes-5\" style=\"vertical-align: sup; position: relative; top: -0.4rem; font-size: smaller; margin-bottom: 3px;\"\u003e5\u003c/footnotes\u003e\u003c/h3\u003e","content":"\u003cp\u003eGreat question. You can transfer balances from other credit card accounts to your new BMO credit card account. Please note that you can\u0026rsquo;t transfer balances from other accounts you have with us. Balance Transfers accrue interest from the date of transaction without a grace period.\u003c/p\u003e","dataRegion":"accordion","dataAna":"how do balance transfers work5--accordion"},"entryId":"s4G1Xw5uLkpLjEc2fZS5b","componentType":"accordionListItem","locale":"en-CA","tags":[]},{"props":{"entryName":"[US - Credit Card] How do I report a lost or stolen credit card?","label":"\u003ch3\u003eHow do I report a lost or stolen credit card?\u003c/h3\u003e","content":"\u003cp\u003eCan\u0026rsquo;t find your card? No worries, we\u0026rsquo;ve got you covered.\u0026nbsp;\u0026nbsp;\u003c/p\u003e\n\u003cp\u003eIf you\u0026rsquo;ve misplaced your card or suspect that it\u0026rsquo;s been stolen, just let us know. Visit the \u003ca href=\"https://www.bmo.com/en-us/main/personal/credit-cards/report-lost-stolen-card/\" target=\"_self\" aria-label=\"Access B M O Lost and stolen credit card page\" data-logic=\"None\"\u003eLost and Stolen Credit Card Page\u003c/a\u003e to learn more.\u0026nbsp;\u003c/p\u003e","dataRegion":"accordion","dataAna":"how do i report a lost or stolen credit card--accordion"},"entryId":"6wIYPBYDfvLxlpHtxaOYgP","componentType":"accordionListItem","locale":"en-CA","tags":[]}],"dataRegion":"accordion"},"entryId":"28yWCFxHHzMhqTKNCkpU3G","componentType":"accordion","locale":"en-CA","tags":[],"sectionRegion":"accordion"},{"props":{"entryName":"[US - Credit Cards] Have questions? That’s what we’re here for. CB","backgroundColor":"albicant","heading":"\u003ch2\u003eHave questions? That\u0026rsquo;s what we\u0026rsquo;re here for.\u003c/h2\u003e","isNudged":false,"ctaCards":[{"props":{"entryName":"[US - Credit Cards] Let's meet ","image":"branch","imagev2":{"id":"1BB175A1-C466-4BAC-8B8B7849E9AA3958","name":"branch-xs","type":"illustration","original":"https://www.bmo.com/dam_asset/asset/1bb175a1-c466-4bac-8b8b-7849e9aa3958/branch-xs.svg","height":72,"width":96},"heading":"\u003ch3\u003eLet's meet\u003c/h3\u003e","content":"\u003cp class=\"typography-body\"\u003eStop by your nearest financial center to chat about credit card options.\u003c/p\u003e","cta":{"props":{"entryName":"[US - Credit Cards] Find a financial center","linkType":"Url","iconv2":{"id":"BF14BF15-30CE-46C0-A5D4E5225D748A4C","name":"location-24","type":"icon","original":"https://www.bmo.com/dam_asset/asset/bf14bf15-30ce-46c0-a5d4-e5225d748a4c/location-24.svg","height":24,"width":24},"copy":"Find a financial center","accessibilityLabel":"Find a financial center","location":"https://usbranchlocator.bmo.com/","opensInNewTab":true,"appearance":"primaryButton","chevronAfterLink":false,"iconAfterLink":false,"nofollow":false,"addLinkParameters":"None","analyticsCategory":"None","langAttribute":"None","dataRegion":"ctaCard 1-ctaCardGrid","dataAna":"find a financial center--ctacard 1-ctacardgrid"},"entryId":"2YZ4kRWuI22u0X9Bu2kIh8","componentType":"links","locale":"en-CA","tags":[]},"dataRegion":"ctaCardGrid"},"entryId":"5egJ7Oq6vvxybLnNHFWr6i","componentType":"ctaCard","locale":"en-CA","tags":[]},{"props":{"entryName":"[US - Credit Cards] Give us a call (1-888-340-2265)","image":"mobile-phone","imagev2":{"id":"1CA7AE1E-4F46-4CB5-B4DCB9FC28BE4606","name":"mobile-phone-xs","type":"illustration","original":"https://www.bmo.com/dam_asset/asset/1ca7ae1e-4f46-4cb5-b4dc-b9fc28be4606/mobile-phone-xs.svg","height":72,"width":96},"heading":"\u003ch3\u003eGive us a call\u003c/h3\u003e","content":"\u003cp\u003eWe\u0026rsquo;ll reach out by phone or email at a time that\u0026rsquo;s convenient for you.\u003c/p\u003e","cta":{"props":{"entryName":"[US - Credit Cards] 1-888-340-2265 Secondary","linkType":"Url","iconv2":{"id":"CC98ED79-0930-471C-8450870621B7FE74","name":"call-us-24","type":"icon","original":"https://www.bmo.com/dam_asset/asset/cc98ed79-0930-471c-8450-870621b7fe74/call-us-24.svg","height":24,"width":24},"copy":"Call 1-888-340-2265","accessibilityLabel":"Call us at 1 8 8 8 3 4 0 2 2 6 5","location":"tel: 1-888-340-2265","opensInNewTab":false,"appearance":"secondaryButton","chevronAfterLink":false,"iconAfterLink":false,"nofollow":false,"addLinkParameters":"None","analyticsCategory":"None","langAttribute":"None","dataRegion":"ctaCard 2-ctaCardGrid","dataAna":"call 1-888-340-2265--ctacard 2-ctacardgrid"},"entryId":"6SGhyMoYb3in6c1Fj6YR31","componentType":"links","locale":"en-CA","tags":[]},"dataRegion":"ctaCardGrid"},"entryId":"1vzSna6Djzz846wsOyd1F8","componentType":"ctaCard","locale":"en-CA","tags":[]}],"dataRegion":"ctaCardGrid"},"entryId":"4ga5pny1ZkYIGxkgwceHRw","componentType":"ctaCardGrid","locale":"en-CA","tags":[],"sectionRegion":"ctaCardGrid"},{"props":{"entryName":"[US - Credit Cards] Platinum Rewards Subfooter","heading1":"Get Started",