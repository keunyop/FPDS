-eadf-4037-bc65-5457f674bdc4/5197ae18-product-card-bmoharris-hero-platinum-rewards-mastercard-desktop?format=png&amp;quality=100" type="image/png"><source media="(min-width:768px)" srcset="https://www.bmo.com/dam_asset/transform/d4223776-eadf-4037-bc65-5457f674bdc4/5197ae18-product-card-bmoharris-hero-platinum-rewards-mastercard-desktop?format=png&amp;quality=100" type="image/png"><source media="(max-width:767px)" srcset="https://www.bmo.com/dam_asset/transform/d4223776-eadf-4037-bc65-5457f674bdc4/5197ae18-product-card-bmoharris-hero-platinum-rewards-mastercard-desktop?format=png&amp;quality=100" type="image/png"><img loading="eager" class="primitive-image css-1rvhu3f e188sdvu0" src="https://www.bmo.com/dam_asset/transform/d4223776-eadf-4037-bc65-5457f674bdc4/5197ae18-product-card-bmoharris-hero-platinum-rewards-mastercard-desktop?format=png&amp;quality=100" alt="b m o platinum rewards mastercard"></picture></div></div></div></div></div></div><div class="css-199p00m enwdr1j16"><div id="pers-5v2sqZfynIQDWPX5nqa76F-blue-box-inner-container" class="css-11g5gbn enwdr1j24"><div id="pers-5v2sqZfynIQDWPX5nqa76F-blue-box-main-content" class="css-1xt8kzi enwdr1j25"><div class="css-ghng4h enwdr1j27"><span class="css-1x3x2ym e5cyl7f0"><h2 class="css-0">Welcome offer:</h2></span></div><div class="css-vrn7m7 enwdr1j17"><span class="css-1x3x2ym e5cyl7f0"><p>Get <strong>15,000 bonus points </strong>when you spend $1,500 within 3 months of opening your account.<sup><span class="css-wvkc32 e19opmff0">&nbsp;footnote 1&nbsp;</span><span aria-hidden="true">1</span></sup></p></span></div></div><div id="pers-5v2sqZfynIQDWPX5nqa76F-apply-section" class="css-ed2j7v enwdr1j18"><div id="pers-5v2sqZfynIQDWPX5nqa76F-section-content-wrapper" class="css-1gd2uf enwdr1j19"><div id="pers-5v2sqZfynIQDWPX5nqa76F-apply-section-side-content" class="css-pe8hdg enwdr1j35"><div id="pers-5v2sqZfynIQDWPX5nqa76F-cta-wrapper-offer-box-mobile" class="css-1qqq519 enwdr1j20"><div class="css-1ediylu enwdr1j21"><a id="pers-3Qt2lRNMpdYXN7ktkrui99" href="https://www.bmo.com/en-us/main/personal/credit-cards/application-preparation/?productCode=MCSDM" aria-label="Apply for the B M O Platinum Rewards Credit Card online" data-ana="apply online--herobannercreditcardproduct" data-meta="apply online--herobannercreditcardproduct" data-region="heroBannerCreditCardProduct" target="_self" class="css-ljr3e9"><span style="display:inline-flex"><img class="css-1dvx7dh" src="https://www.bmo.com/dam_asset/asset/84232d15-93b6-4585-b774-5ea536deb4cf/lock-24.svg" alt="" loading="eager" data-testid="icon"><span>Apply online</span></span></a></div><div class="css-1iop41g enwdr1j23"><span class="css-1x3x2ym e5cyl7f0"><p class="typography-body css-li7dim"><span style="color:#ffffff">Received a credit card offer in the mail?</span><span> </span><span style="text-decoration:underline;color:#ffffff"><a aria-label="Apply now for your credit card offer, opens in a new tab" data-meta="apply now--rte-herobannercreditcardproduct" data-ana="apply now--rte-herobannercreditcardproduct" href="https://usdigital.bmo.com/us-st/promo-apply?icid=ba-US66595CC4-JBBMO171" target="_blank" rel="noopener" data-rte="true" style="color:#ffffff;text-decoration:underline">Apply now</a></span></p></span></div></div></div><div id="pers-5v2sqZfynIQDWPX5nqa76F-apply-section-disclaimer" data-testid="disclaimer-wrapper" class="css-w26vo8 enwdr1j22"><span class="css-1x3x2ym e5cyl7f0"><p>Apply and get a response in <strong>60 seconds </strong>or less.</p></span></div></div></div></div></div></section><section data-region="contentCardGrid" id="pers-2HRoyLlpHeUnor51q75FNG" tabindex="-1" class="css-gywdsc e1jqivam3"><div id="pers-2HRoyLlpHeUnor51q75FNG-content-wrapper" class="css-n3frn1 e1jqivam2"><div class="css-18bgle7 e1jqivam0"><div data-testid="main-container" id="pers-2HRoyLlpHeUnor51q75FNG-content-banner-grid-main-container" class="css-bw6j0w eq472al0"><div data-testid="header" class="css-1tmgh1w eq472al2"><span class="css-1x3x2ym e5cyl7f0"><h2 class="css-0">Earn points on every purchase</h2></span></div><div data-testid="subheading" class="css-13qk3wt eq472al3"><span class="css-1x3x2ym e5cyl7f0"><p>Earn points on everything from coffee purchases to groceries. Redeem your points for all your daily needs.</p></span></div><div id="pers-2HRoyLlpHeUnor51q75FNG-cards-container" class="css-rdc1e0 eq472al6"><div class="css-10izwvm eq472al5"><div data-testid="ContentCardWrapper" id="pers-2HRoyLlpHeUnor51q75FNG-1-content-card-0" class="css-1tfnjyp e4anoz90"><div data-testid="IconWrapper" class="css-1n12z2p e4anoz91"><img src="https://www.bmo.com/dam_asset/asset/ce3a1b1c-a1ba-44d7-8213-5772eefee578/car-xs.svg" alt="" loading="eager" data-testid="ill"></div><div id="pers-2HRoyLlpHeUnor51q75FNG-1-content-card-0-heading-box" class="css-hoqem e4anoz93"><div data-height="contentCardHeading" class="css-jvxd5c e4anoz95" style="margin-bottom: 0px;"><span class="css-1x3x2ym e5cyl7f0"><h3 class="css-0">2 Points</h3></span></div><div data-height="contentCardContentWrapper" data-testid="ContentCardContentWrapper" class="css-1df32y4 e4anoz94"><span class="css-1x3x2ym e5cyl7f0"><p><span>For every dollar spent on eligible gas, EV charging and grocery purchases</span><sup><span class="css-wvkc32 e19opmff0">&nbsp;footnote 1&nbsp;</span><span aria-hidden="true">1</span></sup><sup class="css-129gw94 eyqmael1"><span><span aria-hidden="true" class="css-0 enikfnm1">†</span><span class="css-v12mhn enikfnm0">footnote dagger</span></span></sup></p></span></div></div></div></div><div class="css-10izwvm eq472al5"><div data-testid="ContentCardWrapper" id="pers-2HRoyLlpHeUnor51q75FNG-2-content-card-1" class="css-1tfnjyp e4anoz90"><div data-testid="IconWrapper" class="css-1n12z2p e4anoz91"><img src="https://www.bmo.com/dam_asset/asset/bb0083b9-7d31-457b-a1b2-277a1c93e0ce/cart-xs.svg" alt="" loading="eager" data-testid="ill"></div><div id="pers-2HRoyLlpHeUnor51q75FNG-2-content-card-1-heading-box" class="css-hoqem e4anoz93"><div data-height="contentCardHeading" class="css-jvxd5c e4anoz95" style="margin-bottom: 0px;"><span class="css-1x3x2ym e5cyl7f0"><h3 class="css-0">Unlimited 1 point</h3></span></div><div data-height="contentCardContentWrapper" data-testid="ContentCardContentWrapper" class="css-1df32y4 e4anoz94"><span class="css-1x3x2ym e5cyl7f0"><p>For every dollar spent on everywhere else<sup><span class="css-wvkc32 e19opmff0">&nbsp;footnote 1&nbsp;</span><span aria-hidden="true">1</span></sup></p></span></div></div></div></div><div class="css-10izwvm eq472al5"><div data-testid="ContentCardWrapper" id="pers-2HRoyLlpHeUnor51q75FNG-3-content-card-2" class="css-1tfnjyp e4anoz90"><div data-testid="IconWrapper" class="css-1n12z2p e4anoz91"><img src="https://www.bmo.com/dam_asset/asset/fa4efcbc-68a2-48bf-915f-33f432378155/collecting-points-xs.svg" alt="" loading="eager" data-testid="ill"></div><div id="pers-2HRoyLlpHeUnor51q75FNG-3-content-card-2-heading-box" class="css-hoqem e4anoz93"><div data-height="contentCardHeading" class="css-jvxd5c e4anoz95" style="margin-bottom: 0px;"><span class="css-1x3x2ym e5cyl7f0"><h3 class="css-0">15% Anniversary bonus points</h3></span></div><div data-height="contentCardContentWrapper" data-testid="ContentCardContentWrapper" class="css-1df32y4 e4anoz94"><span class="css-1x3x2ym e5cyl7f0"><p>when you spend a minimum of $15,000 annually.<sup><span class="css-wvkc32 e19opmff0">&nbsp;footnote 2&nbsp;</span><span aria-hidden="true">2</span></sup></p></span></div></div></div></div></div><div data-testid="closing-content" class="css-wqsiht eq472al8"><span class="css-1x3x2ym e5cyl7f0"><p><sup class="css-129gw94 eyqmael1"><span><span aria-hidden="true" class="css-0 enikfnm1">†</span><span class="css-v12mhn enikfnm0">footnote dagger details</span></span></sup> Up to $1,500 in gas, EV charging and grocery purchases each calendar quarter and <span><span aria-hidden="true" class="css-0 enikfnm1">1x</span><span class="css-v12mhn enikfnm0">One times</span></span>​ on all purchases after that.</p></span></div></div></div></div></section><section id="pers-5rRmBKJheuy3plSwPufNAr" data-region="tileGridDynamicTile-section" tabindex="-1" class="css-168dy5z e1jqivam3"><div id="pers-5rRmBKJheuy3plSwPufNAr-ModulePaddingWrapper" class="css-18bgle7 e1jqivam0"><div class="css-n3frn1 e1jqivam2"><div id="pers-5rRmBKJheuy3plSwPufNAr-MainGridWrapper" class="css-10la47u e1cke2nd0"><div class="css-1hg16bx e1cke2nd1"><span class="css-1x3x2ym e5cyl7f0"><h2 class="css-0">Enjoy built-in card benefits</h2><p id="persInsuranceAndWarranties"></p></span></div><div class="css-1t85nq8 e1cke2nd2"><span class="css-1x3x2ym e5cyl7f0"><p>Your card offers a wide range of benefits, from cellphone protection to reliable roadside assistance.</p></span></div><ul id="pers-5LqwdbMRldOvdnFZAFNg1i" role="list" class="css-fzkkbp e1qpvhie0"><li id="pers-6I6TG9hXBEP9GG4DoE72NOCard-2-0" role="listitem" class="css-xan8j0 e1m1kb965"><div class="css-adf5d8 e1m1kb962"><picture data-testid="picture"><source media="(min-width:1268px)" srcset="https://www.bmo.com/dam_asset/transform/d33b385d-dc9e-4c49-854f-a4fd25031663/ef4b2d78-cellphone-protection-desktop?format=webp&amp;quality=100" type="image/webp"><source media="(min-width:1024px)" srcset="https://www.bmo.com/dam_asset/transform/d33b385d-dc9e-4c49-854f-a4fd25031663/ef4b2d78-cellphone-protection-desktop?format=webp&amp;quality=100" type="image/webp"><source media="(min-width:768px)" srcset="https://www.bmo.com/dam_asset/transform/d33b385d-dc9e-4c49-854f-a4fd25031663/ef4b2d78-cellphone-protection-desktop?format=webp&amp;quality=100" type="image/webp"><source media="(max-width:767px)" srcset="https://www.bmo.com/dam_asset/transform/d33b385d-dc9e-4c49-854f-a4fd25031663/ef4b2d78-cellphone-protection-desktop?format=webp&amp;quality=100" type="image/webp"><source media="(min-width:1268px)" srcset="https://www.bmo.com/dam_asset/transform/d33b385d-dc9e-4c49-854f-a4fd25031663/ef4b2d78-cellphone-protection-desktop?format=jpg&amp;quality=100" typ