:"links","locale":"en-CA","tags":[{"sys":{"type":"Link","linkType":"Tag","id":"dev"}}]},{"props":{"entryName":"[US - Credit Cards] BMO Card Alerts (Subfooter link)","linkType":"Url","copy":"BMO Credit Card Alerts","accessibilityLabel":"Learn more about B M O Credit Card Alerts","location":"https://www.bmo.com/en-us/main/personal/credit-cards/card-monitor/","opensInNewTab":false,"appearance":"text","chevronAfterLink":false,"iconAfterLink":false,"nofollow":false,"addLinkParameters":"None","dataRegion":"subFooterContextual","dataAna":"bmo credit card alerts--subfootercontextual"},"entryId":"4RuWJH8Mqi2iUzLQyPej7y","componentType":"links","locale":"en-CA","tags":[]},{"props":{"entryName":"[US - Credit Cards] Set up your digital wallet (Subfooter link)","linkType":"Url","copy":"Set up your digital wallet","accessibilityLabel":"Set up your digital wallet to make mobile payments","location":"https://www.bmo.com/en-us/main/personal/credit-cards/digital-wallet/","opensInNewTab":false,"appearance":"text","chevronAfterLink":false,"iconAfterLink":false,"nofollow":false,"addLinkParameters":"None","dataRegion":"subFooterContextual","dataAna":"set up your digital wallet--subfootercontextual"},"entryId":"1ZpQzWCpYD2b5wyZt661dX","componentType":"links","locale":"en-CA","tags":[]},{"props":{"entryName":"[US - Credit Cards] Paysmart Installment Plans (Subfooter link)","linkType":"Url","copy":"BMO PaySmart Installment Plans","accessibilityLabel":"Learn more about B M O Paysmart Installment Plans","location":"https://www.bmo.com/en-us/main/personal/credit-cards/bmo-paysmart-installment-lending/","opensInNewTab":false,"appearance":"text","chevronAfterLink":false,"iconAfterLink":false,"nofollow":false,"addLinkParameters":"None","analyticsCategory":"None","dataRegion":"subFooterContextual","dataAna":"bmo paysmart installment plans--subfootercontextual"},"entryId":"4DoSVCHbdOWdoKbrOZrZfX","componentType":"links","locale":"en-CA","tags":[]},{"props":{"entryName":"[US - Credit Cards] BMO Flex Rewards Program Rules (Subfooter link)","linkType":"Url","copy":"BMO Flex Rewards Program Rules (PDF, 261 KB)","accessibilityLabel":"Access BMO Flex Rewards Program Rules (P D F, 261 K B)","location":"https://www.bmo.com/en-us/pdf/credit/rewardsconsumerpoints.pdf","opensInNewTab":true,"appearance":"text","chevronAfterLink":false,"iconAfterLink":false,"nofollow":false,"addLinkParameters":"None","analyticsCategory":"None","dataRegion":"subFooterContextual","dataAna":"bmo flex rewards program rules pdf 261 kb--subfootercontextual"},"entryId":"1C8fNbxxEHn7DZvsMpMF1A","componentType":"links","locale":"en-CA","tags":[]}],"linksListLayout":true,"dataRegion":"subFooterContextual"},"entryId":"11hoEfOjx9SHk08dTomIes","componentType":"subFooterContextual","locale":"en-CA","tags":[],"sectionRegion":"subFooterContextual"},{"props":{"entryName":"[US - Credit Cards] Platinum Rewards Legal","heading":"Legal","footnotesBackgroundColor":"Blue","footnotes":"\u003cp id=\"footnote-1\"\u003e\u003cac aria-hidden=\"true\" copy=\"Footnote 1 details\" style=\"border: 1px solid #646c76; border-radius: 0.25rem; padding-left: 0.15rem; padding-right: 0.15rem; background: #d9dce1;\"\u003e1.\u003c/ac\u003e\u0026nbsp;Participation in \u003cabbr\u003eBMO\u003c/abbr\u003e Flex Rewards is subject to terms and conditions found in \u003cabbr\u003eBMO\u003c/abbr\u003e Flex Rewards Program Rules, available at: \u003ca class=\"a11y-copy-fail\" href=\"https://www.bmo.com/en-us/main/personal/credit-cards/points-rewards/\" target=\"_blank\" rel=\"noopener\" aria-label=\"Access B M O Flex Rewards Program Rules\" data-logic=\"None\"\u003ebmo.com/bmoflexrewardsconsumer\u003c/a\u003e. The Account must be current and in good standing to accrue and redeem points or cash back, as applicable. While points and cash back don\u0026rsquo;t expire, if the Account is closed for any reason, the Account will no longer be able to accrue points or cash back.\u0026nbsp; All accrued points or cash back not redeemed will be available for redemption for 90 days as long as the Account is closed in good standing. All cash back is redeemable in the form of a statement credit. The introductory rewards bonus is based on total net qualified purchases made in the first three months of account opening and rewards will be awarded to qualifying Accounts 3 - 4 weeks after the conclusion of the three month period.\u0026nbsp;\u003c/p\u003e\n\u003cp id=\"footnote-2\"\u003e\u003cac aria-hidden=\"true\" copy=\"Footnote 2 details\" style=\"border: 1px solid #646c76; border-radius: 0.25rem; padding-left: 0.15rem; padding-right: 0.15rem; background: #d9dce1;\"\u003e2.\u003c/ac\u003e\u0026nbsp;Anniversary Bonus is based on net purchases made in the year prior to Anniversary Date. Please see the \u003ca class=\"a11y-copy-fail\" href=\"https://www.bmo.com/en-us/pdf/credit/rewardsconsumerpoints.pdf\" target=\"_blank\" rel=\"noopener\" aria-label=\"B M O Flex Rewards Program Plans (P D F, 260 K B)\" data-logic=\"None\"\u003eProgram Rules\u003c/a\u003e for more information about the Anniversary Bonus.\u0026nbsp;\u003c/p\u003e\n\u003cp id=\"footnote-3\"\u003e\u003cac aria-hidden=\"true\" copy=\"Footnote 3 details\" style=\"border: 1px solid #646c76; border-radius: 0.25rem; padding-left: 0.15rem; padding-right: 0.15rem; background: #d9dce1;\"\u003e3.\u003c/ac\u003e Coverage provided under a group insurance policy issued by New Hampshire Insurance Company, an AIG company. Policy provides secondary coverage only. Coverage for a stolen or damaged eligible cellular wireless telephone is subject to terms, conditions, exclusions, and limits of liability of this benefit. The maximum liability is $400 per claim for \u003cabbr\u003eBMO\u003c/abbr\u003e Platinum Rewards Credit Card, and $600 per covered card per 12-month period. Each claim is subject to a $50 deductible. Coverage is limited to two (2) claims per covered card per 12-month period. The monthly bill associated with the phone must be paid with the eligible card for coverage to be effective. Refer to the \u003ca href=\"https://www.bmo.com/en-us/pdf/credit/consumermcgtb.pdf\" target=\"_blank\" rel=\"noopener\" aria-label=\"B M O Mastercard Guide to Benefits (P D F, 498 K B)\" data-logic=\"None\"\u003eMastercard Guide to Benefits\u003c/a\u003e for more information.\u0026nbsp;\u003c/p\u003e\n\u003cp id=\"footnote-4\"\u003e\u003cac aria-hidden=\"true\" copy=\"Footnote 4 details\" style=\"border: 1px solid #646c76; border-radius: 0.25rem; padding-left: 0.15rem; padding-right: 0.15rem; background: #d9dce1;\"\u003e4.\u003c/ac\u003e Certain terms, conditions, and exclusions apply. Extended Warranty, Master RoadAssist\u003csup\u003e\u0026reg;\u003c/sup\u003e and MasterRental\u003csup\u003e\u0026reg;\u003c/sup\u003e are underwritten by New Hampshire Insurance Company, an AIG company. For complete coverage terms and conditions call 1-800-MASTERCARD (1-800-627-8372) for assistance. Refer to the \u003ca href=\"https://www.bmo.com/en-us/pdf/credit/consumermcgtb.pdf\" target=\"_blank\" rel=\"noopener\" aria-label=\"Access B M O Mastercard Guide to Benefits (P D F, 498 K B)\" data-logic=\"None\"\u003eMastercard Guide to Benefits\u003c/a\u003e\u0026nbsp;for more information.\u0026nbsp;\u0026nbsp;\u003c/p\u003e\n\u003cp id=\"footnote-5\"\u003e\u003cac aria-hidden=\"true\" copy=\"Footnote 5 details\" style=\"border: 1px solid #646c76; border-radius: 0.25rem; padding-left: 0.15rem; padding-right: 0.15rem; background: #d9dce1;\"\u003e5.\u003c/ac\u003e\u0026nbsp;You can request to transfer balances from credit card accounts that you have with other credit card issuers. By submitting your Balance Transfer request you agree that the terms and conditions of your \u003ca href=\"https://www.bmo.com/en-us/pdf/credit/ccagreement.pdf\" target=\"_blank\" rel=\"noopener\" aria-label=\"Access B M O Consumer Cardholder Agreement (P D F, 333 K B)\" data-logic=\"None\"\u003eCardholder Agreement\u0026nbsp;\u003c/a\u003eapply to all balances transferred. Please refer to the \u003ca href=\"https://www.bmo.com/en-us/pdf/credit/standardcreditcards.pdf\" target=\"_blank\" rel=\"noopener\" aria-label=\"Access B M O Summary of credit terms (P D F, 198 K B)\" data-logic=\"None\"\u003eSummary of Credit Terms\u003c/a\u003e for important information about rates and fees.\u0026nbsp;\u003c/p\u003e\n\u003cp id=\"footnote-6\"\u003e\u003cac aria-hidden=\"true\" copy=\"Footnote 6 details\" style=\"border: 1px solid #646c76; border-radius: 0.25rem; padding-left: 0.15rem; padding-right: 0.15rem; background: #d9dce1;\"\u003e6.\u003c/ac\u003e\u0026nbsp;\u003cabbr\u003eBMO\u003c/abbr\u003e PaySmart installment plans allow cardholders to repay specific eligible purchases in equal monthly payments over a defined repayment schedule. When you create a PaySmart Plan, it will be subject to a fixed monthly fee of up to 1%. The exact fee will be based on the purchase amount and the duration of the plan, which will be disclosed when the plan is created. The monthly plan fee will remain the same until the PaySmart Plan is paid in full. Review the \u003ca href=\"https://www.bmo.com/en-us/main/personal/credit-cards/paysmart-terms-conditions.pdf\" target=\"_blank\" rel=\"noopener\" aria-label=\"Access B M O PaySmart Terms and Conditions (P D F, 173 K B)\" data-logic=\"None\"\u003eTerms and Conditions\u003c/a\u003e.\u0026nbsp;\u0026nbsp;\u003c/p\u003e\n\u003cp id=\"footnote-7\"\u003e\u003cac aria-hidden=\"true\" copy=\"Footnote 7 details\" style=\"border: 1px solid #646c76; border-radius: 0.25rem; padding-left: 0.15rem; padding-right: 0.15rem; background: #d9dce1;\"\u003e7.\u003c/ac\u003e\u0026nbsp;Certain terms, conditions, and exclusions apply. Call 1-800-Mastercard for assistance. Additional details are provided in the \u003cabbr\u003eBMO\u003c/abbr\u003e \u003ca href=\"https://www.bmo.com/en-us/pdf/credit/consumermcgtb.pdf\" target=\"_blank\" rel=\"noopener\" aria-label=\"B M O Mastercard Guide to Benefits (P D F, 498 K B)\" data-logic=\"None\"\u003eMastercard Guide to Benefits\u003c/a\u003e\u0026nbsp;for more information.\u0026nbsp;\u003c/p\u003e\n\u003cp id=\"footnote-8\"\u003e\u003cac aria-hidden=\"true\" copy=\"Footnote 8 details\" style=\"border: 1px solid #646c76; border-radius: 0.25rem; padding-left: 0.15rem; padding-right: 0.15rem; background: #d9dce1;\"\u003e8.\u003c/ac\u003e\u0026nbsp;Pay only for purchases that you have authorized on your Mastercard card. Unauthorized purchases are not your responsibility. Conditions and exceptions apply. Learn more at \u003ca class=\"a11y-copy-fail\" href=\"https://www.mastercard.com/us/en/personal/protection-and-security/zero-liability-protection.html\" target=\"_blank\" rel=\"noopener\" aria-label=\"Access Mastercard Zero Liability site\" data-logic=\"None\"\u003ehttp://www.mastercard.us/zero-liability.html\u003c/a\u003e.\u0026nbsp;\u003c/p\u003e\n\u003cp id=\"footnote-9\"\u003e\u003cac aria-hidden=\"true\" copy=\"Footnote 9 details\" style=\"border: 1px solid #646c76; border-radius: 0.25rem; padding-left: 0.15rem; padding-right: 0.15rem; background: #d9dce1;\"\u003e9.\u003c/ac\u003e​ CreditView and its features, Score Simulator and Credit Education, are provided by TransUnion\u003csup\u003e\u0026reg;\u003c/sup\u003e for educational purposes only. You should consult with your own financial team for more information about credit score.\u0026nbsp;\u003c/p\u003e\n\u003cp\u003e\u003cac aria-hidden=\"true\" copy=\"footnote star details\" style=\"border: 1px solid #646c76; border-radius: 0.25rem; padding-left: 0.15rem; padding-right: 0.15rem; background: #d9dce1;\"\u003e*\u003c/ac\u003e \u003ca href=\"https://www.bmo.com/en-us/pdf/credit/standardcreditcards.pdf\" target=\"_blank\" rel=\"noopener\" aria-label=\"Access the B M O Summary of Credit Terms (P D F, 198 K B)\" data-logic=\"None\"\u003eSummary of Credit Terms\u003c/a\u003e for rate and fee information.\u0026nbsp;\u003c/p\u003e\n\u003cp\u003eApple and Apple Pay\u003csup\u003e\u0026reg;\u003c/sup\u003e are trademarks of Apple Inc., registered in the \u003cabbr\u003eU.S.\u003c/abbr\u003e and other countries.\u0026nbsp;\u003c/p\u003e\n\u003cp\u003eGoogle Play and the Google Pay are trademarks of Google LLC.\u0026nbsp;\u003c/p\u003e\n\u003cp\u003eSamsung and Samsung Pay are trademarks of Samsung Electronics Co., Ltd. Use only in accordance with law. Other company and product names mentioned may be trademarks or their respective owners.\u0026nbsp;\u003c/p\u003e\n\u003cp\u003eMastercard, the Mastercard Brand Mark, Mastercard\u003csup\u003e\u0026reg;\u003c/sup\u003e ID Theft Protection\u003cac aria-hidden=\"true\" copy=\"trademark\" style=\"border: 1px solid #646c76; border-radius: 0.25rem; padding-left: 0.15rem; padding-right: 0.15rem; background: #d9dce1; background-color: #ffffff;\"\u003e\u0026trade;\u003c/ac\u003e, Master RoadAssist\u003csup\u003e\u0026reg;\u003c/sup\u003e, MasterRental\u003csup\u003e\u0026reg;\u003c/sup\u003e,\u0026nbsp;and the circles design are trademarks of Mastercard International Incorporated.\u003c/p\u003e","expandAccordion":true,"dataRegion":"legalAccordion"},"entryId":"5SJqm2i5hKu0pdrjaIuhxE","componentType":"legalAccordion","locale":"en-CA","tags":[],"sectionRegion":"legalAccordion"}],"seoMeta":{"props":{"title":"BMO Platinum Rewards Credit Card: Earn More Points - BMO","description":"Maximize your point reward potential with our BMO Platinum Rewards credit card. Earn points every time you spend and check out our welcome offer bonus!","shouldHideFromSearchEngines":false,"shouldExcludeLinksFromSearchEngines":false,"schema":{"@type":"FAQPage","@context":"https://schema.org","mainEntity":[{"name":"How can I use my BMO Platinum Rewards Credit Card to earn more points?","@type":"Question","acceptedAnswer":{"text":"It’s easy! For every eligible dollar you charge to your BMO Platinum Rewards Credit Card, you automatically earn points. Charges that are eligible for points include, but are not limited to, airline, restaurant, hotel, car rental, service station, mail and online orders and retail purchases. Payments and cash advances are ineligible for points accrual. Learn more about how the BMO Flex Rewards Program works.","@type":"Answer"}},{"name":"Do my points ever expire?","@type":"Question","acceptedAnswer":{"text":"No, your BMO Flex Rewards points will not expire as long as your account is open and in Good Standing. Good Standing means that your account is not canceled, past due or otherwise in default under the terms of an Agreement you have with us. Find out more about the BMO Flex Rewards Program Rules.","@type":"Answer"}}]},"isInternationalAudience":false,"canonicalTag":"https://www.bmo.com/en-us/main/personal/credit-cards/bmo-platinum-rewards-credit-card/","hreflangEnUs":"https://www.bmo.com/en-us/main/personal/credit-cards/bmo-platinum-rewards-credit-card/","analyticsPageName":"bmoh:PERS:CC:BMO Platinum Rewards Credit Card","dataRegion":"pageSeoMeta"},"entryId":"77n9ZAi0WuRprTAFiGlcgF","componentType":"pageSeoMeta","locale":"en-CA","tags":[]}},"entryId":"16cuVJbTmWcdsvNW6UUycp","componentType":"usDynamicPage","locale":"en-CA","tags":[{"sys":{"type":"Link","linkType":"Tag","id":"live"}},{"sys":{"type":"Link","linkType":"Tag","id":"release"}}]},"componentTreeApiValuePaths":{},"headerData":null,"footerData":null,"headerPath":null,"footerPath":null,"analyticsData":{"products":[],"tags":[]},"pageUrl":"https://www.bmo.com/en-us/main/personal/credit-cards/bmo-platinum-rewards-credit-card/","isDecoupled":false,"build_last_modified":"2026-10-06 17:20:54","ssi_disabled":false,"isInternationalAudience":false,"releaseVersion":"R66-v4.47"},"__N_SSG":true},"page":"/[...slug]","query":{"slug":["en-us","main","personal","credit-cards","bmo-platinum-rewards-credit-card"]},"buildId":"build-manifest","isFallback":false,"dynamicIds":[36880,84927,4563,75074,99112,74659,13822,78653,14550,84400,13241,16546,84024,33896,54668,83233,20081,67892],"gsp":true,"scriptLoader":[{"id":"google-analytics","strategy":"afterInteractive","children":"