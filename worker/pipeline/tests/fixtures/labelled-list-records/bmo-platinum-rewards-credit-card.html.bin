@font-face {
    font-family: "Heebo";
    font-style: normal;
    font-weight: 300;
    src: url("https://www.bmo.com/dist/fonts/heebo-light-hebrew.woff2") format("woff2");
    unicode-range: U+0590-05FF, U+20AA, U+25CC, U+FB1D-FB4F;
  }
  
  /* latin */
  @font-face {
    font-family: "Heebo";
    font-style: normal;
    font-weight: 300;
    src: url("https://www.bmo.com/dist/fonts/heebo-light-latin.woff2") format("woff2");
    unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+2000-206F, U+2074, U+20AC,
      U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
  }
  
  /* latin */
  @font-face {
    font-family: "Heebo";
    font-style: normal;
    font-weight: 700;
    src: local("Heebo Bold"), local("Heebo-Bold"), url("https://www.bmo.com/dist/fonts/heebo-bold-latin.woff2") format("woff2");
    unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+2000-206F, U+2074, U+20AC,
      U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
  }
  
  #onetrust-consent-sdk #onetrust-policy-title {
    text-indent: -9999px;
    position: absolute !important;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
  }
  
  #onetrust-consent-sdk {
    font-family: "Heebo", Arial, sans-serif !important;
  }
  
  /* close button */
  #onetrust-consent-sdk #onetrust-banner-sdk #onetrust-close-btn-container {
    position: unset !important;
    transform: none !important;
    top: unset !important;
    right: unset !important;
  }
  
  #onetrust-banner-sdk #onetrust-close-btn-container button {
    position: absolute !important;
    top: 8px !important;
    right: 8px !important;
    height: 30px !important;
    width: 30px !important;
  }
  
  /* Default Link Styling */
  #onetrust-banner-sdk #onetrust-policy-text a, #onetrust-consent-sdk #onetrust-pc-btn-handler {
    font-weight: 700 !important;
    text-decoration: none !important;
  }
  
  #onetrust-consent-sdk #onetrust-banner-sdk #onetrust-policy-text a {
    margin-left: 0 !important;
  }
  
  /* Hover States */
  #onetrust-banner-sdk #onetrust-policy-text a:hover, #onetrust-consent-sdk #onetrust-pc-btn-handler:hover, #onetrust-consent-sdk #onetrust-accept-btn-handler:hover, #onetrust-pc-sdk #accept-recommended-btn-handler:hover, #onetrust-pc-sdk .ot-btn-container button:hover {
    opacity: 1 !important;
    text-decoration: underline !important;
  }
  
  /* Focus States */
  #onetrust-consent-sdk #onetrust-banner-sdk:focus, #onetrust-consent-sdk #onetrust-banner-sdk:focus-visible {
    outline: 1px solid #0075be !important;
  }
  
  #onetrust-consent-sdk #onetrust-banner-sdk *:focus {
    margin-right: 0 !important;
    outline-width: 2px !important;
    opacity: 1 !important;
  }
  
  #onetrust-pc-sdk #close-pc-btn-handler.ot-close-icon {
    opacity: 1 !important;
    right: 10px !important;
  }
  
  #onetrust-consent-sdk #onetrust-pc-sdk *:focus, #onetrust-consent-sdk #onetrust-pc-sdk .ot-vlst-cntr > a:focus {
    opacity: 1 !important;
    outline: 2px solid #0075be !important;
  }
  
  #onetrust-pc-sdk .ot-pc-footer-logo a {
    margin: 0 10px 0 10px !important;
    height: 20px !important;
    padding: 0 5px 0 10px !important;
  }
  
  #onetrust-consent-sdk #onetrust-pc-btn-handler:focus-visible, #onetrust-consent-sdk #onetrust-pc-btn-handler:focus, #onetrust-consent-sdk .cookie-setting-link:focus-visible, #onetrust-consent-sdk .cookie-setting-link:focus {
    opacity: 1;
    padding: 0 0 0 0 !important;
    width: fit-content !important;
    margin: 16px auto 0 auto !important;
    outline-offset: 1px !important;
    outline: -webkit-focus-ring-color auto 1px !important;
    outline-color: #0075be !important;
    outline: 2px solid #005fcc !important;
  }
  
  #onetrust-consent-sdk #onetrust-pc-sdk #ot-pc-desc a:focus, #onetrust-consent-sdk #onetrust-pc-sdk #ot-pc-desc a:focus-visible {
    opacity: 1;
    padding: 0 0 0 0 !important;
    width: fit-content !important;
    outline-offset: 1px !important;
    outline: -webkit-focus-ring-color auto 1px !important;
    outline-color: #0075be !important;
    outline: 2px solid #005fcc !important;
    border-radius: 1px !important;
  }
  
  #onetrust-banner-sdk #onetrust-policy-text a:focus, #onetrust-banner-sdk #onetrust-policy-text a:focus-visible, #onetrust-banner-sdk #onetrust-close-btn-container button:focus, #onetrust-banner-sdk #onetrust-close-btn-container button:focus-visible {
    outline-offset: 1px !important;
    outline-color: #0075be !important;
    outline: 2px solid #005fcc !important;
    border-radius: 1px !important;
  }
  
  #onetrust-consent-sdk #onetrust-accept-btn-handler:focus, #onetrust-consent-sdk #onetrust-accept-btn-handler:focus-visible {
    text-decoration: underline !important;
    background-color: rgb(0, 85, 135) !important;
    outline: 2px solid #005fcc !important;
    opacity: 1 !important;
    position: relative !important;
    overflow: hidden !important;
  }
  
  #onetrust-pc-sdk .ot-acc-hdr input#ot-group-id-C0004:focus, #onetrust-pc-sdk .ot-acc-hdr input#ot-group-id-C0003:focus, #onetrust-pc-sdk .ot-acc-hdr input#ot-group-id-C0002:focus {
    outline: 0px solid transparent !important;
  }
  /* End Focus States */
  
  #onetrust-pc-btn-handler::after { 
    content: url('https://www.bmo.com/dist/icons/chevron.svg');
    display: inline-block;
    vertical-align: middle;
    padding-top: 4px;
  }
  
  #onetrust-banner-sdk.otFlat {
    overflow-y: hidden;
  }
  
  #onetrust-banner-sdk #onetrust-policy {
    margin: 0 !important;
  }
  
  #onetrust-consent-sdk #onetrust-group-container #onetrust-policy-text {
    font-size: 16px !important;
    font-weight: 300 !important;
    padding-bottom: 8px !important;
  }
  
  #onetrust-banner-sdk .ot-sdk-container #onetrust-button-group {
    display: grid !important;
    justify-content: flex-end !important;
    margin: 0 !important;
  }
  
  #onetrust-consent-sdk #onetrust-pc-btn-handler, #onetrust-consent-sdk #onetrust-pc-btn-handler.cookie-setting-link {
    padding-top: 0 !important;
    padding-bottom: 0 !important;
    margin: 16px auto 0 auto !important;
    order: 2;
    font-size: 16px !important;
  }
  
  #onetrust-consent-sdk #onetrust-accept-btn-handler {
    margin: 0 !important;
    order: 1;
    text-transform: uppercase;
    padding: 0 48px !important;
    font-weight: 600;
    font-size: 14px;
    height: 56px;
    border-radius: 28px;
  }
  
  #onetrust-pc-sdk .ot-btn-container button, #onetrust-pc-sdk #accept-recommended-btn-handler {
    border-radius: 28px !important;
  }
  
  #onetrust-banner-sdk .ot-sdk-container .ot-sdk-row {
    max-width: 1200px !important;
    margin-right: auto !important;
    margin-left: auto !important;
    display: flex !important;
    justify-content: space-between !important;
    align-items: center !important;
    padding: 48px 0px 40px 0px !important;
  }
  
  #onetrust-banner-sdk .ot-sdk-container #onetrust-group-container {
    padding-left: 0px !important;
  }
  
  #onetrust-pc-sdk .onetrust-pc-policy-link {
    font-weight: bold !important;
    color: #0075be !important;
    margin-left: 0 !important;
    margin-top: 0 !important;
  }
  
  #onetrust-pc-sdk .ot-accordion-layout h4~.ot-always-active {
    color: #0075be !important;
  }
  
  /* Media Queries Start Here */
  @media only screen and (min-width: 1440px) {
    #onetrust-banner-sdk .ot-sdk-container .ot-sdk-row {
      padding: 48px 0 40px 0 !important;
    }
    #onetrust-banner-sdk .ot-sdk-container #onetrust-group-container {
      padding-left: 0 !important;
    }
    #onetrust-banner-sdk:not(.ot-iab-2) .ot-sdk-row #onetrust-group-container {
      flex: 0 0 70% !important;
      width: 70% !important;
    }
    #onetrust-banner-sdk:not(.ot-iab-2) .ot-sdk-row #onetrust-button-group-parent {
      position: static !important;
      flex: 0 0 30% !important;
      width: 30% !important;
      margin: 0 !important;
      transform: translateY(0) !important;
    }
  }
  
  @media only screen and (min-width: 1280px) {
    #onetrust-banner-sdk .ot-sdk-container .ot-sdk-row {
      padding: 48px 0 40px 0 !important;
