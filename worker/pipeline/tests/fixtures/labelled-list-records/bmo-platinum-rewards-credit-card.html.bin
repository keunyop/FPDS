    Custom CSS for Canada Wide Banner
    Access Template Here: https://app-ca.onetrust.com/cookies/templates/edit/a731883e-adcd-41fb-99ac-b7af835eaa34
*/
.ot-pc-footer-logo{
padding-top:10px!important;
}
#onetrust-pc-sdk .save-preference-btn-handler{
margin-right:0px!important;
}
#onetrust-consent-sdk {
  font-family: "Heebo", Arial, Sans-Serif;
}

/* close button */
#onetrust-banner-sdk #onetrust-close-btn-container {
  position: absolute !important;
  top: 15% !important;
  right: 0 !important;
}

/* Focus States */
#onetrust-policy-text a:focus-visible {
outline-offset: 1px;
outline: -webkit-focus-ring-color auto 1px;
}

/* Handling the spacing in footer for california specific privacy button, it stays hidden for all templates except california so need the following css to handle the gap   */
  ul:has(li > span#ot-sdk-listitem) {
    gap: 0;
  }

  ul:has(li > span#ot-sdk-listitem) > li {
    margin-right: 42px;
  }

  ul:has(li > span#ot-sdk-listitem) > li:has(> span#ot-sdk-listitem) {
    margin-right: 0;
  }

#onetrust-consent-sdk #onetrust-pc-btn-handler:focus-visible, #onetrust-consent-sdk #onetrust-pc-btn-handler:focus, #onetrust-consent-sdk .cookie-setting-link:focus-visible, #onetrust-consent-sdk .cookie-setting-link:focus {
  opacity: 1;
  padding: 0 0 0 0 !important;
  width: fit-content !important;
  margin: 16px auto 0 auto !important;
  outline-offset: 1px;
  outline: -webkit-focus-ring-color auto 1px;
}

#onetrust-consent-sdk #onetrust-accept-btn-handler:focus {
  text-decoration: underline;
  background-color: rgb(0, 85, 135);
  opacity: 1;
}
/* End Focus States */

#onetrust-pc-btn-handler::after { 
  content: url('https://www.bmo.com/dist/icons/chevron.svg');
  display: inline-block;
  vertical-align: middle;
}

#onetrust-banner-sdk.otFlat {
  overflow-y: hidden;
}

#onetrust-banner-sdk #onetrust-policy {
  margin: 0 !important;
}

#onetrust-consent-sdk #onetrust-policy-text {
  font-size: 16px !important;
  font-weight: 300 !important;
  padding-bottom: 16px !important;
}

#onetrust-banner-sdk #onetrust-button-group {
  display: grid !important;
  justify-content: flex-end !important;
  margin: 0 !important;
}

#onetrust-consent-sdk #onetrust-pc-btn-handler, #onetrust-consent-sdk #onetrust-pc-btn-handler.cookie-setting-link {
  padding-top: 0 !important;
  padding-bottom: 0 !important;
  margin: 16px auto 0 auto !important;
  order: 2;
  font-size: 14px;
}

#onetrust-consent-sdk #onetrust-accept-btn-handler {
  margin: 0 !important;
  order: 1;
  text-transform: uppercase;
  padding: 0 48px !important;
  font-weight: 600;
  font-size: 14px;
  height: 56px;
  border-radius: 28px;
}

#onetrust-pc-sdk .ot-btn-container{
text-align: center !important;
margin-left: 25px!important;
margin-right: 25px!important;
}

#onetrust-pc-sdk .ot-plus-minus span {
background: #0075be
}

/* Media Queries Start Here */
@media only screen and (min-width: 1440px) {
  #onetrust-banner-sdk .ot-sdk-row {
      padding: 48px 152px 24px 152px !important;
  }
}

@media only screen and (min-width: 1280px) {
  #onetrust-banner-sdk:not(.ot-iab-2) #onetrust-group-container {
    width: 70% !important;
  }
  #onetrust-banner-sdk:not(.ot-iab-2) #onetrust-button-group-parent {
    width: 30% !important;
    padding-left: 0 !important;
    padding-right: 0 !important;
  }
}

@media only screen and (max-width: 1439px) and (min-width: 821px) {
  #onetrust-banner-sdk .ot-sdk-row {
    padding: 48px 80px 24px 32px !important;
  }
  #onetrust-banner-sdk:not(.ot-iab-2) #onetrust-button-group-parent {
    width: 40% !important;
  }
}

@media only screen and (max-width: 820px) and (min-width: 601px) {
  #onetrust-banner-sdk:not(.ot-iab-2) #onetrust-group-container {
    width: 60% !important;
  }
}

@media only screen and (max-width: 896px) {
  #onetrust-banner-sdk #onetrust-close-btn-container {
    position: absolute !important;
    top: 0 !important;
    right: 0 !important;
  }
}

@media only screen and (max-width: 600px) {
  #onetrust-banner-sdk .ot-sdk-row {
    padding: 48px 0 24px 0 !important;
  }
  #onetrust-banner-sdk:not(.ot-iab-2) #onetrust-group-container {
    width: 90% !important;
  }
  #onetrust-banner-sdk #onetrust-button-group-parent {
    padding-top: 24px;
    width: 90% !important;
  }
  #onetrust-banner-sdk #onetrust-button-group {
    justify-content: flex-start !important;
  }
  #onetrust-banner-sdk #onetrust-close-btn-container {
    top: 2% !important;
  }
}
