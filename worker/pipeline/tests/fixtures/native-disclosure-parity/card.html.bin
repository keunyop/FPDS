    <div class="longformtext base parbase">

    
        <div class="margins-padding no-sides no-margin-sides no-margin-top no-margin-bottom small-padding-top no-bottom  none opacity-100     none" style=" background-color: ; border-color: ; background-position: center; background-repeat: no-repeat; background-size: cover;">
            
            
                <p><a data-screenreader=" for the Simplii Financial Cash Back Visa Card. Opens in a dialog." href="/en/overlays/are-you-a-simplii-online-banking-client.html" class="modal-link inlineLink DefaultColor" id="buttonid-1625149374981">Apply now<span class="show-for-sr"> for the Simplii Financial Cash Back Visa Card. Opens in a dialog.</span></a></p>
            
            
            
            
