    display: inline-block;
    background-repeat: no-repeat;
    background-size: contain;
  }
  #simplii-calculator-cash-back .tile-wrapper .control button.button-minus>span{
    top:-10px; 
    background-image: url("/content/dam/simplii-assets/development/calculators/cashback-visa/icons/remove-lilac.svg"); 
  }
  #simplii-calculator-cash-back .tile-wrapper .control button.button-plus>span{ 
    top:-10px;   
    background-image: url("/content/dam/simplii-assets/development/calculators/cashback-visa/icons/add-lilac.svg"); 
  }
  
  #simplii-calculator-cash-back .tile-wrapper .control div.input-column{
    border-top: 2px solid #000000;  
    border-bottom: 2px solid #000000;     
  }
  #simplii-calculator-cash-back .tile-wrapper .control div.input-column .input-no-focus {
    position: absolute;
    font-family: Inter-SemiBold, Helvetica, Arial, sans-serif;
    width: 100%;
    height: 100%;
    z-index: 9;
