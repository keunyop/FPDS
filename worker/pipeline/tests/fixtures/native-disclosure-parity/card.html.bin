    }
    #simplii-calculator-cash-back.n6-lines .end .tile-wrapper {
      min-height: 438px;
    }
    
    #simplii-calculator-cash-back .end .tile-wrapper .bottom{
      position: absolute;
      width: 100%;
      padding: 0px 15px;
      left: 0;
      bottom: 95px;
    }

    #simplii-calculator-cash-back .end .tile-wrapper .bottom p {
      font-size: 20px;
    }
    #simplii-calculator-cash-back.n5-lines .end .tile-wrapper {
      min-height: 426px;
    }
    #simplii-calculator-cash-back.n6-lines .end .tile-wrapper {
      min-height: 478px;
    }
  }
  @media only screen and (max-width: 1158px) and (min-width: 1024px) {
      #simplii-calculator-cash-back.n6-lines .tile-wrapper .bottom p.top-text{
        min-height: 223px;
      }

      #simplii-calculator-cash-back.n6-lines .end .tile-wrapper {
        min-height: 503px;
      }
  }
  
  </style> 
</p><div id="simplii-calculator-cash-back" class="calculator-wrapper row n6-lines"> 
