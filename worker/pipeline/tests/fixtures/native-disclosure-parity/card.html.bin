  {
    padding: 0px 15px;
  }
  
  #simplii-calculator-cash-back .tile-wrapper .bottom .control
  {
    text-align: center;
    margin-bottom: 5px;
    display:inline-block;
    
    padding:0px; 
    width:100%;
    max-width:340px;
  }
  #simplii-calculator-cash-back .tile-wrapper .control>div{padding:0;}
  
  #simplii-calculator-cash-back .tile-wrapper .control button{
    width: 100%;
    height: 0;
    padding: 25px 0px;
    margin: 0px;
    background-color: #fff;
    position: relative;
    display:block;
    text-align: center;
    z-index: 10;
    border-radius: 4px 0 0 4px;
    border: 2px solid #000000;
  }
  #simplii-calculator-cash-back .tile-wrapper .control button.button-minus{
    border-radius: 4px 0 0 4px;
  
  }
  #simplii-calculator-cash-back .tile-wrapper .control button.button-plus{
    border-radius: 0 4px 4px 0;
  }
  #simplii-calculator-cash-back .tile-wrapper .control button>span{
    position: relative;
