<script type="text/javascript">
  
  
  $(function(){
  //Variables
  
    var tile_name, fixDecimal = 100,
     rest_amount = 0, gas_amount = 0, other_amount = 0,
    base_earn = 0.005,
    rest_multi = (0.04 * fixDecimal - base_earn * fixDecimal) / fixDecimal, 
    gas_multi = (0.015 * fixDecimal - base_earn * fixDecimal) / fixDecimal, 
    other_multi = 0,
    rest_promo = (0.10 * fixDecimal - rest_multi * fixDecimal - base_earn * fixDecimal) / fixDecimal, 
    gas_promo = 0, other_promo = 0,
    rest_cap = 5000, gas_cap = 15000, other_cap = 0,
    rest_promo_cap = 500, gas_promo_cap = 0, other_promo_cap = 0,
    rest_cb_earn_base, gas_cb_earn_base,other_cb_earn_base,
    rest_cb_mult, gas_cb_mult, other_cb_mult,
    rest_cb_promo, rest_cb_promo, other_cb_promo,
    rest_total, gas_total, other_total,
    total;
  
    var invalid_values = ["e","-",".","+"];
  
    tilesEqualSize();
    $(window).resize(function(){
      tilesEqualSize();
    })
    
  
    $("#simplii-calculator-cash-back").find(".input-calculator").keydown(function(event)
    {
      if(invalid_values.includes(event.key)) event.preventDefault();    
    }); 
    $("#simplii-calculator-cash-back").find(".input-calculator").keyup(function()
    {
      tile_name = $(this).data("tile-name");
      check_errors(tile_name, false);
    }); 
  
    $("#simplii-calculator-cash-back").find(".input-no-focus").click(function(){
      $(this).parents(".input-column").find(".input-calculator").focus();
    });
    $("#simplii-calculator-cash-back").find(".input-calculator").focus(function(){
        $(this).select();
        $(this).parents(".input-column").addClass("input-focus");
    });
    $("#simplii-calculator-cash-back").find(".input-calculator").focusout(function(){
      $(this).parents(".input-column").removeClass("input-focus");
      tile_name = $(this).data("tile-name");
      check_errors(tile_name,true);
    });
  
    $("#simplii-calculator-cash-back").find("button").click(function()
    {
      if($(this).hasClass("button-minus"))
      { 
        $(this).parents(".control").find("input").val(parseInt($(this).parents(".control").find("input").val()) - 100);
      }
      else if($(this).hasClass("button-plus"))
      {
        $(this).parents(".control").find("input").val(parseInt($(this).parents(".control").find("input").val()) + 100);
      } 
      tile_name = $(this).parents(".control").find("input").data("tile-name");
      check_errors(tile_name,true);
    });
  
  
  
    function check_errors(tile_name, readerActive){ 
      
      var input_amount = $("#simplii-calculator-cash-back").find(".input-"+ tile_name).val();
      input_amount.replace(/[^0-9]/g, "");
      if (input_amount > 9999 ){
        input_amount = 9999;
        $("#simplii-calculator-cash-back").find(".input-"+ tile_name).val(input_amount);
      }else if (input_amount<0 || input_amount==""){      
        input_amount = 0;
      } 
  
      //Update inputs if it is different
      if(readerActive && (input_amount !== $("#simplii-calculator-cash-back").find(".input-"+ tile_name).val()) )
      {
        $("#simplii-calculator-cash-back").find(".input-"+ tile_name).val(input_amount);      
      }
      //Update text spans if it is different
      if( ("$" + input_amount.toString().replace(/\B(?=(\d{3})+(?!\d))/g, ",")) != $("#simplii-calculator-cash-back .tile-"+ tile_name).find(".input-no-focus>span").html() )
      {
        $("#simplii-calculator-cash-back .tile-"+ tile_name).find(".input-no-focus>span").html("$" + input_amount.toString().replace(/\B(?=(\d{3})+(?!\d))/g, ","));
      } 
      simplii_calc(readerActive);
    }
  
    function simplii_calc(readerActive)
    {
    
    //montly amount 
      rest_amount =  $("#simplii-calculator-cash-back").find(".input-rest").val();
      gas_amount =  $("#simplii-calculator-cash-back").find(".input-gas").val();
      other_amount =  $("#simplii-calculator-cash-back").find(".input-other").val();
      
    //Anual amount
      rest_amount*=12;
      gas_amount*=12;
      other_amount*=12;
  
    //Cash back on base earn
      rest_cb_earn_base = (rest_amount * base_earn * fixDecimal) / fixDecimal,
      gas_cb_earn_base = (gas_amount * base_earn * fixDecimal) / fixDecimal,
      other_cb_earn_base = (other_amount * base_earn * fixDecimal) / fixDecimal;
  
    //Cash back on multiplier
      rest_cb_mult = (rest_amount>rest_cap?(rest_cap*rest_multi):(rest_amount*rest_multi));
      gas_cb_mult = (gas_amount>gas_cap?(gas_cap*gas_multi):(gas_amount*gas_multi));
      other_cb_mult = (other_amount>other_cap?(other_cap*other_promo):(other_amount*other_promo));
  
    //Cash back on promo rate
      rest_cb_promo = (rest_amount>rest_promo_cap?rest_promo_cap*rest_promo:rest_amount*rest_promo);
      gas_cb_promo = (gas_amount>gas_promo_cap?gas_promo_cap*gas_promo:gas_amount*gas_promo);
      other_cb_promo = (other_amount>other_promo_cap?other_promo_cap*other_promo:other_amount*other_promo);
  
    //Total cash back 
      rest_total = (rest_cb_earn_base + rest_cb_mult + rest_cb_promo);
      gas_total = (gas_cb_earn_base + gas_cb_mult + gas_cb_promo);
      other_total = (other_cb_earn_base + other_cb_mult + other_cb_promo);
  
    //Cash back before promo 
      total = Math.round((rest_total + gas_total + other_total) * 1) / 1;
      total_bf_promo = Math.round((rest_total + gas_total + other_total - rest_cb_promo) * 1) / 1;
      $("#simplii-calculator-cash-back").find(".total-cash-back-promo").html(total.toString().replace(/\B(?=(\d{3})+(?!\d))/g, ","));
      $("#simplii-calculator-cash-back").find(".total-cash-back").html(total_bf_promo.toString().replace(/\B(?=(\d{3})+(?!\d))/g, ","));
      
      if(readerActive)
        $("#simplii-calculator-cash-back").find(".total-cash-back-promo-live").html("Your estimated rewards: " + total_bf_promo + " dollars per year.");
      
    }
    //It will equalize the heigh of the columns for more especific screen sizes
    function tilesEqualSize(){
      var aux_height=0;
      $("#simplii-calculator-cash-back").removeClass("n5-lines").removeClass("n6-lines");
      $("#simplii-calculator-cash-back .tile-wrapper .bottom .top-text").each(function(){
        if(aux_height<$(this).height()){
          aux_height=$(this).height();
  
          if(aux_height>144)
          {
            $("#simplii-calculator-cash-back").removeClass("n5-lines").addClass("n6-lines");
          }
          else if(aux_height>110)
          {
            $("#simplii-calculator-cash-back").removeClass("n6-lines").addClass("n5-lines");
          }
          
        } 
      })
    }
  
  })
  </script><p></p>


</div>



                                    
