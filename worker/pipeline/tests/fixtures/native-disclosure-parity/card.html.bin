    <p><style type="text/css">
  
  #simplii-calculator-cash-back .tile-wrapper{
    border:1px solid #0B283D;
    border-bottom:0;
    overflow: hidden;
    background-color:#fff;
    text-align: center;
    min-height: 0;
    max-width:460px;  
    margin:auto;
    padding:23px 10px 15px;
  }
  #simplii-calculator-cash-back .tile-rest .tile-wrapper{
    border-top-left-radius:10px;
    border-top-right-radius:10px;
  }

  #simplii-calculator-cash-back .tile-total {
    display: block;
  }

  #simplii-calculator-cash-back .tile-total .tile-wrapper{
    border-bottom-left-radius:10px;
    border-bottom-right-radius:10px;
  }
  #simplii-calculator-cash-back .tile-wrapper .top img{
    display:none;
  }
  
  
  #simplii-calculator-cash-back .tile-wrapper .earn-circle {
    position: relative;      
  }
  #simplii-calculator-cash-back .tile-wrapper .earn-circle *{
    font-size:18px;
      font-family: Inter-SemiBold, Helvetica, Arial, sans-serif;     
  }
  
  #simplii-calculator-cash-back .tile-wrapper .earn-circle>div {   
    display:inline-block;    
  }
  #simplii-calculator-cash-back .tile-wrapper .earn-circle>div>div {
    display:inline; 
  }
  
