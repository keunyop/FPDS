  }
  #simplii-calculator-cash-back .tile-wrapper .control div.input-column.input-focus .input-no-focus {
    display:none;
  }
  
  #simplii-calculator-cash-back .tile-wrapper .control input[type=number]::-webkit-inner-spin-button,
  #simplii-calculator-cash-back .tile-wrapper .control input[type=number]::-webkit-outer-spin-button{-webkit-appearance:none;margin:0}
