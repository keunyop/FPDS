}

#onetrust-pc-sdk .ot-accordion-layout .ot-acc-grpdesc {
font-size: 1rem !important;
}

.ot-always-active {
color: dimgray !important;
}

#onetrust-pc-sdk .ot-tgl input:checked+.ot-switch .ot-switch-nob {
background-color: #0B283D;
border: 1px solid #0B283D;
}

#onetrust-pc-sdk .ot-tgl input:checked+.ot-switch .ot-switch-nob:before {
background-color: #FFF;
border-color: #FFF;
}

#onetrust-pc-sdk .ot-switch-nob {
background-color: #FFF;
border: 1px solid #606366;
padding-left: 1px !important;
}

#onetrust-pc-sdk .ot-switch-nob:before {
background-color: #606366;
}

.privacy-notice-link:focus, #accept-recommended-btn-handler:focus {
outline: 1px solid #FFF !important;
}

#accept-recommended-btn-handler:focus {
outline: 1px solid #0B283D !important;
}

.lang-selector {
margin-bottom: 5px !important; 
}

.left-selector {
margin-left: 0 !important;  
margin-right: .3em;
text-decoration: none;
font-size: .8em;
text-decoration: none !important;
color: #222428 !important;
border-bottom: 2px solid #222428 !important;
}

.right-selector {
margin-left: 0 !important;
margin-left: .3em;
text-decoration: none;
font-size: .8em;
text-decoration: none !important;
color: #222428 !important;
border-bottom: 2px solid #222428 !important;
}

.left-selector:hover, .right-selector:hover {
color: #222428 !important;
border-bottom: 2px solid #0B283D !important;
}

.policy-link {
margin-left: 0 !important;
text-decoration: none !important;
color: #222428 !important;
border-bottom: 2px solid #222428 !important;
}

.policy-link:hover {
color: #222428 !important;
border-bottom: 2px solid #0B283D !important;
}

#close-pc-btn-handler:hover {
opacity: 1 !important;
border-bottom: 2px solid #0B283D !important;
}

#close-pc-btn-handler, .ot-close-icon {
top: 20px !important;
right: 10px !important;
}

.ot-close-icon {
height: 25px !important;
width: 25px !important;
}

.shutter-link {
text-decoration: none !important;
border-bottom: 1px solid #383B3E !important;
}

.shutter-link:hover {
border-bottom: 1px solid #C41F3E !important;
color: #C41F3E !important;
}

#onetrust-pc-sdk .ot-tgl input:checked+.ot-switch .ot-switch-nob:before {
    content: "\2713" !important;
    color: #0B283D;
    font-size: 15px;
    text-align: center;
    align-content: center;
    position: absolute;
}

#onetrust-pc-sdk .ot-switch-nob:before {
    content: "\2715" !important;  
    font-size: 12px;
    color: #FFF;
    align-content: center;
    text-align: center;
