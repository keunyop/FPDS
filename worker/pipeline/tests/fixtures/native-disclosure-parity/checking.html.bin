#ot-pc-desc {
font-size: 1rem !important;
}

#accept-recommended-btn-handler, .ot-pc-refuse-all-handler, .save-preference-btn-handler {
border-radius: 6.25rem !important;
min-height: 3rem !important;
padding: 0.6875rem 1.875rem !important;
background-color: #FFF !important;
border: 1px solid #0B283D!important;
font-size: 1rem !important;
color: #0B283D !important;
letter-spacing: .01em !important;
}

.save-preference-btn-handler {
border-radius: 6.25rem !important;
height: 3rem !important;
padding: 0.6875rem 1.875rem !important;
background-color: #0B283D !important;
font-size: 1rem !important;
color: #FFF !important;
letter-spacing: .01em !important;
}

.ot-pc-footer-logo {
display: none !important;
}

#onetrust-pc-sdk .ot-btn-container {
text-align: center !important;
margin: 0 0.75em !important;
}

#onetrust-pc-sdk .save-preference-btn-handler {
margin-right: 0px !important;
}

#accept-recommended-btn-handler:hover, .ot-pc-refuse-all-handler:hover, .save-preference-btn-handler:hover {
background-color: #121418 !important;
color: #FFF !important;
opacity: 1 !important;
border-color: #121418 !important;
}

.save-preference-btn-handler:hover {
background-color: #121418 !important;
color: #FFF !important;
opacity: 1 !important;
border-color: #121418 !important;
}

#onetrust-policy-text {
  font-size: 1em !important;
}

#ot-header-id-C0001, #ot-header-id-C0004, #ot-header-id-C0003, #ot-header-id-C0005, #ot-header-id-C0002 {
font-size: 1rem !important; 
color: #222428 !important;
}

#onetrust-pc-sdk .ot-accordion-layout .ot-acc-grpdesc {
font-size: 1rem !important;
}

.ot-always-active {
color: dimgray !important;
}

#onetrust-pc-sdk .ot-tgl input:checked+.ot-switch .ot-switch-nob {
background-color: #0B283D;
border: 1px solid #0B283D;
}

#onetrust-pc-sdk .ot-tgl input:checked+.ot-switch .ot-switch-nob:before {
background-color: #FFF;
border-color: #FFF;
}

#onetrust-pc-sdk .ot-switch-nob {
background-color: #FFF;
border: 1px solid #606366;
padding-left: 1px !important;
}

#onetrust-pc-sdk .ot-switch-nob:before {
background-color: #606366;
}

.privacy-notice-link:focus, #accept-recommended-btn-handler:focus {
outline: 1px solid #FFF !important;
}

#accept-recommended-btn-handler:focus {
outline: 1px solid #0B283D !important;
}

.lang-selector {
margin-bottom: 5px !important; 
}

.left-selector {
margin-left: 0 !important;  
margin-right: .3em;
text-decoration: none;
font-size: .8em;
text-decoration: none !important;
color: #222428 !important;
border-bottom: 2px solid #222428 !important;
}

.right-selector {
margin-left: 0 !important;
margin-left: .3em;
text-decoration: none;
font-size: .8em;
text-decoration: none !important;
color: #222428 !important;
border-bottom: 2px solid #222428 !important;
}

.left-selector:hover, .right-selector:hover {
color: #222428 !important;
border-bottom: 2px solid #0B283D !important;
}

.policy-link {
margin-left: 0 !important;
text-decoration: none !important;
color: #222428 !important;
border-bottom: 2px solid #222428 !important;
}

.policy-link:hover {
color: #222428 !important;
border-bottom: 2px solid #0B283D !important;
}

#close-pc-btn-handler:hover {
opacity: 1 !important;
border-bottom: 2px solid #0B283D !important;
}

#close-pc-btn-handler, .ot-close-icon {
top: 20px !important;
right: 10px !important;
}

.ot-close-icon {
height: 25px !important;
width: 25px !important;
}

.shutter-link {
text-decoration: none !important;
border-bottom: 1px solid #383B3E !important;
}

.shutter-link:hover {
border-bottom: 1px solid #C41F3E !important;
color: #C41F3E !important;
}

#onetrust-pc-sdk .ot-tgl input:checked+.ot-switch .ot-switch-nob:before {
    content: "\2713" !important;
    color: #0B283D;
    font-size: 15px;
    text-align: center;
    align-content: center;
    position: absolute;
}

#onetrust-pc-sdk .ot-switch-nob:before {
    content: "\2715" !important;  
    font-size: 12px;
    color: #FFF;
    align-content: center;
    text-align: center;
