							<span class="tabText"><span class="body-bold">Can I make a purchase from the USD account?</span> </span>
							<span class="accordionArrow icon-arrow-down"></span>
						</button>
						<div class="content" role="region" id="accordion-1791361126462-tabpanel-7" aria-labelledby="accordion-1791361126462-btn-7" style="display: none;">
							
								




    
    
