		/* standard: 10px */
		.small-dividers .collapse-inner {
			padding-left: 0;
		}

		.small-dividers .collapse-inner p,
		.small-dividers .collapse-inner ul {
			margin-top: 30px;
		}

		/* standard: max-width is 770px */
		.small-dividers .collapse-content {
			max-width: 100%;
		}

		.small-dividers .collapse-content a {
			font-weight: 300 !important;
			text-decoration: underline !important;
		}

		/* style all the rates tables */
		table.outlines th {
			text-align: left;
			vertical-align: top;
			padding: 15px;
			border-bottom: 2px solid #73b0e3;
		}

		table.outlines td:first-child {
			font-weight: 500;
		}

		table.outlines th,
		table.outlines td {
			min-width: 50%;
			width: 50%;
		}

		.table-morph:last-child {
			margin-bottom: 30px;
		}

		/* disclaimer font size adjustment */
		.text-disclaimer p,
		.text-disclaimer ul li {
			font-size: 16px;
			line-height: 24px;
		}
		/* design-specific quirks */
		@media print {
			.collapse-content.collapse {
				display: block !important;
			}
			.collapse-toggle:before, .collapse-toggle:after {
				content: none !important;
			}
		}
	</style>
	
