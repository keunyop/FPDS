			font-size: 14px;
			font-weight: 700;
			line-height: normal;
		}

		.sticky-nav__custom .right-col {
			display: flex;
			align-items: center;
			gap: 14px;
		}

		.sticky-nav__custom .right-col .offer-desk,
		.sticky-nav__custom .right-col .offer-desk a {
			font-family: Georgia;
			font-size: 16px;
			font-style: italic;
			font-weight: 400;
			line-height: 24px;
		}

		.sticky-nav__custom .right-col .btn {
			font-size: 14px;
			font-weight: 500 !important;
			line-height: 20px !important;
			height: auto !important;
			padding: 14px 20px;
		}

		.sticky-nav__custom-center {
			display: flex;
			align-items: center;
			justify-content: space-between;
			gap: 15px;
			padding: 5px 15px;
			max-width: 1170px;
			margin: 0 auto;
