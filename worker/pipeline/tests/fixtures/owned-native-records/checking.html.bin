			<aside class="sticky-nav__custom sticky-offset">
				<div class="sticky-nav__custom-center">
					<div class="left-col">
						<h1>RBC Day to Day Banking Account</h1>
					</div>
					<div class="right-col">
						<a class="btn primary mar-t-0" target="_blank" data-select-item="022" data-item-details="begin_checkout" href="https://public.rbcroyalbank.com/sgw1/cb/public-account-open?lang=en-CA&pid1=022" style="border-radius: 0px;">Open Account</a>
					</div>
				</div>
		    </aside>

			<section id="overview">
				<div class="section-inner pad-t-0">
					<div class="flex-wpr flex-direction-row flex-nowrap gap-30 flex-mob-direction-column-reverse" style="overflow: clip;">
						<div class="flex-2 flex-col-gap">
							<div class="sticky-wrapper product-sticky-wrapper desktop-only">
								<div class="nav-bar product-sticky" data-sticky="false">
									<div class="nav-inner mar-t-0 pad-t-0 pad-b-0 pad-l-0">
					
										<button class="nav-btn mar-t-hlf"><span>MENU</span></button>
					
										<div class="left-content">
											<h1 id="page-title" class="nav-location" tabindex="-1">RBC Day to Day Banking Account</h1>
										</div>
					
										<div class="right-content">
										</div>
									</div>
								</div>
							</div>
							<div id="sts" class="banner-box tundra-3-bg mar-b-0">
								<!-- <div class="top-img"></div> -->
								<div class="table-wpr pad">
									<div class="table-row">
										<!-- <div class="table-cell pad-r-qtr" style="vertical-align: middle;">
											<img src="/bank-accounts/chequing-accounts/_assets-custom/images/ratehub-best-student-chequing-acc-en-v1.png" class="mar-r-qtr" style="width:120px;" alt="best bank for newcomers">
										</div> -->
										<div class="table-cell" style="vertical-align: middle;">
											<h2 class="h4">Get your Essentials with a Low Monthly Fee Chequing Account</h2>
											<p>
												Streamline how money moves in and out of your account while enjoying everyday benefits and more ways to save, all with a low monthly fee.
											</p>
											<p class="text-disclaimer">
												Offered as a part of our low-cost and no-cost account commitment to Canadian consumers<sup><a href="#legal-dasterisk" class="scrollto">**</a></sup>
											</p>
										</div>
									</div>
								</div>
							</div>
							<div class="icon-copy-container">

								<h2 class="mar-tb-0">Top Chequing Account Benefits</h2>

								<div class="icon-copy-group component-bg-2">
									<div class="icon-copy-item-container icon-wallet">
										<div>
											<h3 class="icon-copy-title">Get a low monthly fee</h3>
											<p class="icon-copy-text">Pay little to no monthly fees through exclusive rebates and offers for eligible clients. </p>
										</div>
									</div>
									<div class="icon-copy-item-container icon-email-transfer">
										<div>
											<h3 class="icon-copy-title">Enjoy 12 included debit transactions</h3>
											<p class="icon-copy-text">Bank more freely with 12 debit transactions each month.<sup><a href="#legal-8" class="scrollto">8</a></sup></p>
										</div>
									</div>
									<div class="icon-copy-item-container icon-dollar-slash">
										<div>
											<h3 class="icon-copy-title">Get unlimited <em>Interac</em> e-Transfers</h3>
											<p class="icon-copy-text">Move money more easily with unlimited <em>Interac</em> e-Transfers<sup><a href="#legal-34" class="scrollto">34</a></sup> and transfers between your own accounts.<sup><a href="#legal-34" class="scrollto">34</a></sup></p>
										</div>
									</div>
								</div>

								<div class="desktop-only">
									<div class="flex gap-16">
										<h2 class="mar-tb-0 icon-copy-title">Plus Other Features</h2>

										<div class="icon-copy-group">
											<div class="icon-copy-item-container icon-credit-card">
												<div>
													<h3 class="icon-copy-title">Ride transit without debit fees</h3>
													<p class="icon-copy-text">
														Tap to pay for public transit without it counting toward your monthly debit limit.<sup><a href="#legal-8" class="scrollto">8</a></sup>
													</p>
												</div>
											</div>
											<div class="icon-copy-item-container card-icon-atm">
												<div>
													<h3 class="icon-copy-title">Shop online with ease</h3>
													<p class="icon-copy-text">Use your debit card like a credit card for online purchases with a Virtual Visa Debit.<sup><a href="#legal-35" class="scrollto">35</a></sup></p>
												</div>
											</div>

											<div class="icon-copy-item-container icon-receipt">
												<div>
													<h3 class="icon-copy-title">Enjoy no minimum balance</h3>
													<p class="icon-copy-text">Unlock all benefits of your account without maintaining a minimum balance.</p>
												</div>
											</div>
										</div>
									</div>
								</div>

								<div class="mobile-only">
									<div class="accordion" id="accordion-other-features-set">
										<div class="accordion-panel">
											<button id="accordion-other-features-title-1" class="collapse-toggle collapsed" data-target="#accordion-other-features" data-toggle="collapse" data-parent="#accordion-other-features-set" aria-expanded="false" aria-controls="accordion-other-features">
												Plus Other Features
											</button>
											<div class="collapse-content collapse" id="accordion-other-features" role="region" aria-labelledby="accordion-other-features-title-1">
												<div class="collapse-inner">
													<div class="icon-copy-item-container icon-credit-card">
														<div>
															<h3 class="icon-copy-title">Ride transit without debit fees</h3>
															<p class="icon-copy-text">
																Tap to pay for public transit without it counting toward your monthly debit limit.<sup><a href="#legal-8" class="scrollto">8</a></sup>
															</p>
														</div>
													</div>
													<div class="icon-copy-item-container card-icon-atm">
														<div>
															<h3 class="icon-copy-title">Shop online with ease</h3>
															<p class="icon-copy-text">Use your debit card like a credit card for online purchases with a Virtual Visa Debit.<sup><a href="#legal-35" class="scrollto">35</a></sup></p>
														</div>
													</div>

													<div class="icon-copy-item-container icon-receipt">
														<div>
															<h3 class="icon-copy-title">Enjoy no minimum balance</h3>
															<p class="icon-copy-text">Unlock all benefits of your account without maintaining a minimum balance.</p>
														</div>
													</div>
												</div>
											</div>
										</div>
									</div>
								</div>
							</div>

							<div id="premium-membership">
								<div>
									<h2 style="font-weight: 700;">Avion Rewards Premium Membership</h2>
									<p>Make everyday spending go further by earning Avion Points on your everyday debit purchases when you enroll in the RBC Value Program.</p>
								</div>
								<div>
									<p style="font-weight: 700; margin-bottom: 18px;">Benefits include:</p>
									<div class="points-container">
										<div>
											<div class="point-accelerator">
												<!-- img bg -->
												<span class="big-text text-center">1X</span>
												<span class="small-text text-center">per $10<br>spent</span>
											</div>
											<p>Earn a minimum of 1 point per $10 spent on everyday purchases</p>
										</div>
										<div>
											<img src="/bank-accounts/chequing-accounts/_assets-custom/images/premium-tier-cards.svg" width="80px" height="80px">
											<p>Redeem points for the things that matter most, from travel and everyday essentials to bill payments </p>
										</div>
										<div>
											<img src="/bank-accounts/chequing-accounts/_assets-custom/images/premium-tier-luggages.svg" width="80px" height="80px">
											<p>Save more by linking your card to our partners, unlocking extra value with Petro Points, Triangle Rewards, and more</p>
