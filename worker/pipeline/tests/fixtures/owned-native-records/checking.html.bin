	<script>

        $(document).ready(function() {
            let hashRegex = /[^a-zA-Z0-9\s\-]/g;
            const hash = location.hash.replace(hashRegex, "");
            const hashElement = document.getElementById(hash);

            if (hash !== "" && hashElement !== null) {

                // Wait 700ms at the top of the page on load
                setTimeout(function() {
                    const targetCollapse = $('#collapseButton').attr('data-target') || $('#collapseButton').attr('href');

                    // Listen for the exact moment THIS specific panel finishes opening
                    $(targetCollapse).one('shown.bs.collapse', function() {
                        // Kill the that tries to hijack this exact moment
                        $('html, body, .modal-inner').stop(true, true);

                        let stickyHeaderHeight = 0;
                        if ($(".sticky-nav__custom").length) {
                            stickyHeaderHeight = $(".sticky-nav__custom").height();
                        }

                        // scroll to the hash target
                        $('html, body, .modal-inner').animate({
                            'scrollTop': $(hashElement).offset().top - stickyHeaderHeight
                        }, 550);
                    });

                    // Programmatically open the panel
                    $(targetCollapse).collapse('show');

                }, 700);
            }
        });







		const accordionBtns = document.querySelectorAll(".accordion-panel > button.collapse-toggle");

		accordionBtns.forEach(btn => {

			btn.addEventListener("click", () => {

				const isAccordionExpanded = btn.getAttribute("aria-expanded");

				if(isAccordionExpanded !== 'false') {

					dataLayer.push({

						"event" : "click",

						"details": `collapsible - ${btn.textContent}`

					});

				}

			})

		});

		window.addEventListener("scroll", () => {
			console.log("scroll action")
			const stickyNavCustomEl = document.querySelector(".sticky-nav__custom");
			const overviewApplyBtn = document.getElementById("overview-apply-btn");
			const overviewApplyBtnTopPos = overviewApplyBtn.getBoundingClientRect().top;
			if(overviewApplyBtnTopPos < 1) {
					stickyNavCustomEl.style.display = "block";
			} else {
					stickyNavCustomEl.style.display = "none";
			}
		});

		$('.modal').on('click', '.scrolltomodaldisclaimer', function (e) {
			e.preventDefault();
			var $modalInner = $(this).closest('.modal-inner');
			var $target = $($(this).data('target') || $(this).attr('href'));
			var $collapseContent = $target.closest('.collapse-content');
			if (!$collapseContent.hasClass('show')) {
				// $collapseContent.addClass('in');
				$collapseContent.closest('.section-inner').find('.collapse-toggle').click();
			}
			setTimeout(function () {
				$modalInner.animate({ scrollTop: $modalInner.scrollTop() + $target.position().top - 18 }, 500);
				$target.prop('tabindex', '-1').focus();
			}, 500);
		});

	</script>


	<script>
		function pznFallback(element){
			dataLayer.push({
				event: 'error_generic',
				details: 'error_generic - 0000 - external personalization javascript failed to load'
			});
		}
	</script>
