	<script type='application/ld+json'> 
	{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "What is the RBC Day to Day banking account?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "RBC Day to Day Banking is a chequing account that provides 12 debit transactions each month, unlimited Interac e-Transfers, and more, with a low monthly fee of $4 that can be reduced to $0 through the Value Program rebate or other eligible waivers."
      }
    },
    {
      "@type": "Question",
      "name": "Is the RBC Day to Day bank account a no fee account?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "The RBC Day to Day Banking account is a low-fee account with a standard monthly fee of $4. However, you may be eligible to receive a full rebate on your monthly fee through the Value Program, a senior discount, or other waiver programs."
      }
    },
    {
      "@type": "Question",
      "name": "Can I receive multiple monthly fee rebates with the RBC Day to Day Banking account?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "No. You can only receive one monthly fee rebate per bank account. RBC will automatically apply the highest value rebate you are eligible for each month."
      }
    },
    {
      "@type": "Question",
      "name": "What happens when I no longer qualify for a rebate?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Once you no longer qualify for any of the available rebates, you will be charged the full monthly fee of $4."
      }
    },
    {
      "@type": "Question",
      "name": "How do I open a RBC Day to Day Banking account?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "You can open this account online via RBC Online Banking or the RBC Mobile app, or in person at an RBC branch."
      }
    },
    {
      "@type": "Question",
      "name": "What is the RBC Value Program and how do I enrol?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "The Value Program is a way for RBC clients with an eligible personal bank account to get more rewards and more savings. When you enrol an eligible RBC chequing account in the Value Program, you can earn Avion points on debit purchases and receive monthly fee rebates."
      }
    },
    {
      "@type": "Question",
      "name": "What type of transactions are included in my 12 debit transactions?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "A debit transaction can include: using your debit card to make purchases in store or online, ATM withdrawals, bill payments, and pre-authorized debits."
      }
    },
    {
      "@type": "Question",
      "name": "What happens if I go over my 12 included debit transaction limit?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "If you exceed your 12 debits a month, you will be charged $1.25 for each additional debit transaction."
      }
    },
    {
      "@type": "Question",
      "name": "How does the RBC Day to Day differ from the other chequing accounts?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "You can compare chequing accounts to discover key differences and choose what features are right for you. The Day to Day account is designed for clients who need basic everyday banking at a low monthly fee."
      }
    }
  ]
}

	</script>
