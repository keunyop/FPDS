			border-radius: 0;
		}

		.sticky-nav__custom .left-col {
			display: flex;
			align-items: center;
			gap: 16px;
		}

		.sticky-nav__custom h1 {
			font-size: 24px;
			font-weight: 500;
			line-height: 32px;
			margin: 0;
		}

		.sticky-nav__custom .m-fee {
			color: #000;
