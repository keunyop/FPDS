<script>
    document.addEventListener("DOMContentLoaded", () => {
        document.addEventListener("click", (event) => {
            const elementClasslist = event.target.classList;
            if(elementClasslist.contains("btn-compare") && !elementClasslist.contains("btn-compare-added")) {
                let parent = event.target.parentNode
                let cardPid = parent.getAttribute("data-card_pid");

                if (cardPid) {
                    // build string output
                    let details = `click - compare - ${cardPid}`;
        
                    dataLayer.push({ 
                        event: "click", 
                        details: details.trim()
                    });
                }
            }
        })
    })

    document.querySelectorAll('.mini-card-offer-caption').forEach(e => {
        e.textContent = e.textContent.toLowerCase();
    });
    
    document.querySelectorAll('.mini-card-content p>sup>a').forEach(e => {
        e.classList.add("external_legal_bug");
    });
</script>

