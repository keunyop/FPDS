<div class="high-contrast-test" style="width: 0px; height: 0px; background-image: url(/dvl/v1.0/assets/images/ui/ui-checkmark-blue.svg)"></div>
<script>
    if (typeof DOMPurify === "undefined") {
        DOMPurify = {
            sanitize: (params) => { return params; }
        };
    }

    // High contrast mode checker. if there is no background-image we are in high contrast mode
    if ($('.high-contrast-test').css('background-image') === 'none') {
        $('html').addClass('high-contrast-mode');
    }

    // Datalyer push for the Promotions link in the header
    $(document).ready(function() {

        $('#header-promotions-link').on('click', function(event) {
            dataLayer.push({
                'event':'dvlEvent',
                'category':'header DVL1_0',
                'action':'Click Link',
                'label':'Promotions'
            });  
        });

        $('.side-menu-promotions-link a').on('click', function(event) {
            dataLayer.push({
                'event':'dvlEvent',
                'category':'header DVL1_0',
                'action':'Click Link',
                'label':'Promotions'
            });  
        });
          
    });

    // OneTrust Modal Trigger
    $('.ot-sdk-show-settings').on('click', function(event) {
        event.preventDefault();
        OneTrust.ToggleInfoDisplay();
    });
</script>

	<script src="/credit-cards/_assets-custom/js/dvl-custom.js"></script>
	<script src="/credit-cards/_assets-custom/includes/gtm/includes/rbcroyalbank.com/cards.js"></script>
<script src="/credit-cards/_assets-custom/includes/gtm/js/gtm-functions.js" charset="UTF-8"></script>
	<!-- <script src="/credit-cards/_assets-custom/js/product-page-legal.js"></script> -->
	<!-- <script src="/credit-cards/_assets-custom/js/ecommerce-dl-push.js"></script> -->

	
	<script src="/credit-cards/transformer/js/cards/product-page-app.js" data-main-card-pid="IAV"></script>
	<script src="/credit-cards/transformer/js/cards/rbc-avion-visa-infinite/controller.js"></script>

	<!-- <script type="text/javascript" src="/credit-cards/transformer/js/travel/avion-app_AIV.js"></script> -->
	<!-- <script type="text/javascript" src="/credit-cards/transformer/js/travel/avion-app.js"></script> -->
	<script type="text/javascript" src="/credit-cards/transformer/js/cards/rbc-avion-visa-infinite/avion-app_AIV.js?1"></script>

	<script>

		// carousels take time to load, delay until all initialized
		$(document).ready(() => {

			let carouselInitInterval = setInterval(checkCarousel, 2000)

			function checkCarousel() {
				let tiers = document.querySelectorAll(".calculator-tier").length
				let carouselsInitialized = document.querySelectorAll(".calculator-tier > .slick-initialized").length

				if (tiers === carouselsInitialized) {
					clearInterval(carouselInitInterval)
					calculate()
					renderTier()
					
					document.querySelectorAll(".carousel-ctrl button").forEach(button => {
						button.addEventListener("click", function(e) {
							const parentCarousel = e.target.closest(".carousel-wpr");
							const activeItemIndex = parentCarousel.querySelector(".carousel-item.slick-current").getAttribute("default-slide-index");
							localStorage.setItem(parentCarousel.id + "_lastSlide", activeItemIndex);
						});
					});
					//$("#carousel-container").removeClass("hide")
				}
			}

			defer(function () {
				$(".nav-bar").sticky({
					topSpacing:0,
					responsiveWidth: true,
					zIndex: 100
				});

				$.fn.unstick = function() {
					return false;
				}
			});

			document.addEventListener("click", (event) => {
				const elementClasslist = event.target.classList;
				if(elementClasslist.contains("btn-compare") && !elementClasslist.contains("btn-compare-added")) {
					// card info is contained in data-card_name attribute of parent
					let parent = event.target.parentNode
					let cardName = parent.getAttribute("data-card_name")
					
					// build string output
					let details = "click - compare - "

					switch (cardName) {
						case "WestJet RBC World Elite Mastercard":
							details += "MC4"
							break;
						case "RBC Avion Visa Infinite Privilege":
							details += "AVP"
							break;
						case "RBC Avion Visa Platinum":
							details += "GCP"
							break;
					}

					dataLayer.push({ 
						event: "click", 
						details: details.trim()
					});
				}
			})
		})

		function defer(method) {
			if (jQuery().sticky) {
				method();
			} else {
				setTimeout(function() { defer(method) }, 50);
			}
		}

	</script>

	<!-- upperFunnelHandler.js -->
	<script src="/gtm/upperFunnelTagger.js"></script>
	<script src="/gtm/upperFunnelHandler.js"></script>
	<script src="/gtm/upperFunnelCreditCardsDynamicTagger.js"></script>

	<script src="/credit-cards/_assets-custom/js/doordash-expiry-date.js" defer></script>
    <script src="/mega-navigation/_assets-custom/js/mega-navigation.js"></script>
	<script>
		// custom script for handling the legal items in the awards section, which are shared with https://www.rbcroyalbank.com/credit-cards/award-winning-credit-cards.html
		$("sup[data-target]").each(function() {
			let link = $(this);
			let target = link.data("target");
			switch(target) {
				case "#legal-dasterisk":
					link.text("***");
					link.attr("data-target", "#legal-triple-asterisk");
					link.data("target", "#legal-triple-asterisk");
					break;
				case "#legal-dagger":
					link.text("††");
					link.attr("data-target", "#legal-ddagger");
					link.data("target", "#legal-ddagger");
					break;
				default:
					break;
			}
		});
	</script>
