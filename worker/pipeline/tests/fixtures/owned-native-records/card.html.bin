<div id="compareToolModal" class="modal" role="region" aria-labelledby="modal-title">
	<div class="modal-inner">
		<h2 id="modal-title"><span class="pad-lr">Choose your card</span></h2>
		<section aria-labelledby="popular-title">
			<div class="section-inner pad-0">
				<div id="categories-filter">
					<div class="container-fluid padding-mobile-none featured-cat">
						<div class="container">
							<div class="row">
								<div class="col-md-12">
									<p class="font-medium"> Select category: </p>
								</div>
								<div class="col-md-12 mar-t-qtr">
									<a class="btn tag mar-t-0" href="#travel" id="travel">Travel</a>
									<a class="btn tag mar-t-0" href="#rewards" id="rewards">Rewards</a>
									<a class="btn tag mar-t-0" href="#cashback" id="cashback">Cash Back</a>
									<a class="btn tag mar-t-0" href="#nofee" id="nofee">No Annual Fee</a>
									<a class="btn tag mar-t-0" href="#lowinterest" id="lowinterest">Low Interest</a>
									<a class="btn tag mar-t-0" href="#student" id="student">Student</a>
									<a class="btn tag mar-t-0 active" href="#all-cards" id="all-cards">All Cards</a>
								</div>
							</div>
							<div class="sub-category row">
								<div class="col-md-12 mar-t">
									<p class="font-medium"> Show cards with: </p>
								</div>
								<div class="col-md-12 mar-t-qtr">
									<div class="row filter-row">
										<div class="checkbox-wpr mar-b col-md-4">
											<input type="checkbox" id="flightairlinerewards_check" />
											<label for="flightairlinerewards_check" class="font-light text-gray-1"> Travel Rewards </label>
										</div>

										<div class="checkbox-wpr mar-b col-md-4">
											<input type="checkbox" id="travelinsurance_check" />
											<label for="travelinsurance_check" class="font-light text-gray-1"> Travel Insurance </label>
										</div>

										<div class="checkbox-wpr mar-b col-md-4">
											<input type="checkbox" id="purchaseinusdollars_check" />
											<label for="purchaseinusdollars_check" class="font-light text-gray-1"> US dollars </label>
										</div>

										<div class="checkbox-wpr mar-b col-md-4">
											<input type="checkbox" id="giftcardsandmerchandise_check" />
											<label for="giftcardsandmerchandise_check" class="font-light text-gray-1"> Gift Cards &amp; Merchandise </label>
										</div>

										<!-- <div class="checkbox-wpr mar-b col-md-4">
											<input type="checkbox" id="rbcrewards_check" />
											<label for="rbcrewards_check" class="font-light text-gray-1"> Avion Rewards </label>
										</div> -->
									</div>
								</div>
							</div>
						</div>
					</div>
				</div>
				<div id="results" class="cards">
					<!-- CREDIT CARDS ARE DYNAMICALLY ADDED -->
				</div>
			</div>
		</section>
	</div>
	<button class="close" aria-label="Close"><span>Close</span></button>
</div>


	</div>

