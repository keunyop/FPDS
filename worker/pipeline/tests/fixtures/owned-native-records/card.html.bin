	<script type="application/ld+json">
	{
		"@context": "http://schema.org",
		"@type": "CreditCard",
		"name": "RBC Avion Visa Infinite",
		"url": "https://www.rbcroyalbank.com/credit-cards/travel/rbc-visa-infinite-avion.html",
		"image": "https://www.rbcroyalbank.com/credit-cards/_assets-custom/images/cards/iav_infiniteavion_en_sm.png",
		"offers": {
			"@type": "Offer",
			"offeredBy": {
				"@type": "BankOrCreditUnion",
				"name": "RBC Royal Bank",
				"image": "https://www.rbcroyalbank.com/dvl/v0.2/assets/images/logos/rbc-logo-shield.svg"
			},
			"priceSpecification": {
				"@type": "UnitPriceSpecification",
				"price": "120",
				"priceCurrency": "CAD",
				"referenceQuantity": {
					"@type": "QuantitativeValue",
					"value": "1",
					"unitCode": "ANN"
				}
			}
		},
		"annualPercentageRate": "20.99",
		"feesAndCommissionsSpecification": "https://www.rbcroyalbank.com/credit-cards/travel/rbc-visa-infinite-avion.html"
	}
	</script>

	<script type="application/ld+json">
	{
		"@context": "https://schema.org",
		"@type": "FAQPage",
		"mainEntity": [
			{
			"@type": "Question",
			"name": "How does the RBC Avion Visa Infinite work?",
			"acceptedAnswer": {
				"@type": "Answer",
				"text": "The RBC Avion Visa Infinite is a travel rewards credit card that allows cardholders to earn Avion points for their purchases and gives them an automatic Avion Rewards Elite membership. Points can be redeemed for various travel rewards, including flights, hotel stays, car rentals, and more. Cardholders have the flexibility to book travel on any airline, at any time, with no blackout dates or restrictions."
			}
			},
			{
			"@type": "Question",
			"name": "How do I earn Avion points?",
			"acceptedAnswer": {
				"@type": "Answer",
				"text": "You earn 1 Avion point for every $1 CAD you spend with your credit card plus 25% more when you use your card to pay for travel."
			}
			},
			{
			"@type": "Question",
			"name": "What can I redeem Avion points on?",
			"acceptedAnswer": {
				"@type": "Answer",
				"text": "<p>Redeem on travel, such as:</p><ul><li>Flights</li><li>Hotel stays</li><li>Car rentals</li><li>Cruises</li><li>Vacation packages</li><li>Tours</li><li>Converting points to other loyalty and frequent flyer programs such as WestJet Rewards, British Airways Executive Club and American Airlines AAdvantage</li></ul><p>You can also redeem points for:</p><ul><li>Gift cards</li><li>Brand-name merchandise from top brands like Apple and Best Buy</li><li>RBC Financial Rewards®</li><li>Charitable donations</li><li>Points conversion to other loyalty programs</li><li>Pay with points</li></ul><p>For more about Avion Rewards™, including complete terms and conditions, visit <a href=\"https://avionrewards.com/\">avionrewards.com</a>.</p>"
			}
			},
			{
			"@type": "Question",
			"name": "How do I redeem Avion points?",
			"acceptedAnswer": {
				"@type": "Answer",
				"text": "<p>To redeem your points, sign into Avion Rewards online or through the app, then select either “Travel” or “Redeem” in the nav bar or menu.</p><p>For more information and to redeem for flights, visit <a href=\"https://avionrewards.com/travel\">avionrewards.com/travel</a>.</p>"
			}
			},
			{
			"@type": "Question",
			"name": "How do I convert Avion Rewards into other loyalty program's points, miles or partner rewards?",
			"acceptedAnswer": {
				"@type": "Answer",
				"text": "<p>Avion points can be converted into American Airlines AAdvantage miles, British Airways Avios and WestJet points.</p><p>To find out more, sign in to Avion Rewards and visit the <a href=\"https://www.rbcrewards.com/\">Convert Points section</a>.</p>"
			}
			},
			{
			"@type": "Question",
			"name": "Does the RBC Avion Visa Infinite card include travel insurance?",
			"acceptedAnswer": {
				"@type": "Answer",
				"text": "<p>Your RBC Avion Visa Infinite card comes with a suite of extensive travel insurance, including:</p><ul><li>Out of Province/Country Emergency Medical Insurance</li><li>Travel Accident Insurance</li><li>Auto Rental Collision/Loss Damage Waiver Insurance</li><li>Trip Cancellation & Trip Interruption Insurance</li><li>Delayed Baggage and Flight Delay Insurance</li><li>Hotel/Motel Burglary Insurance</li><li>Purchase Security & Extended Warranty Insurance</li><li>Mobile Device Insurance</li></ul><p>For more details regarding all available insurances on this card, <a href=\"https://www.rbcroyalbank.com/credit-cards/travel/rbc-visa-infinite-avion/rbc-visa-infinite-avion-certificate-of-insurance.pdf\">click here</a>.</p>"
			}
			},
			{
			"@type": "Question",
			"name": "What is the Air Travel Redemption schedule?",
			"acceptedAnswer": {
				"@type": "Answer",
				"text": "<p>Redeem for flights using a fixed amount of Avion points based on the destination through the <a href=\"https://www.avionrewards.com/travel/redemptionSchedule.html\">Air Travel Redemption Grid</a>.</p><p>Destinations have a maximum ticket price. If a ticket costs more than the allowed amount, you can charge the difference to your RBC Avion Visa Infinite card, or you can pay with points.</p>"
			}
			}
		]
	}
	</script>

