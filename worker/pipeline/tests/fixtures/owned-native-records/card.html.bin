			<!-- #why-book-with-us -->
			<section id="why-book-with-us">
				<iframe
					id="why-book-with-us-frame"
					src="/credit-cards/travel/why-book-with-us-iframe.html"
					title="Why book your trip with us?"
					loading="lazy"
					scrolling="no"
					style="display: block; width: 100%; min-height: 680px; border: 0; overflow: hidden;"
				></iframe>
			</section>
			<script>
				(function () {
					var frame = document.getElementById("why-book-with-us-frame");

					window.addEventListener("message", function (event) {
						if (
							event.source === frame.contentWindow &&
							event.data &&
							event.data.type === "iav-booking-benefits-height" &&
							Number.isFinite(event.data.height)
						) {
							frame.style.height = event.data.height + "px";
						}

						if (
							event.source === frame.contentWindow &&
							event.data &&
							event.data.type === "iav-booking-benefits-legal" &&
							/^#legal[a-z0-9-]+$/i.test(event.data.target)
						) {
							var legalTarget = event.data.target;
							var legalToggle = document.getElementById("legal-content");

							if (legalToggle && legalToggle.classList.contains("collapsed")) {
								legalToggle.click();
							}

							window.history.replaceState(null, "", legalTarget);

							window.setTimeout(function () {
								var target = document.querySelector(legalTarget) || document.getElementById("legal");
								var nav = document.querySelector(".nav-bar");
								var offset = nav ? nav.offsetHeight : 100;

								if (target) {
									window.scrollTo({
										top: target.getBoundingClientRect().top + window.pageYOffset - offset,
										behavior: "smooth"
									});
								}
							}, 350);
						}
					});
				}());
			</script>

