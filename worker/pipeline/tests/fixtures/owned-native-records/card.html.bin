									<h2 class="icon-copy-header larger-h4-mob">How to Earn Avion Points</h2>
									<p class="mar-b-0" data-card-pid="IAV" data-card-property="transformer.product_page.feature"></p>
									<div class="points-container">
										<div class="points-block">
											<p class="points-square no-wrap">1.25X</p>
											<p class="points-content">Earn 1.25 Avion points on travel related purchases<sup><a href="#legalvisainfiniteavion-12" class="scrollto">12</a></sup></p>
										</div>
										<div class="points-block">
											<p class="points-square no-wrap">1X</p>
