                            <span class="hidden-md hidden-sm hidden-lg" data-ecs_code="100238" data-card_image_path="/credit-cards/canada/travel/images/westjet-rbc-world-elite-mastercard.webp" data-card_name="WestJet RBC World Elite Mastercard" data-card_pid="MC4">
                                <a class="btn-compare margin-auto" href="/credit-cards/tools/compare-credit-cards.html" data-dig-details="click - product tile featured - i_MC4 - 1 - compare" data-dig-id="creditCards-PYDijmvhxEO8-5" data-item-list-position="0">Compare</a>
                            </span>
                            </div>
                            <div class="card-view-card pad-r-hlf">
                                <a class="standalone-link-after" href="/credit-cards/travel/westjet-rbc-world-elite-mastercard.html" data-dig-details="click - product tile featured - i_MC4 - 1 - view details" data-dig-id="creditCards-PYDijmvhxEO8-4" data-item-list-name="Cards Homepage Featured Cards" data-item-list-position="0" data-select-item="MC4" data-item-details="select_item">View Credit Card<span class="offscreen">WestJet RBC World Elite Mastercard</span></a>
                            </div>
                        </div>
                      </div>
                    </div>
