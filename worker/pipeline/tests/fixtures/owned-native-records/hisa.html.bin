        .card-details-offer-container {
          border-radius: var(--Vertical-Spacing-Spacing-xs, 8px);
          border: 1px solid #FFB500;
          background: linear-gradient(180deg, rgba(255, 186, 0, 0.10) 0%, rgba(255, 186, 0, 0.00) 100%);
          padding: 22px 16px 16px 16px;
          position: relative;
        }

        .card-details-offer-caption {
          position: absolute;
          left: 16px;
          top: -11px;
          border-radius: 4px;
          background: var(--Interaction-interactive-accent-hover, #FFBA00);
          padding: 3px 10px;
          color: var(--text-foregrounds-text-2, #252525);
          text-align: center;
          font-feature-settings: 'clig' off, 'liga' off;
          font-family: Roboto;
          font-size: 12px;
          font-style: normal;
          font-weight: 500;
          line-height: 16px;
          text-transform: uppercase;
        }

        table.table-striped.table-yellow:not(.table-stack) tbody tr:nth-child(odd) td {
          background-color: #FFFAD7;
          border-bottom: 1px solid #B3B3B3;
        }

        table.table-yellow {
          border-bottom: 1px solid #B3B3B3;
        }

        table.table-yellow thead tr {
          border-bottom: 2px solid #000;
        }

        #more-account-features .table-wpr {
          border-radius: 6px;
          border: 1px solid rgba(0, 0, 0, 0.10);
        }

        #more-account-features .table-cell {
          padding: 20px 48px;
          height: 96px !important;
          vertical-align: middle;
        }

        #more-account-features .table-cell p {
          font-size: 18px;
          line-height: 30px;
        }

        #banking-in-your-hands .block-wpr {
          border-radius: 13px;
          border: 1px solid #919191;
          background: linear-gradient(114deg, #EDF7FC 0%, #FFF 100%);
        }

        #banking-in-your-hands .block-inner {
          padding: 36px 25px 0px 28px;
        }

        #tailored-advice img {
          max-height: 150px;
          max-width: 100%;
        }

        .card-title {
          font-family: Roboto;
          font-size: 16px;
          font-style: normal;
