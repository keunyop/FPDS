    <script>
          // let showIntroTable = true;
          // document.querySelector(".more-account-features-btn").addEventListener("click", () => {
          //     if(showIntroTable) {
          //         document.querySelector(".intro-table").style.display = "none";
          //         showIntroTable = false;
          //     } else {
          //         document.querySelector(".intro-table").style.display = "table";
          //         showIntroTable = true;
          //     }
          // });
  
      tagUpperFunnelBeginCheckout("/apps/account-open/?pid1=027&lang=en#!/main/intro", "027");
          tagUpperFunnelBeginCheckout("/apps/account-open/?pid1=027&lang=en", "027");
          tagUpperFunnelCall("tel:18007692561", "027");
          tagUpperFunnelDetails("/investments/psi/hisa.html", "027");// global event handler to catch compare checkbox. Compare checkboxes are added dynamically on page after load. 

        document.addEventListener("click", (event) => {
          const elementClasslist = event.target.classList;
          if(elementClasslist.contains("btn-compare") && !elementClasslist.contains("btn-compare-added")) {
            // card info is contained in data-card_name attribute of parent
            let parent = event.target.parentNode
            let cardName = parent.getAttribute("data-card_name")
            
            // build string output
            let details = "click - compare - "

            switch (cardName) {
              case "RBC Avion Visa Infinite":
                details += "IAV"
                break;
              case "WestJet RBC World Elite Mastercard":
                details += "MC4"
                break;
              case "RBC Avion Visa Infinite Privilege":
                details += "AVP"
                break;
              case "RBC Avion Visa Platinum":
                details += "GCP"
                break;
              case "WestJet RBC Mastercard":
                details += "MC2"
                break;
              case "RBC British Airways Visa Infinite":
                details += "BAP"
                break;
            }

            dataLayer.push({ 
              event: "click", 
              details: details.trim()
            });
          }
        });

        window.addEventListener("scroll", () => {

					const stickyNavCustomEl = document.querySelector(".sticky-nav__custom");

					const stickyWrapperElTopPos = document.querySelector("#sticky-wrapper").getBoundingClientRect().top;

					if(stickyWrapperElTopPos < 1) {

							stickyNavCustomEl.style.display = "block";

					} else {

							stickyNavCustomEl.style.display = "none";

					}

				});
    </script>
