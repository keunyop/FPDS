          .sa-callout {
        border-radius: 8px;
        background: var(--Backgrounds-background-1, #FFF);
        box-shadow: 0px 54px 118px 0px rgba(37, 37, 37, 0.04), 0px 12.062px 26.357px 0px rgba(37, 37, 37, 0.06), 0px 3.591px 7.847px 0px rgba(37, 37, 37, 0.08);
        display: flex;
        flex-wrap: wrap;
        padding-left: 60px;
        padding-right: 60px;
        gap: 32px;
        max-width: 1165px;
        margin: 0 auto;
        min-height: 250px;
        overflow: hidden;
      }
      .sa-callout .text {
        padding: 24px 0 24px 0;
        flex: 1;
        align-self: center;
      }
      .sa-callout img {
        width: 309px;
        align-self: flex-end;
      }
