  <script type="application/ld+json">
    {
        "@context": "https://schema.org",
        "@type": "FAQPage",
        "mainEntity": [
          {
            "@type": "Question",
            "name": "What is a high interest savings account?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "A high interest savings account, such as RBC High Interest eSavings, typically offers a higher interest rate than traditional savings accounts. Interest is calculated daily and paid monthly. Promotions may also apply throughout the year."
            }
          },
          {
            "@type": "Question",
            "name": "How do I open a high interest savings account?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "You can open an RBC High Interest eSavings account online, through the RBC Mobile app, by visiting a branch, or by calling 1-800-769-2561 (available 24/7)."
            }
          },
          {
            "@type": "Question",
            "name": "What are the best savings account rates?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "At RBC, the High Interest eSavings account typically offers the highest interest rate. Visit the savings accounts page for current rates."
            }
          },
          {
            "@type": "Question",
            "name": "How do I send an Interac e-Transfer?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "You can send an Interac e-Transfer via RBC Online or Mobile Banking. All you need is the recipient’s email or mobile number. Detailed steps are provided in the online or mobile platform."
            }
          },
          {
            "@type": "Question",
            "name": "What are the Foreign Exchange rates?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "You can view the latest foreign exchange rates using RBC's Exchange Currency Converter online."
            }
          },
          {
            "@type": "Question",
            "name": "How many high interest savings accounts can you have?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "In Canada, there’s no limit to how many high interest savings accounts you can have. RBC also does not impose a limit."
            }
          },
          {
            "@type": "Question",
            "name": "Can you lose money in a high interest savings account?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Generally, no. Your principal is protected (minus service fees) and insured by the Canada Deposit Insurance Corporation (CDIC)."
            }
          },
          {
            "@type": "Question",
            "name": "What is the interest rate for the RBC High Interest eSavings account?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Interest rates are subject to change based on market conditions. Promotional rates may also apply. Visit the RBC rates page for current offers."
            }
          },
          {
            "@type": "Question",
            "name": "How do high interest savings accounts work?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "You earn interest on every dollar saved. Interest is calculated daily and paid monthly, helping your savings grow faster."
            }
          },
          {
            "@type": "Question",
            "name": "Are high interest savings accounts safe?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Yes, RBC High Interest eSavings accounts are eligible for CDIC insurance, offering a safe place to store your savings."
            }
          },
          {
            "@type": "Question",
            "name": "How do I set up Save-Matic?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "In Online Banking, use 'Pay Bills and Transfer Funds' to access 'Set Up Save-Matic'. Enter your details and confirm to schedule automatic transfers."
            }
          },
          {
            "@type": "Question",
            "name": "How do I turn on NOMI Find & Save?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Sign into the RBC Mobile app, tap ‘More’, then ‘NOMI Find & Save’ to turn it on. It helps you automatically save based on your spending habits."
            }
          },
          {
            "@type": "Question",
            "name": "Do you offer Mobile Cheque Deposit?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Yes. Use the RBC Mobile app or RBC Canada app to deposit cheques. Select 'Deposit Cheque' from the main menu and follow the prompts."
            }
          },
          {
            "@type": "Question",
            "name": "How to choose the best savings account for my goals?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Consider the interest rate, fees, accessibility, and minimum balance requirements. Choose the account that aligns with your savings goals."
            }
          },
          {
            "@type": "Question",
            "name": "How often do high interest savings accounts pay interest?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Interest is calculated daily and paid monthly based on your account balance and accrued interest throughout the month."
            }
          },
          {
            "@type": "Question",
            "name": "What is the difference between RBC eSavings and other RBC savings accounts?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "RBC High Interest eSavings offers a higher interest rate, free eStatements and eNotifications, compared to other RBC savings accounts."
            }
          }
        ]
      }
  </script>

  <script type="application/ld+json">
{
