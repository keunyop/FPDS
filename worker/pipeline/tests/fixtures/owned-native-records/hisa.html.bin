      /* Custom Sticky Nav START */

	body .right-content .btn:not(.tablesaw-nav-btn).primary {

			box-shadow: none;

			border-radius: 50px;

			line-height: 25px;

			height: 50px;

			font-weight: 400;

			border: none;

	}

	body .is-sticky .nav-bar .nav-inner {

			padding-top: 0 !important;

			padding-bottom: 15px !important;

	}

				body .sticky-only-block,body .sticky-only-inline {

			display: none !important

	}

	body .offer-bar.sticky-only-block {

			display: none !important

	}

	body .nav-bar .right-content {

			display: none

	}

	body .is-sticky .sticky-only-inline {

			display: inline !important

	}

	body .is-sticky .sticky-only-block {

			display: none !important

	}

	@media(max-width: 996px) {

			body .is-sticky .sticky-only-block {

					display:block !important

			}

	}

	body .is-sticky .product-sticky {

			border-bottom: 3px solid #fedf01

	}

	body .is-sticky .product-sticky .nav-inner {

			display: block

	}

	body .is-sticky .product-sticky .breadcrumb-wpr {

			display: none !important

	}

	body .is-sticky .product-sticky .nav-location {

			margin-top: 20px;

			margin-right: 5px;

			float: left;

			transition-duration: 0s !important

	}

	@media(max-width: 996px) {

			body .is-sticky .product-sticky .nav-location {

					display:flex;

					margin-top: 10px;

					margin-left: 5px

			}

	}

	body .is-sticky .product-sticky .nav-btn {

			display: none

	}

	body .is-sticky .product-sticky .additional-info {

			font-size: 14px !important;

			color: #252525;

			float: left;

			font-weight: 700 !important;

			margin-top: 20px;

			margin-left: 5px

	}

	@media(max-width: 996px) {

			body .is-sticky .product-sticky .additional-info {

					margin-top:0;

					font-size: 12px;

					margin-left: 5px

			}

	}

	body .is-sticky .product-sticky .right-content {

			float: right;

			height: 70px;

			overflow: hidden;

			display: flex;

			align-items: center

	}

	body .is-sticky .product-sticky .right-content img {

			height: 65px

	}

	@media(max-width: 996px) {

			body .is-sticky .product-sticky .right-content img {

					display:none

			}

	}

	@media(max-width: 996px) {

			body .is-sticky .product-sticky .right-content .text-script {

					display:none !important

			}

	}

	@media(max-width: 996px) {

			body .is-sticky .product-sticky .right-content .text-btn {

					display:none !important

			}

	}

	@media(max-width: 996px) {

			body .is-sticky .product-sticky .left-content {

					display:flex;

					float: left;

					flex-direction: column

			}

	}

	@media(max-width: 420px) {

			body .is-sticky .product-sticky .left-content {

					width:calc(100% - 160px)

			}

	}

	@media(max-width: 996px) {

			body .is-sticky .product-sticky .left-content.vantage-h1-fix {

					margin-top:15px

			}

	}

	body .is-sticky .product-sticky .offer-bar {

			display: none

	}

	@media(max-width: 996px) {

			body .is-sticky .product-sticky .offer-bar {

					min-height:34px;

					display: block;

					float: left;

					margin-left: -15px;

					margin-right: -15px;

					width: calc(100% + 30px)

			}

	}

	/* Custom Sticky Nav END */
      .sticky-nav__custom {

            position: fixed;

            top: 0;

            left: 0;

            width: 100%;

            z-index: 11;

            background-color: #fff;

            box-shadow: 0px 6px 15px 0px rgba(0, 0, 0, 0.05);

            display: none;

        }

				.sticky-nav__custom .btn:not(.tablesaw-nav-btn).primary {

					border-radius: 0;

				}

        .sticky-nav__custom .left-col {

            display: flex;

            align-items: center;

            gap: 16px;

        }

        .sticky-nav__custom h1 {

            font-size: 24px;

            font-weight: 500;

            line-height: 32px; 

            margin: 0;

        }

        .sticky-nav__custom .m-fee {

            color: #000;

            font-family: RBCDisplay;

            font-size: 14px;

            font-weight: 700;

            line-height: normal;

        }

        .sticky-nav__custom .right-col {

            display: flex;

            align-items: center;

            gap: 14px;

        }

        .sticky-nav__custom .right-col .offer-desk {

            font-family: Georgia;

            font-size: 16px;

            font-style: italic;

            font-weight: 400;

            line-height: 24px;

        }

        .sticky-nav__custom .right-col .btn {

            font-size: 14px;

            font-weight: 500 !important;

            line-height: 20px !important;

            height: auto !important;

            padding: 14px 20px;

        }

        .sticky-nav__custom-center {

            display: flex;

            align-items: center;

            justify-content: space-between;

            gap: 15px;

            padding: 5px 15px;

            max-width: 1170px;

            margin: 0 auto;

        }

        .sticky-nav__custom .offer-mob {

            display: none;

        }
      @media only screen and (max-width: 768px){

					.sticky-nav__custom .left-col {

						flex-direction: column;

						align-items: flex-start;

						gap: 8px;

					}

					.sticky-nav__custom h1 {

						max-width: 415px;

					}

				}
       @media only screen and (max-width: 639px){

            .sticky-nav__custom {

                box-shadow: none;

                border-bottom: 1px solid #B3B3B3;

            }

            .sticky-nav__custom h1 {

                font-size: 12px;

                font-weight: 700;

                line-height: 26px;

            }

            .sticky-nav__custom .left-col {

                gap: 0;

            }

            .sticky-nav__custom .right-col .offer-desk {

                display: none;

            }

            .sticky-nav__custom .m-fee {

                color: #252525;

                font-size: 12px;

                line-height: 26px;

            }

            .sticky-nav__custom-center {

                padding-left: 20px;

            }

            .sticky-nav__custom .offer-mob {

                display: block;

                background-color: #F3F7F8;

                padding: 5px 0 5px 20px;

                font-size: 12px;

                font-weight: 400;

                line-height: 24px;

            }

        }
