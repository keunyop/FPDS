#onetrust-consent-sdk #onetrust-pc-sdk .ot-switch-nob::before, #onetrust-consent-sdk #onetrust-pc-sdk .ot-tgl input:checked+.ot-switch .ot-switch-nob::before {
  border-color: #6f6f6f;
  background-color: #fff;
  border: 2px solid #6f6f6f !IMPORTANT;
  top: -2px;
  height: 32px;
  width: 32px;
  left: -2px;
  box-sizing: border-box;
}

#onetrust-consent-sdk #onetrust-pc-sdk .category-switch-handler:checked+.ot-switch .ot-switch-nob {
